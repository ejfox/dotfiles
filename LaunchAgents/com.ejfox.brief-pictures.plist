<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 08:02 daily, right after the 08:00 brief: DM today's chart-desk charts + one art
     tile via Artie (brief-pictures). Once a day; off switch ~/.config/brief-pictures-disabled.
     Unload: launchctl bootout gui/$(id -u)/com.ejfox.brief-pictures -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.ejfox.brief-pictures</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/python3</string>
		<string>/Users/ejfox/.dotfiles/bin/brief-pictures</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>2</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/ejfox/.local/share/brief-pictures.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/ejfox/.local/share/brief-pictures.log</string>
</dict>
</plist>
