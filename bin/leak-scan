#!/usr/bin/env python3
"""
leak-scan — sweep the NON-git channels secrets and identity leak through.
Companion to `secret-scan` (which covers git history). All checks are free,
keyless APIs. Nothing secret ever leaves this machine: the only outbound
derivative of a secret is a 5-char SHA1 prefix to HIBP Pwned Passwords
(k-anonymity range API, designed for exactly this).

Checks:
  1. pwned    every current secret value from ~/.env + ~/.claude-secrets
              against Pwned Passwords (appears in a breach corpus = burned)
  2. gists    every public gist on github.com/ejfox, scanned with gitleaks
              + known-value rules (gists are the classic forgotten leak)
  3. ghsearch GitHub-wide code search for key IDENTIFIERS (public halves:
              api-key numbers, AKIA ids) — finds your creds in OTHER repos
  4. npm      every npm package maintained by ejfox: latest tarball
              downloaded and scanned (bundled .env / hardcoded keys)
  5. wayback  archive.org CDX for sensitive paths ever archived on your
              domains (.env, .git, config dumps, backups)
  6. pastes   psbdmp.ws pastebin-dump search for identity strings

Usage: leak-scan [--quiet] [--skip npm,wayback,...]
Exit 1 if any finding. Report: ~/.local/share/secret-scan/leak-scan-<date>.md
"""

import hashlib
import json
import os
import re
import shutil
import ssl
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
import urllib.parse

try:
    import certifi
    CTX = ssl.create_default_context(cafile=certifi.where())
except ImportError:
    CTX = ssl.create_default_context()

QUIET = "--quiet" in sys.argv
SKIP = set()
for i, a in enumerate(sys.argv):
    if a == "--skip" and i + 1 < len(sys.argv):
        SKIP = set(sys.argv[i + 1].split(","))

GH_USER = "ejfox"
DOMAINS = ["ejfox.com", "*.ejfox.com", "tools.ejfox.com", "archive.ejfox.com"]
IDENTITY = ["ejfox@ejfox.com", "ejfox"]
# public identifier halves of credentials (safe to search for; NOT secrets).
# Kept OUT of this file (dotfiles is public) — one identifier per line in:
IDENTIFIERS_FILE = os.path.expanduser("~/.config/leak-scan/identifiers.txt")
KEY_IDENTIFIERS = []
if os.path.exists(IDENTIFIERS_FILE):
    KEY_IDENTIFIERS = [l.strip() for l in open(IDENTIFIERS_FILE)
                       if l.strip() and not l.startswith("#")]
SECRET_SOURCES = ["~/.env", "~/.claude-secrets"]
OUT_DIR = os.path.expanduser("~/.local/share/secret-scan")
STAMP = time.strftime("%Y-%m-%d-%H%M")

findings = []


def report(check, severity, msg):
    findings.append((check, severity, msg))
    if not QUIET:
        print(f"  [{severity}] {msg}")


def log(msg):
    if not QUIET:
        print(msg)


def fetch(url, timeout=30, headers=None):
    req = urllib.request.Request(url, headers=headers or {"User-Agent": "leak-scan/1.0"})
    with urllib.request.urlopen(req, timeout=timeout, context=CTX) as r:
        return r.read()


def current_secrets():
    """(key, value) pairs of real current secrets, filtered like secret-scan."""
    ignore = re.compile(r"(URL_BASE|_HOST|_USER|_PORT|_PATH|_DIR|_MODEL|EMAIL)", re.I)
    out, seen = [], set()
    for src in SECRET_SOURCES:
        p = os.path.expanduser(src)
        if not os.path.exists(p):
            continue
        for line in open(p):
            m = re.match(r"\s*(?:export\s+)?([A-Z0-9_]+)=[\"']?([^\"'\s]+)", line)
            if not m:
                continue
            k, v = m.groups()
            if ignore.search(k) or len(v) < 12 or v in seen:
                continue
            if v.startswith(("http://", "https://")) and "@" not in v:
                continue
            if v.startswith(("/", "~")) or v.count("/") > 3:
                continue
            seen.add(v)
            out.append((k, v))
            cm = re.match(r"cloudinary://\d+:([^@]+)@", v)
            if cm and cm.group(1) not in seen:
                seen.add(cm.group(1))
                out.append((k + "_secretpart", cm.group(1)))
    return out


# ---- 1. Pwned Passwords k-anonymity ----
def check_pwned():
    log("== pwned-passwords (k-anonymity) ==")
    for key, val in current_secrets():
        sha = hashlib.sha1(val.encode()).hexdigest().upper()
        prefix, suffix = sha[:5], sha[5:]
        try:
            body = fetch(f"https://api.pwnedpasswords.com/range/{prefix}").decode()
        except Exception as e:
            report("pwned", "warn", f"range query failed for {key}: {e}")
            continue
        for line in body.splitlines():
            if line.split(":")[0] == suffix:
                report("pwned", "CRITICAL",
                       f"secret {key} appears in breach corpora "
                       f"({line.split(':')[1].strip()} occurrences) — rotate NOW")
                break
        time.sleep(0.2)


# ---- 2. gists ----
def check_gists():
    log("== public gists ==")
    try:
        raw = subprocess.run(["gh", "api", f"users/{GH_USER}/gists", "--paginate"],
                             capture_output=True, text=True, timeout=120).stdout
        gists = json.loads(raw) if raw.strip().startswith("[") else []
    except Exception as e:
        report("gists", "warn", f"gist list failed: {e}")
        return
    log(f"  {len(gists)} public gists")
    tmp = tempfile.mkdtemp(prefix="leak-scan-gists.")
    try:
        for g in gists:
            d = os.path.join(tmp, g["id"])
            r = subprocess.run(["git", "clone", "--quiet", g["git_pull_url"], d],
                               capture_output=True, timeout=60)
            if r.returncode != 0:
                continue
        r = subprocess.run([os.path.expanduser("~/.dotfiles/bin/secret-scan"), "--quiet"]
                           + [os.path.join(tmp, g["id"]) for g in gists
                              if os.path.isdir(os.path.join(tmp, g["id"]))],
                          capture_output=True, text=True, timeout=600)
        for line in r.stdout.splitlines():
            if "rule=" in line:
                sev = "CRITICAL" if "LIVE-SECRET" in line else "info"
                report("gists", sev, line.strip())
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ---- 3. GitHub-wide code search for identifiers ----
def check_ghsearch():
    log("== github-wide code search (identifiers only) ==")
    for ident in KEY_IDENTIFIERS:
        try:
            raw = subprocess.run(
                ["gh", "api", "-X", "GET", "search/code",
                 "-f", f"q={ident}", "-f", "per_page=10"],
                capture_output=True, text=True, timeout=60).stdout
            d = json.loads(raw)
        except Exception as e:
            report("ghsearch", "warn", f"search failed for {ident[:8]}: {e}")
            continue
        for item in d.get("items", []):
            repo = item["repository"]["full_name"]
            if repo.startswith(f"{GH_USER}/"):
                continue  # own repos covered by secret-scan
            report("ghsearch", "CRITICAL",
                   f"identifier {ident[:8]}... found in THIRD-PARTY repo "
                   f"{repo} at {item['path']} — your creds are circulating")
        time.sleep(3)  # code search rate limit is tight


# ---- 4. npm tarballs ----
def check_npm():
    log("== npm packages ==")
    try:
        d = json.loads(fetch(
            f"https://registry.npmjs.org/-/v1/search?text=maintainer:{GH_USER}&size=250"))
    except Exception as e:
        report("npm", "warn", f"npm search failed: {e}")
        return
    pkgs = [o["package"]["name"] for o in d.get("objects", [])]
    log(f"  {len(pkgs)} packages")
    secrets = [v for _, v in current_secrets()]
    danger = re.compile(
        r"(cloudinary://\d+:[\w-]+@|AKIA[A-Z0-9]{16}|sk-[A-Za-z0-9]{20,}|"
        r"xox[bp]-|ghp_[A-Za-z0-9]{30,}|-----BEGIN (RSA|EC|OPENSSH) PRIVATE KEY)")
    tmp = tempfile.mkdtemp(prefix="leak-scan-npm.")
    try:
        for name in pkgs:
            try:
                meta = json.loads(fetch(f"https://registry.npmjs.org/{urllib.parse.quote(name, safe='@/')}"))
                latest = meta["dist-tags"]["latest"]
                turl = meta["versions"][latest]["dist"]["tarball"]
                tpath = os.path.join(tmp, "pkg.tgz")
                open(tpath, "wb").write(fetch(turl, timeout=60))
                with tarfile.open(tpath) as tf:
                    for m in tf.getmembers():
                        if not m.isfile() or m.size > 2_000_000:
                            continue
                        base = os.path.basename(m.name)
                        if base in (".env", ".env.local", ".env.production", ".npmrc", "credentials.json"):
                            report("npm", "CRITICAL",
                                   f"{name}@{latest} ships {m.name} — env file in published tarball")
                        try:
                            content = tf.extractfile(m).read(500_000).decode("utf-8", "ignore")
                        except Exception:
                            continue
                        if danger.search(content):
                            report("npm", "CRITICAL",
                                   f"{name}@{latest}: credential-shaped string in {m.name}")
                        for s in secrets:
                            if s in content:
                                report("npm", "CRITICAL",
                                       f"{name}@{latest}: LIVE current secret in {m.name} — rotate + unpublish")
                os.unlink(tpath)
            except Exception as e:
                report("npm", "warn", f"{name}: {type(e).__name__}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ---- 5. wayback machine sensitive paths ----
def check_wayback():
    log("== wayback machine archived sensitive paths ==")
    sens = re.compile(r"(\.env|\.git/|config\.(json|yml|yaml)|\.sql|backup|"
                      r"secrets|credentials|\.pem|\.key$|wp-config)", re.I)
    for dom in DOMAINS:
        rows = None
        for attempt in range(3):
            try:
                body = fetch("https://web.archive.org/cdx/search/cdx?" +
                             urllib.parse.urlencode({
                                 "url": dom + "/*", "output": "json", "fl": "original,timestamp",
                                 "collapse": "urlkey", "limit": "5000"}), timeout=60).decode()
                rows = json.loads(body)[1:] if body.strip() else []
                break
            except Exception as e:
                if "429" in str(e) and attempt < 2:
                    time.sleep(20 * (attempt + 1))
                    continue
                report("wayback", "warn", f"CDX failed for {dom}: {e}")
                break
        if rows is None:
            continue
        time.sleep(5)  # be polite between domains
        hits = [r for r in rows if sens.search(r[0])]
        for url, ts in hits[:10]:
            report("wayback", "info",
                   f"archived sensitive-looking path: {url} (snapshot {ts[:8]}) — "
                   f"verify it never served real secrets")
        if len(hits) > 10:
            report("wayback", "info", f"...{len(hits)-10} more archived paths on {dom}")


# ---- 6. pastebin dumps ----
def check_pastes():
    log("== pastebin dumps (psbdmp) ==")
    for ident in IDENTITY:
        try:
            d = json.loads(fetch(f"https://psbdmp.ws/api/v3/search/{urllib.parse.quote(ident)}",
                                 timeout=30))
        except Exception as e:
            report("pastes", "warn", f"psbdmp query failed for {ident}: {e}")
            continue
        for item in (d.get("data") or [])[:10]:
            report("pastes", "CRITICAL" if "@" in ident else "info",
                   f"'{ident}' appears in paste dump {item.get('id')} ({item.get('time','?')})")
        time.sleep(1)


CHECKS = {"pwned": check_pwned, "gists": check_gists, "ghsearch": check_ghsearch,
          "npm": check_npm, "wayback": check_wayback, "pastes": check_pastes}


def main():
    os.makedirs(OUT_DIR, exist_ok=True)
    for name, fn in CHECKS.items():
        if name in SKIP:
            log(f"== {name} skipped ==")
            continue
        try:
            fn()
        except Exception as e:
            report(name, "warn", f"check crashed: {e}")

    path = os.path.join(OUT_DIR, f"leak-scan-{STAMP}.md")
    with open(path, "w") as f:
        f.write(f"# leak-scan {STAMP}\n\n")
        for c, s, m in findings:
            f.write(f"- **{s}** [{c}] {m}\n")
        if not findings:
            f.write("clean — no findings\n")
    crit = [x for x in findings if x[1] == "CRITICAL"]
    print(f"leak-scan: {len(findings)} finding(s), {len(crit)} critical -> {path}")
    return 1 if crit else 0


if __name__ == "__main__":
    sys.exit(main())
