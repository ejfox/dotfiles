#!/usr/bin/env bash
# pixel-live — the canvas's second-to-second layer. A persistent loop that
# paints a tiny ticker in the top-right corner: HH:MM:SS clock every second,
# agent-fleet counts every 5s (hotpink when someone needs you).
#
# Scenes repaint the whole screen on rotation; the ticker just redraws itself
# a beat later. Local data only (clock + robots -t) — nothing external.
# Backs off to 30s polling while the device is offline. Run via launchd
# (com.ejfox.pixel-live, KeepAlive).

set -u

. "$HOME/.dotfiles/lib/pixel-host.sh"
DEVICE=$(pixel_host)
BASE="http://${DEVICE}"

px() { curl -s --connect-timeout 1 --max-time 2 -o /dev/null "${BASE}/$1" 2>/dev/null || true; }
alive() {
  curl -s --connect-timeout 1 --max-time 2 -o /dev/null -w "%{http_code}" \
    "${BASE}/info" 2>/dev/null | grep -q "^200$"
}

tick=0
fleet_txt=""
down=0
while true; do
  if ! alive; then
    down=$((down + 1))
    # ~2 min dark -> assume DHCP shuffled the IP; rediscover and re-resolve
    if [ $((down % 4)) -eq 0 ]; then
      "$HOME/.dotfiles/bin/pixel" find >/dev/null 2>&1 || true
      DEVICE=$(pixel_host); BASE="http://${DEVICE}"
    fi
    sleep 30; continue
  fi
  down=0

  # fleet counts every 5th tick ("◇1 ◆2 ●11" -> needs/working)
  if [ $((tick % 5)) -eq 0 ]; then
    counts=$("$HOME/.dotfiles/bin/robots" -t 2>/dev/null || true)
    needs=$(printf '%s' "$counts" | sed -En 's/.*◇([0-9]+).*/\1/p'); needs=${needs:-0}
    work=$(printf '%s' "$counts"  | sed -En 's/.*◆([0-9]+).*/\1/p'); work=${work:-0}
    fleet_txt=""
    [ "$needs" -gt 0 ] && fleet_txt="${needs} need you"
  fi

  # top-right ticker: placement-aware — widths computed from string length
  # (6px/char at size 1), right-aligned against the 320px edge.
  clock=$(date +%H:%M:%S)
  cw=$(( ${#clock} * 6 ))
  cx=$(( 318 - cw ))
  px "rect?x=$((cx - 4))&y=0&w=$((cw + 6))&h=11&r=0&g=0&b=0"
  px "text?msg=$(printf '%s' "$clock" | sed 's/:/%3A/g')&x=${cx}&y=2&size=1&color=teal"
  if [ -n "$fleet_txt" ]; then
    fw=$(( ${#fleet_txt} * 6 ))
    fx=$(( cx - 12 - fw ))
    px "rect?x=$((fx - 4))&y=0&w=$((fw + 8))&h=11&r=0&g=0&b=0"
    px "text?msg=$(printf '%s' "$fleet_txt" | sed 's/ /%20/g')&x=${fx}&y=2&size=1&color=hotpink"
  fi

  tick=$((tick + 1))
  sleep 1
done
