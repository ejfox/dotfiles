#!/bin/bash
# obs-defer — keep heavy background jobs off the machine while OBS is open.
#
#   obs-defer <job-id> [--skip | --max-defer <hours>] -- <command...>
#       OBS closed → run the command now.
#       OBS open   → --skip: do nothing (for jobs that re-fire every few minutes)
#                    default: queue it; `obs-defer drain` runs it once OBS closes.
#                    If it has already waited longer than --max-defer hours
#                    (default 24), it's "absolutely necessary": run it anyway
#                    at background priority (taskpolicy -b = low CPU + IO).
#   obs-defer drain    run queued jobs once OBS has been closed 10 min (com.ejfox.obs-defer-drain, every 5 min);
#                      a running job is frozen (SIGSTOP) if OBS reopens and resumed when it closes
#   obs-defer status   show the queue
#   obs-defer run-all  run the queue now regardless of OBS
#
# Queue: ~/.local/state/obs-defer/<job-id>.job   Log: ~/.local/state/obs-defer/log
# Kill switch: touch ~/.config/obs-defer-disabled  → every job just runs normally.
set -uo pipefail
Q="$HOME/.local/state/obs-defer"; LOG="$Q/log"; mkdir -p "$Q"
log() { echo "$(date '+%F %T') $*" >>"$LOG"; }
obs_open() { [ ! -f "$HOME/.config/obs-defer-disabled" ] && pgrep -x OBS >/dev/null; }

tree() {  # tree <pid> -> pid + all descendants (gitleaks runs 3 levels deep)
  echo "$1"; local c; for c in $(pgrep -P "$1"); do tree "$c"; done
}

run_job() {  # run_job <job-id> <file-with-command>
  local id=$1 f=$2 paused=0
  log "RUN $id"
  # the job file holds the argv, one arg per line (NUL-free, paths with spaces ok)
  local -a argv=(); while IFS= read -r line; do argv+=("$line"); done < <(tail -n +3 "$f")
  rm -f "$f"
  taskpolicy -b "${argv[@]}" >>"$LOG" 2>&1 &
  local pid=$!
  # watchdog: OBS opens mid-job -> freeze the whole tree (SIGSTOP, progress kept); closes -> resume
  while kill -0 "$pid" 2>/dev/null; do
    if obs_open && [ $paused = 0 ]; then kill -STOP $(tree "$pid") 2>/dev/null; paused=1; log "PAUSE $id (OBS opened)"
    elif ! obs_open && [ $paused = 1 ]; then kill -CONT $(tree "$pid") 2>/dev/null; paused=0; log "RESUME $id (OBS closed)"
    fi
    sleep 10
  done
  wait "$pid"; log "DONE $id exit=$?"
}

case "${1:-}" in
  drain|run-all)
    if [ "$1" = drain ]; then
      # only drain once OBS has been closed for SETTLE seconds straight (restarts don't count)
      SETTLE=600; C="$Q/.obs-closed-since"
      if obs_open; then rm -f "$C"; exit 0; fi
      [ -f "$C" ] || { date +%s >"$C"; exit 0; }
      [ $(( $(date +%s) - $(cat "$C") )) -ge $SETTLE ] || exit 0
      # one drain at a time (launchd fires every 5 min; a long job must not get a twin)
      mkdir "$Q/.drain.lock" 2>/dev/null || exit 0; trap 'rmdir "$Q/.drain.lock"' EXIT
    fi
    for f in "$Q"/*.job; do [ -e "$f" ] || continue; run_job "$(basename "$f" .job)" "$f"; done
    exit 0 ;;
  status)
    obs_open && echo "OBS open — heavy jobs deferring" || echo "OBS closed — jobs run normally"
    for f in "$Q"/*.job; do [ -e "$f" ] || continue
      echo "  queued: $(basename "$f" .job)  since $(date -r "$(sed -n 1p "$f")" "+%a %H:%M")  max-defer $(sed -n 2p "$f")h"; done
    exit 0 ;;
  ""|-h|--help) sed -n '2,17p' "$0"; exit 0 ;;
esac

id=$1; shift; mode=queue; max=24
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
  case "$1" in --skip) mode=skip ;; --max-defer) max=$2; shift ;; *) echo "obs-defer: unknown flag $1" >&2; exit 2 ;; esac
  shift
done
[ "${1:-}" = "--" ] && shift
[ $# -gt 0 ] || { echo "obs-defer: no command" >&2; exit 2; }

if ! obs_open; then rm -f "$Q/$id.job"; exec "$@"; fi

if [ "$mode" = skip ]; then log "SKIP $id (OBS open)"; exit 0; fi

f="$Q/$id.job"
if [ -f "$f" ]; then
  since=$(sed -n 1p "$f"); age_h=$(( ($(date +%s) - since) / 3600 ))
  if [ "$age_h" -ge "$max" ]; then
    log "FORCE $id (deferred ${age_h}h >= ${max}h, running at background priority)"
    rm -f "$f"; taskpolicy -b "$@"; exit $?
  fi
  log "DEFER $id again (waiting ${age_h}h of max ${max}h)"
else
  { date +%s; echo "$max"; printf '%s\n' "$@"; } >"$f"
  log "DEFER $id (OBS open) — queued"
fi
exit 0
