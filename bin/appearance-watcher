#!/bin/bash
# Watches for macOS appearance changes and updates btop + lazygit themes
# Run in background: appearance-watcher &

BTOP_CONF="$HOME/.config/btop/btop.conf"
LAZYGIT_CONFIG="$HOME/.config/lazygit/config.yml"
LAZYGIT_DARK="$HOME/.config/lazygit/vulpes-reddishnovember-dark.yml"
LAZYGIT_LIGHT="$HOME/.config/lazygit/vulpes-reddishnovember-light.yml"
LAST_MODE=""

get_mode() {
    if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -q "Dark"; then
        echo "dark"
    else
        echo "light"
    fi
}

set_btop_theme() {
    local mode="$1"
    # btop.conf is UNTRACKED live state (like lazygit's config.yml); the
    # tracked sources are btop-{dark,light}.conf. To change a btop setting
    # permanently, edit BOTH variants — btop.conf gets overwritten on flips.
    local src="$HOME/.config/btop/btop-${mode}.conf"
    [[ -f "$src" ]] || return 0
    cp "$src" "$BTOP_CONF"
    # Signal btop to reload config
    pkill -SIGUSR2 btop 2>/dev/null
}

set_lazygit_theme() {
    local mode="$1"
    local src="$LAZYGIT_LIGHT"
    [[ "$mode" == "dark" ]] && src="$LAZYGIT_DARK"

    if [[ -f "$src" ]]; then
        cp "$src" "$LAZYGIT_CONFIG"
    fi
}

set_tmux_theme() {
    local mode="$1"
    local theme_file="$HOME/.dotfiles/vulpes-reddish2-${mode}-tmux.tmux.conf"
    [[ -f "$theme_file" ]] || return 0

    # Repoint the untracked 'current' symlink — .tmux.conf sources it via a
    # line that never changes, so theme flips never touch a tracked file.
    ln -sf "$theme_file" "$HOME/.dotfiles/vulpes-reddish2-current-tmux.tmux.conf"
    tmux source-file "$theme_file" 2>/dev/null
}

set_yazi_theme() {
    local mode="$1"
    local src="$HOME/.config/yazi/vulpes-reddishnovember-${mode}.toml"
    [[ -f "$src" ]] && ln -sf "$src" "$HOME/.config/yazi/theme.toml"
}

set_fzf_theme() {
    local mode="$1"
    local src="$HOME/.config/fzf/theme-${mode}.sh"
    [[ -f "$src" ]] && ln -sf "$src" "$HOME/.config/fzf/current.sh"
}

set_delta_theme() {
    local mode="$1"
    local feature="light-vulpes"
    [[ "$mode" == "dark" ]] && feature="dark-vulpes"
    # .gitconfig is symlinked into ~/.dotfiles; sed the real target.
    local gc
    gc=$(readlink -f "$HOME/.gitconfig" 2>/dev/null || echo "$HOME/.gitconfig")
    [[ -f "$gc" ]] || return 0
    # Swap the base [delta] feature line; the lazygit sub-feature layers on top.
    sed -i '' -E "s/(features = )(light-vulpes|dark-vulpes)/\1${feature}/" "$gc"
}

ensure_bat_cache() {
    # bat can't see the vulpes .tmTheme files until its cache is built; without
    # it, --theme-light resolves to nothing and bat falls back to a dark default
    # (near-white text → invisible on light). Idempotent: only builds if missing.
    command -v bat >/dev/null 2>&1 || return 0
    bat --list-themes 2>/dev/null | grep -q vulpes || bat cache --build >/dev/null 2>&1
}

sync_all() {
    local mode="$1"
    ensure_bat_cache
    set_btop_theme "$mode"
    set_lazygit_theme "$mode"
    set_tmux_theme "$mode"
    set_yazi_theme "$mode"
    set_fzf_theme "$mode"
    set_delta_theme "$mode"
}

# --sync: re-apply current mode to all tools and exit (no daemon loop).
# Use after a `git checkout` or other action that knocks files out of sync.
if [[ "$1" == "--sync" ]]; then
    MODE=$(get_mode)
    sync_all "$MODE"
    echo "✓ appearance-watcher: synced all tools to $MODE"
    exit 0
fi

# Initial state — sync everything so current state matches current mode
LAST_MODE=$(get_mode)
sync_all "$LAST_MODE"

while true; do
    sleep 2
    CURRENT_MODE=$(get_mode)

    if [[ "$CURRENT_MODE" != "$LAST_MODE" ]]; then
        sync_all "$CURRENT_MODE"
        LAST_MODE="$CURRENT_MODE"
    fi
done
