#!/usr/bin/env bash
# chat-desk : EJ's big-type stream chat (stream-overlays/chat-desk.html) as a bare Chrome app
# window on the top half of the portrait Dell. Idempotent: if it's already open, it's just
# re-placed. Focus-safe: whatever app was frontmost gets focus back (EJ's screen etiquette).
# Run by hand, or automatically by twitch_events.py on Twitch's stream.online event.
set -uo pipefail
HS=/usr/local/bin/hs
URL="file://$HOME/code/stream-overlays/chat-desk.html"
TITLE="Chat Desk"

# every hs call is capped at 5 s: a Chrome allWindows() listing once hung forever (2026-10-26).
# perl alarm, not gtimeout: gtimeout under launchd trips TCC "wants data from other apps" prompts.
hsq() { perl -e 'alarm 5; exec @ARGV' "$HS" -c "$1" 2>/dev/null | tail -1; }

front=$(hsq 'return hs.application.frontmostApplication():bundleID()')
refocus() { hsq "local b=hs.application.get('$front'); if b then b:activate() end" >/dev/null; }

have=$(hsq "
  local a=hs.application.get('com.google.Chrome')
  if not a then return 'no' end
  for _,w in ipairs(a:allWindows()) do if w:title():find('$TITLE',1,true)==1 then return 'yes' end end
  return 'no'")

if [ "$have" != "yes" ]; then
  open -g -na "Google Chrome" --args --app="$URL" --new-window
fi

# place it (the window can take a moment to appear) and hand focus back
for _ in $(seq 1 20); do
  ok=$(hsq "
    local a=hs.application.get('com.google.Chrome'); if not a then return 'wait' end
    for _,w in ipairs(a:allWindows()) do
      if w:title():find('$TITLE',1,true)==1 then   -- Chrome appends ' - <profile>'
        local f=hs.screen.find('DELL'):frame()
        w:setFrame(hs.geometry.rect(f.x, f.y, f.w, f.h/2))
        return 'ok'
      end
    end
    return 'wait'")
  if [ "$ok" = ok ]; then refocus; echo "chat-desk: on the Dell (top half)"; exit 0; fi
  sleep 0.5
done
refocus
echo "chat-desk: window didn't appear" >&2
exit 1
