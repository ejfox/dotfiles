#!/bin/bash
# One click, no typing: watches the clipboard while EJ clicks a dashboard's COPY button,
# pipes the value straight into `gh secret set` on each repo given, then clears the
# clipboard. Nothing is echoed or logged. EJ runs it himself:
#   gh-secret-from-clipboard CLOUDFLARE_API_TOKEN ejfox/spliffs-dot-org [owner/repo ...]
set -euo pipefail
NAME="$1"; shift
[ $# -gt 0 ] || { echo "usage: gh-secret-from-clipboard NAME owner/repo [owner/repo ...]"; exit 1; }

before="$(pbpaste)"
echo "Click the COPY button for ${NAME}..."
until [ "$(pbpaste)" != "$before" ] && [ -n "$(pbpaste)" ]; do sleep 0.4; done
for repo in "$@"; do
  pbpaste | tr -d '\n' | gh secret set "$NAME" -R "$repo" >/dev/null && echo "  set on $repo"
done
printf '' | pbcopy
echo "(clipboard cleared)"
