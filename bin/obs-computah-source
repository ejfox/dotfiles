#!/usr/local/bin/python3
"""obs-computah-source — put the PC's OBS program feed into the iMac OBS as its own scene.

Scene "computah" holds:
  "computah (Teleport)"  PRIMARY (2026-10-04). obs-teleport source dialing 10.0.0.169:9100 directly
                         (the PC's Teleport output, set up by computah pc/teleport-setup.ps1).
                         JPEG frames over TCP on the gigabit LAN: tens of ms instead of SRT's ~1-2 s.
                         MUTED with monitoring off — PC sound reaches the Mac through VBAN, and a
                         feed's audio is what drove this OBS to 960 ms of global audio buffering.
                         Retries forever, so it reconnects by itself after PC/OBS restarts.
  "computah (SRT)"       FALLBACK, hidden. Media Source LISTENING on :9000 for the PC's caller
                         (obs-srt.py). The PC's SRT stream is off while farm\\keeper\\obs-srt.off
                         exists; to fall back: delete that file on the PC, show this item.
Existing scenes are untouched; to use the feed elsewhere, add "computah (Teleport)" to any scene
as an existing source. Talks to the running iMac OBS over obs-websocket (password from OBS's own
config, never printed). Needs ~/Library/Application Support/obs-studio/plugins/obs-teleport.plugin.

  obs-computah-source          create/repair + grab a test frame to ~/Desktop/computah-feed-test.png
"""
import base64, json, os, sys, time
import obsws_python as obs

CFG = os.path.expanduser("~/Library/Application Support/obs-studio/plugin_config/obs-websocket/config.json")
SCENE, TP, SRT = "computah", "computah (Teleport)", "computah (SRT)"
PC = "10.0.0.169:9100"
SRT_URL = "srt://0.0.0.0:9000?mode=listener&latency=120000"     # the PC dials imacpro.local; latency in µs

cfg = json.load(open(CFG))
c = obs.ReqClient(host="127.0.0.1", port=cfg["server_port"], password=cfg["server_password"], timeout=10)

scenes = [s["sceneName"] for s in c.get_scene_list().scenes]
if SCENE not in scenes:
    c.create_scene(SCENE); print(f"◆ scene '{SCENE}' created")
inputs = [i["inputName"] for i in c.get_input_list().inputs]

# fallback SRT listener: always listening while the iMac OBS is open, clear_on_media_end so a
# dropped feed goes black instead of freezing
srt = {"is_local_file": False, "input": SRT_URL, "hw_decode": True, "restart_on_activate": False,
       "close_when_inactive": False, "reconnect_delay_sec": 2, "buffering_mb": 1, "clear_on_media_end": True}
if SRT not in inputs:
    c.create_input(SCENE, SRT, "ffmpeg_source", srt, False)
else:
    c.set_input_settings(SRT, srt, True)

kinds = c.get_input_kind_list(False).input_kinds
if "teleport-source" not in kinds:
    print("◇ obs-teleport plugin not loaded in this OBS (install it, then restart OBS)"); sys.exit(1)
tp = {"manual-ip": PC, "has-audio-and-video": True}
if TP not in inputs:
    c.create_input(SCENE, TP, "teleport-source", tp, True); print(f"◆ teleport source '{TP}' -> {PC}")
else:
    c.set_input_settings(TP, tp, True); print(f"◆ teleport source '{TP}' settings refreshed")
c.set_input_mute(TP, True)
c.set_input_audio_monitor_type(TP, "OBS_MONITORING_TYPE_NONE")

# Teleport on top filling the canvas; SRT hidden underneath
vs = c.get_video_settings()
fill = {"boundsType": "OBS_BOUNDS_SCALE_INNER", "boundsWidth": float(vs.base_width),
        "boundsHeight": float(vs.base_height), "positionX": 0.0, "positionY": 0.0, "alignment": 5}
items = {i["sourceName"]: i["sceneItemId"] for i in c.get_scene_item_list(SCENE).scene_items}
for name in (TP, SRT):
    c.set_scene_item_transform(SCENE, items[name], fill)
c.set_scene_item_enabled(SCENE, items[SRT], False)
c.set_scene_item_enabled(SCENE, items[TP], True)
c.set_scene_item_index(SCENE, items[TP], len(items) - 1)

# prove frames arrive: screenshot the SOURCE itself (not the program)
for attempt in range(10):
    time.sleep(2)
    try:
        shot = c.get_source_screenshot(TP, "png", 640, 360, -1).image_data
        raw = base64.b64decode(shot.split(",", 1)[1])
        if len(raw) > 4000:                                      # a black/empty frame compresses to almost nothing
            out = os.path.expanduser("~/Desktop/computah-feed-test.png")
            open(out, "wb").write(raw); print(f"◆ receiving video — test frame {out} ({len(raw)//1024} KB)"); sys.exit(0)
    except Exception as e:
        last = e
print(f"◇ no video yet (is the PC's Teleport output up? it listens on {PC})"); sys.exit(1)
