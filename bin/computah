#!/bin/bash
# computah — one command for the Windows gaming PC (9800X3D / RX 9070 XT).
# Picks LAN when home, Tailscale when away. Quiet by design.
#
#   computah                 ssh in
#   computah wake            wake it up (WoL magic packet, works from off)
#   computah harden-wol      make WoL survive a full shutdown (Fast Startup off, arm NIC)
#   computah status          reachable? load? disk?
#   computah doctor          full health check + auto-heal (models, services, deskflow)
#   computah render <file>   encode a video on the PC, result lands back beside it
#   computah blender <blend> render a .blend on the PC, frames come back
#   computah mount           mount the renders share in Finder
#   computah rgb [wave|breathe|pulse|screen|hue|off]  PC case+DualSense RGB (hue = opt-in desk mirror)
#   computah stream [app]    Moonlight-stream the PC desktop (or an app) here
#   computah sleep           put it to sleep
#   computah whisper <file>  transcribe audio/video → .srt + .txt beside it
#   computah demucs <file>   split stems on the PC → ~/Music/ACAPELLAS/<name>/
#   computah llm [on|off]    OpenAI-compatible LLM server on the PC (:8085)
#   computah imagine "<prompt>" [WxH]  FLUX image gen on the PC GPU, PNG lands in cwd
#   computah grid "<prompt>" [N]  NxN grid of alternates resolving live on the PC screen
#   computah muse [--ambient]  context-aware art: Qwen3 writes the prompt, FLUX paints it
#   computah muse-loop  never-ending WEIRD gallery wall; alternate cycles run the
#                       iMac screen through FLUX img2img (WALL_N, MUSE_SCREEN_EVERY)
#   computah run "<cmd>"     run any remote command
set -euo pipefail

LAN_IP=10.0.0.169
TS_IP=100.106.221.70
MAC_ADDR=30:c5:99:60:02:40
REMOTE_USER=ejfox
RENDERS_WIN='C:\Users\ejfox\renders'

host() {
  if nc -z -G 1 "$LAN_IP" 22 2>/dev/null; then echo "$LAN_IP"; else echo "$TS_IP"; fi
}

rssh() {
  ssh -o ConnectTimeout=8 "$REMOTE_USER@$(host)" "$@"
}

wake() {
  # Magic packet: 6x FF + 16x MAC, to LAN broadcast. No deps beyond python3.
  python3 - "$MAC_ADDR" <<'EOF'
import socket, sys
mac = bytes.fromhex(sys.argv[1].replace(':', ''))
pkt = b'\xff' * 6 + mac * 16
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
s.sendto(pkt, ('10.0.0.255', 9))
EOF
  echo "magic packet sent to $MAC_ADDR"
  for i in $(seq 1 30); do
    if nc -z -G 1 "$LAN_IP" 22 2>/dev/null; then echo "computah is up (${i}s)"; return; fi
    sleep 1
  done
  echo "no response after 30s — it may still be booting"
}

case "${1:-ssh}" in
  ssh)
    exec ssh "$REMOTE_USER@$(host)"
    ;;

  wake)
    wake
    ;;

  harden-wol)
    # Make WoL survive a FULL shutdown: disable Fast Startup (its hybrid-off
    # state leaves the NIC deaf to magic packets) + arm the NIC to wake on one.
    # Runs elevated via a one-shot scheduled task — SSH sessions aren't elevated,
    # and these calls need admin. BIOS "ErP Ready"/"Deep Sleep" stays a manual toggle.
    h=$(host)
    nc -z -G 3 "$h" 22 2>/dev/null || { echo "PC unreachable — power it on by hand first, then: computah harden-wol"; exit 1; }
    ps1=$(mktemp /tmp/harden-wol.XXXXXX).ps1
    cat > "$ps1" <<'PS'
$ErrorActionPreference = 'Continue'
$log = "$env:USERPROFILE\harden-wol.log"
"=== harden-wol $(Get-Date) ===" | Out-File $log -Encoding ascii
# 1. Fast Startup off (hybrid shutdown leaves the NIC deaf to magic packets)
powercfg /h off 2>&1 | Out-Null
Set-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Power' -Name HiberbootEnabled -Value 0 -Type DWord -Force
"fast-startup: disabled (HiberbootEnabled=0)" | Add-Content $log
# 2. Active wired adapter (prefer wired — WoL over WiFi is unreliable)
$a = Get-NetAdapter -Physical | ? { $_.Status -eq 'Up' -and $_.MediaType -ne 'Native 802.11' } | Sort LinkSpeed -Desc | Select -First 1
if (-not $a) { $a = Get-NetAdapter -Physical | ? { $_.Status -eq 'Up' } | Select -First 1 }
"adapter: $($a.Name) [$($a.InterfaceDescription)]" | Add-Content $log
# 3. Wake on Magic Packet (driver power management)
try { Set-NetAdapterPowerManagement -Name $a.Name -WakeOnMagicPacket Enabled -WakeOnPattern Disabled -EA Stop; "WakeOnMagicPacket: Enabled" | Add-Content $log } catch { "power-mgmt ERR: $_" | Add-Content $log }
foreach ($dn in @('Wake on Magic Packet','Wake on magic packet','WakeOnMagicPacket')) { try { Set-NetAdapterAdvancedProperty -Name $a.Name -DisplayName $dn -DisplayValue 'Enabled' -EA Stop; "adv '$dn': Enabled" | Add-Content $log; break } catch {} }
# Kill green/energy-efficient ethernet that can drop the link in low-power states
foreach ($dn in @('Energy-Efficient Ethernet','Green Ethernet','Advanced EEE','Gigabit Lite')) { try { Set-NetAdapterAdvancedProperty -Name $a.Name -DisplayName $dn -DisplayValue 'Disabled' -EA Stop; "adv '$dn': Disabled" | Add-Content $log } catch {} }
# 4. Arm the device (Device Manager: 'allow this device to wake the computer')
powercfg -deviceenablewake "$($a.InterfaceDescription)" 2>&1 | Add-Content $log
# 5. No self-wake at night (the 2AM rule): kill wake timers + the Win-Update wake task.
#    WoL from a magic packet still works — only unsolicited self-wakes are blocked.
powercfg -attributes 238c9fa8-0aad-41ed-83f4-97be242c8f20 f15576e8-98b7-4186-b944-eafa664402d9 -ATTRIB_HIDE 2>&1 | Out-Null
powercfg /SETACVALUEINDEX SCHEME_CURRENT 238c9fa8-0aad-41ed-83f4-97be242c8f20 f15576e8-98b7-4186-b944-eafa664402d9 0
powercfg /SETDCVALUEINDEX SCHEME_CURRENT 238c9fa8-0aad-41ed-83f4-97be242c8f20 f15576e8-98b7-4186-b944-eafa664402d9 0
powercfg /SETACTIVE SCHEME_CURRENT
schtasks /Change /TN "\Microsoft\Windows\UpdateOrchestrator\Schedule Wake To Work" /DISABLE 2>&1 | Out-Null
"wake-timers: disabled (no self-wake at night; WoL magic packet still works)" | Add-Content $log
"--- armed devices ---" | Add-Content $log
powercfg -devicequery wake_armed | Add-Content $log
"--- wake timers (want: none) ---" | Add-Content $log
powercfg -waketimers | Add-Content $log
PS
    echo "→ shipping hardening script to computah"
    scp -q "$ps1" "$REMOTE_USER@$h:harden-wol.ps1"
    rm -f "$ps1"
    echo "→ applying (elevated, one-shot scheduled task)"
    # past-dated ONCE task; /run triggers it immediately (the /ST warning is harmless)
    rssh "schtasks /create /f /tn harden-wol /rl HIGHEST /sc ONCE /st 00:00 /sd 01/01/2020 /ru $REMOTE_USER /tr \"powershell -NoProfile -ExecutionPolicy Bypass -File C:\\Users\\$REMOTE_USER\\harden-wol.ps1\"" >/dev/null 2>&1
    rssh "schtasks /run /tn harden-wol" >/dev/null 2>&1
    # poll until the task finishes writing its log (up to ~24s) instead of a fixed sleep
    for i in $(seq 1 12); do
      sleep 2
      rssh "powershell -NoProfile -Command \"(Test-Path \$env:USERPROFILE\\harden-wol.log) -and ((Get-Content \$env:USERPROFILE\\harden-wol.log -Raw) -match 'armed devices')\"" 2>/dev/null | tr -d '\r' | grep -qi true && break
    done
    echo "--- result ---"
    rssh "powershell -NoProfile -Command \"if(Test-Path \$env:USERPROFILE\\harden-wol.log){Get-Content \$env:USERPROFILE\\harden-wol.log}else{'no log written'}\"" 2>/dev/null | tr -d '\r' || true
    echo
    echo "◆ done — Fast Startup off + NIC armed. Test: computah sleep, then computah wake."
    echo "  Still dead from a full shutdown? Enable WoL / disable 'ErP Ready' in BIOS (manual)."
    ;;

  doctor)
    # One-shot health check + auto-heal of the whole PC integration. Safe to
    # run anytime; starts the preview server and heals deskflow if needed.
    ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
    bad() { printf '  \033[31m✗\033[0m %s\n' "$*"; }
    h=$(host)
    echo "◆ computah doctor"
    if ! nc -z -G 3 "$h" 22 2>/dev/null; then bad "PC unreachable (try: computah wake)"; exit 1; fi
    [ "$h" = "$LAN_IP" ] && ok "reachable via LAN ($h)" || ok "reachable via Tailscale ($h)"
    # models
    miss=$(rssh "powershell -NoProfile -Command \"@('models\image\flux-2-klein-9b-Q5_K_M.gguf','models\image\flux2-vae.safetensors','models\image\qwen3-8b-Q6_K.gguf','models\image\taef2.safetensors','models\vlm\Qwen2.5-VL-7B-Q4_K_M.gguf','models\vlm\mmproj-Qwen2.5-VL-7B.gguf','farm\sd\sd-cli.exe') | Where-Object { -not (Test-Path (Join-Path \$env:USERPROFILE \$_)) }\"" 2>/dev/null | tr -d '\r')
    [ -z "$miss" ] && ok "all models + sd-cli present" || bad "missing: $miss"
    # persistent settings
    dfx=$(rssh "powershell -NoProfile -Command \"((Get-MpPreference).ExclusionPath).Count\"" 2>/dev/null | tr -d '\r')
    [ "${dfx:-0}" -ge 2 ] && ok "Defender exclusions set (fast model loads)" || bad "Defender exclusions MISSING — loads will crawl"
    fw=$(rssh "powershell -NoProfile -Command \"[int](([bool](Get-NetFirewallRule -DisplayName 'llama-server 8085' -EA SilentlyContinue)) -and ([bool](Get-NetFirewallRule -DisplayName 'preview-server 7861' -EA SilentlyContinue)))\"" 2>/dev/null | tr -d '\r')
    [ "$fw" = "1" ] && ok "firewall rules (8085, 7861) present" || bad "firewall rule(s) missing"
    mon=$(rssh "powershell -NoProfile -Command \"(powercfg /query SCHEME_CURRENT SUB_VIDEO VIDEOIDLE | Select-String 'Current AC') -replace '.*: ',''\"" 2>/dev/null | tr -d '\r')
    [ "$mon" = "0x00000000" ] && ok "display set to never sleep (AC)" || bad "display will sleep (monitor-timeout not 0)"
    # wake-on-LAN readiness — so `computah wake` works after a full shutdown
    wol=$(rssh "powershell -NoProfile -Command \"\$hb=(Get-ItemProperty 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power' -Name HiberbootEnabled -EA SilentlyContinue).HiberbootEnabled; \$armed=((powercfg -devicequery wake_armed) -join ','); if (\$hb -eq 0 -and \$armed -match 'Ethernet|Realtek|Intel|Killer|Network') { '1' } else { '0' }\"" 2>/dev/null | tr -d '\r')
    [ "$wol" = "1" ] && ok "wake-on-LAN armed (Fast Startup off, NIC wakes)" || bad "wake-on-LAN NOT armed — run: computah harden-wol"
    # night-wake guard — nothing may self-wake the PC at night (the 2AM rule)
    wt=$(rssh "powershell -NoProfile -Command \"@((powercfg -waketimers) | Select-String 'expires').Count\"" 2>/dev/null | tr -d '\r')
    [ "${wt:-0}" = "0" ] && ok "no wake timers armed (won't self-wake at night)" || bad "$wt wake timer(s) ARMED — run: computah harden-wol"
    # preview server — start if down
    if [ "$(curl -s -m3 -o /dev/null -w '%{http_code}' "http://$h:7861/wall.html" 2>/dev/null)" = "200" ]; then
      ok "preview server up (:7861)"
    else
      rssh "schtasks /run /tn preview-server >nul" 2>/dev/null; sleep 3
      [ "$(curl -s -m3 -o /dev/null -w '%{http_code}' "http://$h:7861/wall.html" 2>/dev/null)" = "200" ] && ok "preview server STARTED (:7861)" || bad "preview server won't start"
    fi
    # muse loop status
    pgrep -f "computah muse-loop" >/dev/null && ok "muse-loop running" || echo "  · muse-loop not running (start: computah muse-loop)"
    # deskflow KVM
    if command -v deskflow-heal >/dev/null 2>&1; then
      deskflow-heal >/dev/null 2>&1
      lsof -nP -iTCP:24800 2>/dev/null | grep -qi established && ok "deskflow KVM connected" \
        || { lsof -nP -iTCP:24800 -sTCP:LISTEN >/dev/null 2>&1 && echo "  · deskflow listening, client not connected yet" || bad "deskflow core not listening"; }
    fi
    echo "◆ done"
    ;;

  sleep)
    rssh 'rundll32.exe powrprof.dll,SetSuspendState 0,1,0' || true
    echo "sleep requested"
    ;;

  status)
    h=$(host)
    if ! nc -z -G 2 "$h" 22 2>/dev/null; then echo "computah: unreachable (try: computah wake)"; exit 1; fi
    [ "$h" = "$LAN_IP" ] && echo "computah: up via LAN ($h)" || echo "computah: up via Tailscale ($h)"
    rssh "powershell -NoProfile -Command \"'uptime  ' + ((Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime).ToString('d\\d\\ h\\h\\ m\\m'); 'cpu     ' + (Get-CimInstance Win32_Processor).LoadPercentage + '%'; 'disk C  ' + [math]::Round((Get-PSDrive C).Free/1GB) + ' GB free'\""
    ;;

  mount)
    open "smb://$REMOTE_USER@$(host)/renders"
    echo "opening renders share in Finder (password saved to Keychain after first connect)"
    ;;

  render)
    src="${2:?usage: computah render <video> [ffmpeg output args...]}"
    [ -f "$src" ] || { echo "no such file: $src"; exit 1; }
    shift 2
    base=$(basename "$src")
    out="${base%.*}-computah.mp4"
    h=$(host)
    echo "→ shipping $base to computah"
    scp -q "$src" "$REMOTE_USER@$h:renders/"
    echo "→ encoding on the 9800X3D (x265 crf 18)"
    # Default: HEVC archival/upload quality. Extra args after the file override nothing; they append.
    # Resolve the real versioned ffmpeg dir: the admin SSH session refuses to
    # traverse scoop's user-created 'current' junction (and the shim can't spawn).
    rssh "powershell -NoProfile -Command \"\$f = (Get-ChildItem \$env:USERPROFILE\\scoop\\apps\\ffmpeg -Directory | Where-Object Name -ne current | Sort-Object Name -Descending | Select-Object -First 1).FullName + '\\bin\\ffmpeg.exe'; Set-Location \$env:USERPROFILE\\renders; & \$f -y -hide_banner -loglevel warning -i '$base' -c:v libx265 -crf 18 -preset medium -tag:v hvc1 -c:a aac -b:a 320k $* '$out'\""
    echo "→ retrieving result"
    scp -q "$REMOTE_USER@$h:renders/$out" "$(dirname "$src")/"
    rssh "del /q \"$RENDERS_WIN\\$base\" \"$RENDERS_WIN\\$out\"" 2>/dev/null || true
    echo "done: $(dirname "$src")/$out"
    ;;

  blender)
    blend="${2:?usage: computah blender <file.blend> [extra blender args, default: -a]}"
    [ -f "$blend" ] || { echo "no such file: $blend"; exit 1; }
    shift 2
    args="${*:--a}"
    base=$(basename "$blend")
    job="${base%.blend}"
    h=$(host)
    echo "→ shipping $base to computah"
    rssh "powershell -NoProfile -Command \"New-Item -ItemType Directory -Force -Path '$RENDERS_WIN\\blender\\$job\\out' | Out-Null\""
    scp -q "$blend" "$REMOTE_USER@$h:renders/blender/$job/"
    echo "→ rendering on the RX 9070 XT"
    rssh "powershell -NoProfile -Command \"\$b = (Get-ChildItem 'C:\\Program Files\\Blender Foundation' -Directory | Sort-Object Name -Descending | Select-Object -First 1).FullName + '\\blender.exe'; & \$b -b '$RENDERS_WIN\\blender\\$job\\$base' -o '$RENDERS_WIN\\blender\\$job\\out\\frame_####' $args -- --cycles-device HIP\""
    echo "→ retrieving frames"
    dest="$(dirname "$blend")/${job}-frames"
    mkdir -p "$dest"
    scp -q -r "$REMOTE_USER@$h:renders/blender/$job/out/*" "$dest/"
    echo "done: $dest/"
    ;;

  whisper)
    src="${2:?usage: computah whisper <audio/video file>}"
    [ -f "$src" ] || { echo "no such file: $src"; exit 1; }
    base=$(basename "$src")
    h=$(host)
    echo "→ shipping $base"
    scp -q "$src" "$REMOTE_USER@$h:farm/"
    echo "→ transcribing (whisper large-v3-turbo)"
    rssh "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& \$env:USERPROFILE\\farm\\whisper\\Release\\whisper-cli.exe -m \$env:USERPROFILE\\models\\whisper\\ggml-large-v3-turbo.bin -f \$env:USERPROFILE\\farm\\$base -osrt -otxt -of \$env:USERPROFILE\\farm\\${base%.*} 2>\$null | Out-Null; 'transcribed'\""
    scp -q "$REMOTE_USER@$h:farm/${base%.*}.srt" "$REMOTE_USER@$h:farm/${base%.*}.txt" "$(dirname "$src")/"
    echo "done: $(dirname "$src")/${base%.*}.{srt,txt}"
    ;;

  demucs)
    src="${2:?usage: computah demucs <audio file>}"
    [ -f "$src" ] || { echo "no such file: $src"; exit 1; }
    base=$(basename "$src")
    h=$(host)
    echo "→ shipping $base"
    scp -q "$src" "$REMOTE_USER@$h:farm/"
    echo "→ separating stems on the 9800X3D"
    rssh "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& \$env:USERPROFILE\\scoop\\persist\\uv\\tools\\shims\\demucs.exe -o \$env:USERPROFILE\\farm\\stems \$env:USERPROFILE\\farm\\$base\""
    dest="$HOME/Music/ACAPELLAS/${base%.*}"
    mkdir -p "$dest"
    scp -q -r "$REMOTE_USER@$h:farm/stems/htdemucs/${base%.*}/*" "$dest/"
    echo "done: $dest/ (vocals, drums, bass, other)"
    ;;

  llm)
    case "${2:-on}" in
      on)
        # Start-Process dies when the SSH session ends (Windows kills the
        # process tree on disconnect) — a scheduled task survives. The task
        # is a one-shot dated in the past: never auto-fires, /run-able forever.
        rssh "schtasks /query /tn llama-server >nul 2>&1 || schtasks /create /f /tn llama-server /sc once /st 00:00 /sd 01/01/2020 /ru $REMOTE_USER /tr \"cmd /c cd /d C:\Users\\$REMOTE_USER\farm\llama && llama-server.exe -m C:\Users\\$REMOTE_USER\models\llm\Qwen3-14B-Q4_K_M.gguf --host 0.0.0.0 --port 8085 -ngl 99 > C:\Users\\$REMOTE_USER\farm\llama-server.log 2>&1\""
        rssh "tasklist | findstr /i llama-server.exe >nul && echo already running || (schtasks /run /tn llama-server >nul && echo llama-server starting on :8085)"
        echo "endpoint: http://$(host):8085/v1 (OpenAI-compatible, also on tailnet)"
        ;;
      off) rssh "powershell -NoProfile -Command \"Stop-Process -Name llama-server -Force -ErrorAction SilentlyContinue; 'stopped'\"" ;;
    esac
    ;;

  sd-server)
    # Persistent HOT image server (FLUX.2-klein on the 9070 XT). Keeps the model
    # resident so `imagine`/muse-loop skip the per-render model reload. The model
    # loads once at startup (a few min); after that each render is sampling-only.
    # A logon scheduled task (tn sd-server) brings it back after a reboot.
    h=$(host)
    case "${2:-status}" in
      start|up|on)
        rssh "tasklist | findstr /i sd-server.exe >nul && echo already-running || (schtasks /run /tn sd-server >nul && echo starting)"
        echo "loading model… (first render waits for it); endpoint http://$h:1234/sdapi/v1/{txt2img,img2img}"
        ;;
      stop|off|down)
        # The wrapper cmd exits once sd-server.exe dies, so one taskkill is enough.
        rssh "taskkill /im sd-server.exe /f >nul 2>&1 & echo stopped" ;;
      restart)
        "$0" sd-server stop >/dev/null 2>&1; sleep 3; "$0" sd-server start ;;
      log)
        rssh "powershell -NoProfile -Command \"Get-Content C:\Users\\$REMOTE_USER\farm\sd\sd-server.log -Tail 20\"" ;;
      status|*)
        up=$(curl -s -m4 -o /dev/null -w '%{http_code}' "http://$h:1234/v1/models" 2>/dev/null)
        [ "$up" = "200" ] && echo "sd-server UP (:1234, model hot)" || echo "sd-server DOWN — 'computah sd-server start'"
        ;;
    esac
    ;;

  imagine)
    prompt="${2:?usage: computah imagine \"<prompt>\" [WxH]}"
    size="${3:-1024x1024}"
    W="${size%x*}"; H="${size#*x}"
    h=$(host)
    FARM="C:\Users\\$REMOTE_USER\farm"
    out="imagine-$(date +%H%M%S).png"
    steps="${STEPS:-32}"
    seed="${IMAGINE_SEED:-$RANDOM}"
    strength="${IMAGINE_STRENGTH:-0.7}"
    # Diffusion mechanics vary per call (muse-loop dials these). Defaults are the
    # OLD behavior exactly (euler, cfg 1.0) so a caller that sets neither — incl. a
    # running muse-loop on older code — renders identically to before.
    sampler="${IMAGINE_SAMPLER:-euler}"
    cfg="${IMAGINE_CFG:-1.0}"
    # Render via the PERSISTENT sd-server (hot model, no per-render reload). A full
    # model reload per cell is what used to make the wall crawl and spawn the
    # VRAM-eating sd-cli zombies. img2img kicks in when the caller hands us a LOCAL
    # init image (IMAGINE_INIT_LOCAL = a path on THIS mac); we base64 it in.
    endpoint="txt2img"; init="${IMAGINE_INIT_LOCAL:-}"
    { [ -n "$init" ] && [ -s "$init" ]; } && endpoint="img2img"
    echo "→ sd-server $endpoint (FLUX.2-klein, ${W}x${H}, ${steps} steps, ${sampler} cfg${cfg}, seed $seed${init:+, img2img s=$strength})"
    if ! HOST="$h" PROMPT="$prompt" IW="$W" IH="$H" ISTEPS="$steps" ISEED="$seed" \
         ISTRENGTH="$strength" ENDPOINT="$endpoint" INIT="$init" OUT="./$out" \
         ISAMPLER="$sampler" ICFG="$cfg" python3 - <<'PYEOF'
import os, sys, json, base64, urllib.request
h = os.environ["HOST"]; ep = os.environ["ENDPOINT"]
body = {"prompt": os.environ["PROMPT"], "steps": int(os.environ["ISTEPS"]),
        "cfg_scale": float(os.environ.get("ICFG", "1.0")),
        "width": int(os.environ["IW"]), "height": int(os.environ["IH"]),
        "seed": int(os.environ["ISEED"]),
        "sampler_name": os.environ.get("ISAMPLER", "euler")}
if ep == "img2img":
    with open(os.environ["INIT"], "rb") as f:
        body["init_images"] = [base64.b64encode(f.read()).decode()]
    body["denoising_strength"] = float(os.environ["ISTRENGTH"])
req = urllib.request.Request(f"http://{h}:1234/sdapi/v1/{ep}",
      json.dumps(body).encode(), {"Content-Type": "application/json"})
try:
    r = json.load(urllib.request.urlopen(req, timeout=300))
except Exception as e:
    print("sd-server error:", e, file=sys.stderr); sys.exit(1)
imgs = r.get("images") or []
if not imgs:
    print("sd-server returned no image", file=sys.stderr); sys.exit(1)
open(os.environ["OUT"], "wb").write(base64.b64decode(imgs[0]))
PYEOF
    then
      echo "render failed — sd-server unreachable or errored (is it up? 'computah sd-server')"; exit 1
    fi
    # Push back to the PC: imagine.png feeds the gallery/TouchDesigner copies that
    # muse-loop makes; wall_<slot>.png is what the live HTTP wall displays.
    scp -q "./$out" "$REMOTE_USER@$h:farm/imagine.png" 2>/dev/null || true
    [ -n "${IMAGINE_WALL_SLOT:-}" ] && scp -q "./$out" "$REMOTE_USER@$h:farm/sd/wall_${IMAGINE_WALL_SLOT}.png" 2>/dev/null || true
    rssh "copy /y $FARM\imagine.png C:\Users\\$REMOTE_USER\muse-td\finals\td-$(date +%H%M%S).png" >/dev/null 2>&1 || true
    echo "done: ./$out"
    # Auto-open is OPT-IN (MUSE_OPEN=1) — don't hijack Preview by default. Use
    # if/fi so a false condition still leaves the case exiting 0 (a trailing
    # `&&` chain that's false would make imagine return 1 = false "render hiccup").
    if [ -n "${MUSE_OPEN:-}" ] && [ -z "${MUSE_NO_OPEN:-}" ]; then
      command -v open >/dev/null && open "./$out"
    fi
    ;;

  grid)
    prompt="${2:?usage: computah grid \"<prompt>\" [N] (NxN alternates, default 3)}"
    N="${3:-3}"
    total=$((N * N))
    size="${GRID_SIZE:-768x768}"
    W="${size%x*}"; H="${size#*x}"
    steps="${STEPS:-16}"
    h=$(host)
    FARM="C:\Users\\$REMOTE_USER\farm"
    M="C:\Users\\$REMOTE_USER\models\image"
    echo "→ ${N}x${N} = ${total} alternates of: $prompt  (${W}x${H}, ${steps} steps each)"
    # Clear old cells + tell the grid viewer the dimension, then pop it up.
    rssh "del $FARM\sd\grid_*.png $FARM\sd\preview.png >nul 2>&1 & echo $N > $FARM\sd\grid-n.txt" >/dev/null 2>&1 || true
    rssh "schtasks /run /tn grid-show >nul" 2>/dev/null || true
    # One headless render per cell (fast loads make this practical). Each writes
    # its own grid_<i>.png; preview.png streams the cell currently resolving.
    for i in $(seq 1 "$total"); do
      seed=$(( (i * 7919 + $(date +%s)) % 2000000 ))
      tmp=$(mktemp /tmp/grid-run.XXXXXX)
      cat > "$tmp" <<CMDEOF
@echo off
cd /d $FARM\sd
del $FARM\sd\preview.png >nul 2>&1
sd-cli.exe --diffusion-model $M\flux-2-klein-9b-Q5_K_M.gguf --vae $M\flux2-vae.safetensors --llm $M\qwen3-8b-Q6_K.gguf --backend diffusion=vulkan0,te=cpu,vae=vulkan0 -p "$prompt" --seed $seed --cfg-scale 1.0 --steps $steps --sampling-method euler -W $W -H $H --diffusion-fa --taesd $M\taef2.safetensors --taesd-preview-only --preview tae --preview-interval 1 --preview-path $FARM\sd\preview.png -o $FARM\sd\grid_$i.png > $FARM\sd\grid-run.log 2>&1
CMDEOF
      awk '{printf "%s\r\n", $0}' "$tmp" > "$tmp.cmd" && scp -q "$tmp.cmd" "$REMOTE_USER@$h:farm/sd/grid-run.cmd" && rm -f "$tmp" "$tmp.cmd"
      rssh "schtasks /query /tn grid-run >nul 2>&1 || schtasks /create /f /tn grid-run /sc once /st 00:00 /sd 01/01/2020 /ru $REMOTE_USER /tr \"powershell -NoProfile -WindowStyle Hidden -Command cmd /c $FARM\sd\grid-run.cmd\"" >/dev/null
      rssh "schtasks /run /tn grid-run >nul" || true
      # wait for this cell to finish before starting the next (single GPU)
      for w in $(seq 1 200); do
        rssh "if exist $FARM\sd\grid_$i.png (echo YES)" 2>/dev/null | grep -q YES && break
        sleep 2
      done
      echo "  cell $i/$total done"
    done
    # Composite the sheet locally and drop it on the Desktop.
    dest="$HOME/Desktop/grid-$(date +%H%M%S).png"
    tmpd=$(mktemp -d)
    scp -q "$REMOTE_USER@$h:farm/sd/grid_*.png" "$tmpd/" 2>/dev/null || true
    if command -v montage >/dev/null 2>&1; then
      montage $(for i in $(seq 1 "$total"); do echo "$tmpd/grid_$i.png"; done) -tile ${N}x${N} -geometry +2+2 -background black "$dest" 2>/dev/null && echo "sheet: $dest"
    else
      cp "$tmpd/grid_1.png" "$dest" 2>/dev/null; echo "cells in $tmpd/ (install imagemagick for a stitched sheet)"
    fi
    rm -rf "$tmpd"
    # Auto-open is OPT-IN (MUSE_OPEN=1) — don't hijack Preview by default.
    [ -n "${MUSE_OPEN:-}" ] && command -v open >/dev/null && [ -f "$dest" ] && open "$dest"
    ;;

  muse)
    # Ambient art: read what EJ's working on, let the PC's own LLM write one
    # image prompt, render it, feed the MagicMirror panel + PC preview window.
    # --ambient (the 30-min LaunchAgent): every guard fails silently, never
    # wakes the PC, sleeps 22:00-09:00.
    ambient=""
    [ "${2:-}" = "--ambient" ] && ambient=1
    if [ -n "$ambient" ]; then
      hh=$(date +%H)
      { [ "$hh" -ge 9 ] && [ "$hh" -lt 22 ]; } || exit 0
      nc -z -G 1 "$LAN_IP" 22 2>/dev/null || exit 0
    fi
    h=$(host)
    # Don't step on a game (3D engine >60%) or an actual in-flight render.
    # Check for the real sd-cli.exe process, NOT the schtask status — a hung
    # render leaves the task stuck "Running" and would wedge the loop forever.
    busy=$(rssh "powershell -NoProfile -Command \"[int]((((Get-Counter '\GPU Engine(*engtype_3D)\Utilization Percentage' -ErrorAction SilentlyContinue).CounterSamples | Measure-Object CookedValue -Sum).Sum))\"" 2>/dev/null | tr -d '\r' || echo 0)
    rendering=$(rssh "tasklist | findstr /i sd-cli.exe" 2>/dev/null || true)
    if [ "${busy:-0}" -gt 60 ] || [ -n "$rendering" ]; then
      [ -n "$ambient" ] && exit 0
      echo "GPU busy (3D ${busy:-?}%${rendering:+, render in flight}) — not stepping on it"; exit 1
    fi
    ctx="time: $(date '+%A %H:%M')"
    tw=$(tmux list-windows -a -F '#{session_name}:#{window_name}' 2>/dev/null | sort -u | tr '\n' ' ' || true)
    [ -n "$tw" ] && ctx="$ctx
tmux: $tw"
    slog="$HOME/.local/share/usage-logs/shell/$(date +%F).jsonl"
    if [ -f "$slog" ]; then
      cmds=$(tail -30 "$slog" | python3 -c 'import sys,json
seen={}
for l in sys.stdin:
    try: c=json.loads(l).get("command","")[:60]
    except Exception: continue
    if c: seen[c]=1
print("; ".join(list(seen)[-12:]))' 2>/dev/null || true)
      [ -n "$cmds" ] && ctx="$ctx
recent shell: $cmds"
    fi
    nlog="$HOME/.local/share/usage-logs/nvim/$(date +%F).jsonl"
    if [ -f "$nlog" ]; then
      files=$(tail -30 "$nlog" | python3 -c 'import sys,json,os
seen={}
for l in sys.stdin:
    try: p=json.loads(l).get("path","")
    except Exception: continue
    if p: seen[os.path.basename(p)]=1
print(" ".join(list(seen)[-10:]))' 2>/dev/null || true)
      [ -n "$files" ] && ctx="$ctx
editing: $files"
    fi
    echo "→ asking the PC's Qwen3 for a prompt"
    "$0" llm on >/dev/null 2>&1
    for i in $(seq 1 30); do
      [ "$(curl -s -m 2 -o /dev/null -w '%{http_code}' "http://$h:8085/health" 2>/dev/null)" = "200" ] && break
      sleep 3
    done
    mprompt=$(CTX="$ctx" HOST="$h" python3 - <<'PYEOF' || true
import json, os, re, urllib.request
body = json.dumps({
    "messages": [
        {"role": "system", "content": "You write ONE deeply WEIRD image-generation prompt (30-60 words) for an ambient art wall. Be surreal, uncanny, dreamlike, glitchy — bio-mechanical hybrids, impossible physics, melting architecture, eldritch creatures, fever-dream color. Draw a loose oblique connection to what the user is working on. Vary the medium wildly each time: risograph, CRT glitch, wet-plate photo, claymation still, medical illustration, tarot card, blacklight poster, diorama macro. Foxes optional. No words or text in the image. Reply with ONLY the prompt. /no_think"},
        {"role": "user", "content": os.environ["CTX"]},
    ],
    "max_tokens": 400,
}).encode()
req = urllib.request.Request(f"http://{os.environ['HOST']}:8085/v1/chat/completions",
                             body, {"Content-Type": "application/json"})
r = json.load(urllib.request.urlopen(req, timeout=120))
p = r["choices"][0]["message"]["content"]
p = re.sub(r"<think>.*?</think>", "", p, flags=re.S)
p = re.sub(r'["&<>|`$\\\n\r]', " ", p).strip()
print(" ".join(p.split()))
PYEOF
)
    "$0" llm off >/dev/null 2>&1
    [ -n "$mprompt" ] || { [ -n "$ambient" ] && exit 0; echo "no prompt came back"; exit 1; }
    # MUSE_SCREEN=1: grab the iMac screen and run it THROUGH the prompt as an
    # img2img init — FLUX hallucinates a weird reinterpretation of what's on the
    # display right now. All local (screencapture + FLUX on the PC).
    unset IMAGINE_INIT_LOCAL IMAGINE_STRENGTH
    if [ -n "${MUSE_SCREEN:-}" ] && command -v screencapture >/dev/null 2>&1; then
      if screencapture -x -t png -D 1 /tmp/muse-screen.png 2>/dev/null && [ -s /tmp/muse-screen.png ]; then
        if sips -Z 1024 /tmp/muse-screen.png --out /tmp/muse-screen-sm.png >/dev/null 2>&1 && [ -s /tmp/muse-screen-sm.png ]; then
          # sd-server gets the init straight from this local file (base64) — no scp.
          export IMAGINE_INIT_LOCAL=/tmp/muse-screen-sm.png
          export IMAGINE_STRENGTH="${MUSE_SCREEN_STRENGTH:-0.72}"
          mprompt="a fever-dream reinterpretation of this scene — $mprompt"
          echo "  (through the iMac screen, strength $IMAGINE_STRENGTH)"
        fi
      fi
    fi
    echo "→ muse: $mprompt"
    mkdir -p /tmp/muse && cd /tmp/muse
    MUSE_NO_OPEN=1 "$0" imagine "$mprompt" || { [ -n "$ambient" ] && exit 0; exit 1; }
    newest=$(ls -t imagine-*.png 2>/dev/null | head -1)
    mm="$HOME/code/magic-mirror/modules/MMM-Muse"
    [ -n "$newest" ] && [ -d "$mm" ] && mv "$newest" "$mm/muse.png" && rm -f imagine-*.png
    echo "muse delivered to the mirror"
    ;;

  muse-loop)
    set +e   # ambient forever-loop: a single failed command must never abort it
    # Never-ending WEIRD gallery WALL, grounded in YOUR world: prompts are
    # brainstormed by the PC's Qwen from your most-recent Obsidian notes (vaguely,
    # obliquely), and alternate cells run the iMac screen through FLUX img2img.
    # Displays in your Mac browser (PC serves the wall over HTTP) — no Windows
    # window wrangling. Renders on the PC GPU. Auto-pauses when a game is running.
    gap="${2:-3}"
    N="${WALL_N:-4}"
    total=$((N * N))
    h=$(host)
    FARM="C:\Users\\$REMOTE_USER\farm"
    every="${MUSE_SCREEN_EVERY:-2}"
    export IMAGINE_NO_SHOW=1
    echo "◆ muse-loop → ${N}x${N} wall from your Obsidian notes + screen"
    # Display: WALL_DISPLAY=windows (default) shows it on the PC monitor;
    # =mac opens it in the Mac browser instead.
    rssh "echo $N > $FARM\sd\wall-n.txt" >/dev/null 2>&1 || true
    # Ensure the HTTP preview server is up (its run-once task doesn't survive a
    # reboot on its own) — start it if nothing is answering on 7861.
    if [ "$(curl -s -m3 -o /dev/null -w '%{http_code}' "http://$h:7861/wall.html" 2>/dev/null)" != "200" ]; then
      rssh "schtasks /run /tn preview-server >nul" 2>/dev/null || true; sleep 3
    fi
    if [ "${WALL_DISPLAY:-windows}" = "mac" ]; then
      command -v open >/dev/null && open "http://$h:7861/wall.html?n=$N" 2>/dev/null || true
    else
      rssh "schtasks /run /tn wall-show >nul" 2>/dev/null || true
    fi

    _wait_8085() { for i in $(seq 1 40); do [ "$(curl -s -m2 -o /dev/null -w '%{http_code}' "http://$h:8085/health" 2>/dev/null)" = "200" ] && return 0; sleep 3; done; return 1; }
    _vlm_ready() { rssh "if exist C:\Users\\$REMOTE_USER\models\vlm\Qwen2.5-VL-7B-Q4_K_M.gguf (echo Y)" 2>/dev/null | grep -q Y; }

    prompts=(); pidx=0
    # Re-look at your screen once per full wall by default. The vision model
    # evicts FLUX from RAM cache, so each re-look costs one slow cold render —
    # doing it per-wall (not every 8) keeps all but one cell resolving smoothly.
    bn="${MUSE_BATCH:-$total}"
    # Fixed look for the whole wall: flat vector illustration in the vulpes palette.
    # The vision/text models describe only SUBJECTS; this enforces the style.
    # Style goes straight to the image model — POSITIVE terms only. Never name
    # things you don't want (saying "no text" primes text; cfg 1.0 ignores negatives).
    # STYLE is no longer one frozen look. A pool is rotated PER CELL so the wall
    # stops reading as "all flat-vector-pink-teal" — the input variety was always
    # there, the aesthetic was the monotony. MUSE_STYLE=<string> pins it back to a
    # single style (old behavior). ~MUSE_STYLELESS_PCT of cells render with NO
    # style at all → the subject stands bare (pairs with the brevity roll below to
    # give genuinely short prompts). POSITIVE terms only (cfg~1 ignores negatives).
    if [ -n "${MUSE_STYLE:-}" ]; then
      STYLES=("$MUSE_STYLE")
    else
      STYLES=(
        "minimalist flat vector illustration, bold geometric shapes, large flat areas of solid color, thick clean outlines, screenprint poster, hot pink and cyan-teal on deep black, high contrast"
        "loose gestural ink and watercolor, wet bleeding edges, rice-paper texture, muted earth tones with one bright accent"
        "risograph print, grainy halftone dots, two-color overprint misregistration, pink and blue, visible paper grain"
        "moody oil painting, thick impasto brushwork, chiaroscuro lighting, deep shadows, old-master palette"
        "1970s airbrushed sci-fi paperback cover, soft gradients, chrome and sunset colors, dramatic lens flare"
        "charcoal and graphite sketch on toned paper, smudged shading, visible construction lines, monochrome"
        "cyanotype blueprint, prussian blue, white linework, chemical splotches, antique paper edges"
        "isometric 3D clay render, soft studio lighting, gentle ambient occlusion, pastel palette"
        "japanese woodblock print, carved flat shapes, visible woodgrain, limited ink, ukiyo-e composition"
        "grainy 35mm film photograph, shallow depth of field, natural window light, faded kodak color"
        "pixel art, limited 16-color palette, crisp ordered dithering, retro game sprite"
        "art nouveau poster, flowing organic linework, ornamental border, muted golds and forest greens"
        "brutalist collage, torn paper, photocopied high-contrast textures, xerox grit, single spot color"
        "stained glass, leaded black outlines, luminous saturated panes, radial symmetry"
      )
    fi
    STYLELESS_PCT="${MUSE_STYLELESS_PCT:-20}"
    # MOTIF is mined ORGANICALLY from your world (Obsidian wikilinks/tags, project
    # names, recent notes) by muse-ingredients, refreshed each wall. This small
    # list is only a fallback if mining ever comes up short.
    MOTIF_FALLBACK=(
      "a red fox" "a swarm of FPV drones" "a glowing terminal stack" "a mesh-network tower"
      "a lone hacker silhouette" "a chrome fox skull" "a workshop of half-built gadgets"
      "a river of flowing code" "a synthesizer grown into an organism" "a sprawling data-city"
      "a forest of circuit boards" "an e-ink monolith" "a cartographer's cluttered desk"
      "a neon night market" "a satellite unfurling" "a tangle of cables and moss"
      "a hand-drawn map coming alive" "a CRT altar" "a drone-bee hive" "an island of servers"
      "a lighthouse of antennas" "a garden of solar panels" "a cathedral of vacuum tubes"
      "a whale made of stained glass" "a clockwork heart" "a jellyfish of fiber optics"
      "a mountain of cassette tapes" "a phoenix of circuit traces" "a spider spinning copper wire"
      "a lantern-fish anglerfish" "a moth with monitor-wings" "a tortoise carrying a city"
      "a wolf woven from static" "a crow holding a floppy disk" "a deer with antler antennas"
      "an octopus at a mixing desk" "a beetle plated in solar cells" "a hummingbird drone"
      "a fox spirit in a shrine" "a cyberpunk street food cart" "a rain-soaked alley of neon signs"
      "a rooftop garden over a megacity" "a subway map as a nervous system" "a desert of dead servers"
      "a coral reef of keyboards" "a library of glowing scrolls" "a greenhouse of bioluminescent plants"
      "an observatory dome at dusk" "a shipwreck reclaimed by kelp" "a monastery on a floating rock"
      "a market stall of strange fruit" "a diver in an ocean of ink" "a beekeeper among data-hives"
      "a lone tree wired with lights" "a paper crane made of maps" "a totem of stacked radios"
      "a fountain pouring liquid light" "a chandelier of jellyfish" "a train threading through clouds"
      "a mask carved from driftwood" "a robot tending a bonsai" "a comet with a trailing city"
      "a mushroom village at night" "a heron standing in a server pond" "a kite festival over ruins"
      "a vending machine shrine" "a spider-mech in a rice paddy" "a lantern parade of drones"
      "a snail carrying a satellite dish" "a fox curled around a glowing orb" "a windmill of turbines and prayer flags"
      "a diver's helmet full of fireflies" "a piano overgrown with vines" "a hot-air balloon of patchwork screens"
      "a shrine gate in a data-forest" "a manta ray gliding over a city grid" "a campfire of blue flame and cables")
    LENS=("as an ancient mythological scene" "as a tiny handmade diorama" "as a sweeping epic landscape"
      "as a single hero object floating in void" "as a swarm or repeating pattern" "as a strange living creature"
      "as an architectural cutaway" "as a still life" "as a top-down map" "as an intimate portrait"
      "as a purely abstract composition" "as a half-remembered dream" "as nature reclaiming technology"
      "as a cosmic event" "as a cozy interior" "as candid street photography")
    MOD=("colossal" "tiny and intricate" "melting" "blooming with fungus" "fractal" "ancient and weathered"
      "iridescent" "half-submerged" "winged" "made of stained glass" "overgrown" "shattered and floating"
      "bioluminescent" "folded like origami" "windswept" "mirrored" "sprouting crystals")
    refill_prompts() {
      prompts=(); pmeta=()          # pmeta[i] = "motif<US>mined_from" — provenance per prompt
      # Mine fresh organic motifs from your world each wall (fast, no model).
      # --trace carries "motif<TAB>which note/wikilink it came from" for the wall trace.
      MOTIF=(); MOTIF_SRC=()
      while IFS=$'\t' read -r _m _s; do
        [ -n "$_m" ] && { MOTIF+=("$_m"); MOTIF_SRC+=("${_s:-your Obsidian vault}"); }
      done < <(muse-ingredients --trace 2>/dev/null)
      if [ "${#MOTIF[@]}" -lt 6 ]; then
        MOTIF=("${MOTIF_FALLBACK[@]}"); MOTIF_SRC=()
        for _f in "${MOTIF_FALLBACK[@]}"; do MOTIF_SRC+=("built-in fallback motif"); done
      fi
      # Opt-in: MUSE_VLM=1 lets the vision model read your screen (slower, evicts cache).
      if [ -n "${MUSE_VLM:-}" ] && _vlm_ready && command -v screencapture >/dev/null 2>&1 \
         && screencapture -x -t png -D 1 /tmp/muse-vlm.png 2>/dev/null && [ -s /tmp/muse-vlm.png ]; then
        sips -Z 1280 /tmp/muse-vlm.png --out /tmp/muse-vlm-sm.png >/dev/null 2>&1
        echo "  ◇ vision model reading your screen…"
        rssh "taskkill /im llama-server.exe /f >nul 2>&1" || true; sleep 1
        rssh "schtasks /run /tn vlm-server >nul" 2>/dev/null || true
        _wait_8085 && while IFS= read -r _l; do [ -n "$_l" ] && { prompts+=("$_l"); pmeta+=($'\x1f'"vision model read your screen"); }; done < <(muse-vision "$bn" /tmp/muse-vlm-sm.png "$h" 2>/dev/null)
        rssh "taskkill /im llama-server.exe /f >nul 2>&1" || true
        [ "${#prompts[@]}" -gt 0 ] && batch_source="vision-model read your screen"
      fi
      # Default: the LLM INTERPRETS your project READMEs + notes into imagery (once
      # per wall — one model load, ~1 slow cell, the rest fast). MUSE_NO_LLM=1 skips.
      if [ "${#prompts[@]}" -eq 0 ] && [ -z "${MUSE_NO_LLM:-}" ]; then
        echo "  ◇ LLM interpreting your project READMEs + notes…"
        "$0" llm on >/dev/null 2>&1 || true
        if _wait_8085; then
          while IFS= read -r _l; do [ -n "$_l" ] && { prompts+=("$_l"); pmeta+=($'\x1f'"LLM read your recent notes + project READMEs"); }; done < <(muse-brainstorm "$bn" "$h" 2>/dev/null)
          [ "${#prompts[@]}" -gt 0 ] && batch_source="LLM interpreted your project READMEs + notes"
        fi
        "$0" llm off >/dev/null 2>&1 || true
      fi
      # Instant fallback / top-up with your mined motifs (never let the wall stall).
      if [ "${#prompts[@]}" -lt "$bn" ]; then
        while [ "${#prompts[@]}" -lt "$bn" ]; do
          _mi=$((RANDOM % ${#MOTIF[@]}))
          prompts+=("${MOTIF[$_mi]}, ${MOD[$((RANDOM % ${#MOD[@]}))]}, ${LENS[$((RANDOM % ${#LENS[@]}))]}")
          pmeta+=("${MOTIF[$_mi]}"$'\x1f'"${MOTIF_SRC[$_mi]}")
        done
        [ "$batch_source" = "(pending first batch)" ] && batch_source="local remix (your motifs)"
      fi
      pidx=0
    }

    n=0; slot=0; batch_source="(pending first batch)"; last_game=0; gcyc=0
    while true; do
      n=$((n + 1)); slot=$(( (slot % total) + 1 ))
      # Quiet hours: don't keep a bright monitor on overnight (the 2am-incident
      # rule). Pause 22:00–09:00 so the display sleeps. MUSE_ALLNIGHT=1 overrides.
      hh=$(date +%H)
      if [ -z "${MUSE_ALLNIGHT:-}" ] && { [ "$hh" -ge 22 ] || [ "$hh" -lt 9 ]; }; then
        sleep 300; slot=$((slot - 1)); [ "$slot" -lt 0 ] && slot=0; continue
      fi
      # ── game guard FIRST (any game, with hysteresis) ────────────────────────
      # Pause while a game runs. A momentary GPU dip (lobby / menu / loading /
      # death screen) must NOT resume us mid-session — that pounced last time and
      # kicked off a render that lagged the game. So once we see game-level load we
      # HOLD the pause for a cooldown after the LAST high reading. Anti-cheat procs
      # (EasyAntiCheat/BattlEye) also flag a game even when the GPU idles in a menu,
      # covering any game, not just Fortnite. Runs BEFORE the keep-awake SHIFT tap
      # so we never inject a keystroke into live gameplay.
      busy=$(rssh "powershell -NoProfile -Command \"[int]((((Get-Counter '\GPU Engine(*engtype_3D)\Utilization Percentage' -ErrorAction SilentlyContinue).CounterSamples | Measure-Object CookedValue -Sum).Sum))\"" 2>/dev/null | tr -d '\r' || echo 0)
      ac=$(rssh "powershell -NoProfile -Command \"(Get-Process -EA 0 | Where-Object { \$_.Name -match 'EasyAntiCheat|BattlEye|BEService|FortniteClient' } | Measure-Object).Count\"" 2>/dev/null | tr -d '\r' || echo 0)
      now=$(date +%s)
      if [ "${busy:-0}" -gt "${MUSE_GAME_THRESHOLD:-50}" ] || [ "${ac:-0}" -gt 0 ]; then last_game=$now; fi
      cool=${MUSE_GAME_COOLDOWN:-300}
      if [ "${last_game:-0}" -gt 0 ] && [ $((now - last_game)) -lt "$cool" ]; then
        gcyc=$((gcyc + 1))
        # seed future gens: grab a game frame ~every 90s (hidden VBS, non-intrusive)
        [ $((gcyc % 3)) -eq 0 ] && rssh "schtasks /run /tn gameframe-grab" >/dev/null 2>&1
        echo "  gaming (3D ${busy}% ac=${ac}) — paused, $((cool-(now-last_game)))s cooldown left"
        sleep 30; slot=$((slot-1)); [ "$slot" -lt 0 ] && slot=0; continue
      fi
      # Keep the monitor awake while generating (only reached when NOT gaming — a
      # game keeps its own display awake, and we must never inject SHIFT mid-match).
      # Windows' display timeout keys off keyboard/mouse idle, NOT GPU load. A SHIFT
      # tap counts as input with no side effects (no character, no cursor move).
      rssh "powershell -NoProfile -Command \"Add-Type 'using System;using System.Runtime.InteropServices;public class K{[DllImport(\\\"user32.dll\\\")]public static extern void keybd_event(byte k,byte s,uint f,IntPtr e);}'; [K]::keybd_event(0x10,0,0,[IntPtr]::Zero); [K]::keybd_event(0x10,0,2,[IntPtr]::Zero)\"" >/dev/null 2>&1 || true

      # refill the batch (fresh notes) whenever we've used them all
      [ "$pidx" -ge "${#prompts[@]}" ] && refill_prompts
      prompt="${prompts[$pidx]}"; _meta="${pmeta[$pidx]:-}"; pidx=$((pidx + 1))
      prompt_origin="$batch_source"   # for the trace: where this prompt came from
      source_motif="${_meta%%$'\x1f'*}"; source_mined="${_meta#*$'\x1f'}"
      [ "$source_mined" = "$_meta" ] && source_mined=""   # no delimiter = nothing to attribute
      cellseed=$(( (RANDOM << 15) | RANDOM ))   # record-able seed (imagine honors IMAGINE_SEED)
      export IMAGINE_SEED=$cellseed

      export IMAGINE_WALL_SLOT=$slot
      unset IMAGINE_INIT_LOCAL IMAGINE_STRENGTH

      # ─────────────── VARIATION ENGINE (randomize everything per cell) ───────
      # Controls, dialed light → heavy at random each cell:
      SIZES=(512x512 576x576 640x640 768x768 768x1024 1024x768)  # 896x896/1024x1024 removed: OOM the 16GB card at load-end w/ FLUX-9B (esp. w/ display windows eating VRAM)
      size=${SIZES[$((RANDOM % ${#SIZES[@]}))]}
      steps=$((RANDOM % 21 + 20))                                         # 20 light → 40 heavy (higher floor = visible per-step diffusion, not noise→snap)
      strength=$(awk -v r=$((RANDOM % 45)) 'BEGIN{printf "0.%02d", 38 + r}')  # 0.38 → 0.82
      # ~1 in 6 cells escapes the mid-band to an extreme: a near-trace of the seed
      # (subtle, recognizable) or a near-hallucination (seed as a faint ghost).
      case $((RANDOM % 6)) in
        0) strength=$(awk -v r=$((RANDOM % 15)) 'BEGIN{printf "0.%02d", 18 + r}');;  # 0.18–0.32 subtle
        1) strength=$(awk -v r=$((RANDOM % 13)) 'BEGIN{printf "0.%02d", 84 + r}');;  # 0.84–0.96 wild
      esac

      # ── SAMPLER varies freely (safe, real visual diversity — these are the
      #    stable-diffusion.cpp tokens the server's -p path already accepts). cfg
      #    stays 1.0 on distilled FLUX-klein by default (guidance is baked in;
      #    pushing cfg smears it). MUSE_CFG_VARY=1 opts into 1.0–1.99 jitter to
      #    TEST — watch a few cells before trusting it.
      SAMPLERS=(euler euler_a heun dpm++2m dpm++2s_a ipndm)
      export IMAGINE_SAMPLER="${SAMPLERS[$((RANDOM % ${#SAMPLERS[@]}))]}"
      if [ -n "${MUSE_CFG_VARY:-}" ]; then
        export IMAGINE_CFG="$(awk -v r=$((RANDOM % 100)) 'BEGIN{printf "%.1f", 1.0 + r/100.0}')"
      else
        unset IMAGINE_CFG
      fi

      # ── STYLE for this cell: rotate the pool, or go bare (styleless).
      if [ $((RANDOM % 100)) -lt "$STYLELESS_PCT" ]; then
        cell_style=""
      else
        cell_style="${STYLES[$((RANDOM % ${#STYLES[@]}))]}"
      fi

      # ── BREVITY ROLL: most cells keep the descriptive subject, but a chunk go
      #    terse for texture. Bare cells + styleless above = genuinely short "a red
      #    fox" prompts. Works on ANY source (LLM/vision/motif) by trimming words.
      brev=$((RANDOM % 100)); bare_pct="${MUSE_BARE_PCT:-18}"; short_pct="${MUSE_SHORT_PCT:-17}"
      if [ "$brev" -lt "$bare_pct" ]; then
        # one strong noun-phrase: the mined motif if we have one, else first 2 words
        if [ -n "$source_motif" ]; then subject="$source_motif"
        else subject="$(printf '%s' "$prompt" | awk '{print $1, $2}')"; fi
      elif [ "$brev" -lt $((bare_pct + short_pct)) ]; then
        subject="$(printf '%s' "$prompt" | awk '{for(i=1;i<=5&&i<=NF;i++)printf "%s%s",$i,(i<5&&i<NF?" ":"")}')"
      else
        subject="$prompt"
      fi

      # Init source per cell. SCREENSHOT-BIASED (MUSE_SCREEN_PCT, default 45): a live
      # full-screen grab seeds ~45%, a random crop of the screen +13% ⇒ ~58% of cells
      # are based on what's on your screen right now. Remainder: arena / a past cell
      # (feedback) / a Cloudinary or Fuji photo / a real game frame / pure text.
      scr=${MUSE_SCREEN_PCT:-45}; crp=$((scr+13)); arn=$((crp+13)); fbk=$((arn+11)); cld=$((fbk+6)); gam=$((cld+10))
      src="pure"; fb=""; roll=$((RANDOM % 100)); rm -f /tmp/muse-init.png   # fb reset so it can't leak into the trace
      if [ "$roll" -lt "$scr" ] && command -v screencapture >/dev/null 2>&1; then
        screencapture -x -t png -D 1 /tmp/muse-init.png 2>/dev/null && [ -s /tmp/muse-init.png ] && src="screen"
      elif [ "$roll" -lt "$crp" ] && command -v screencapture >/dev/null 2>&1; then
        # random rectangular CROP of the desktop (points; screencapture clamps)
        b=$(osascript -e 'tell application "Finder" to get bounds of window of desktop' 2>/dev/null | tr -d ' ' | tr ',' ' ')
        sw=$(echo $b | awk '{print $3}'); sh=$(echo $b | awk '{print $4}'); sw=${sw:-2560}; sh=${sh:-1440}
        cw=$(( RANDOM % (sw/2) + sw/5 )); ch=$(( RANDOM % (sh/2) + sh/5 ))
        cx=$(( RANDOM % (sw - cw) )); cy=$(( RANDOM % (sh - ch) ))
        screencapture -x -t png -R${cx},${cy},${cw},${ch} /tmp/muse-init.png 2>/dev/null && [ -s /tmp/muse-init.png ] && src="crop"
      elif [ "$roll" -lt "$arn" ]; then
        au=$(muse-arena 2>/dev/null || true)                             # curated visual inspo from are.na
        [ -n "$au" ] && curl -s -m 20 -o /tmp/muse-init.png "$au" 2>/dev/null && [ -s /tmp/muse-init.png ] && src="arena"
      elif [ "$roll" -lt "$fbk" ]; then
        fb=$((RANDOM % total + 1))                                        # feedback: evolve a past cell
        scp -q "$REMOTE_USER@$h:farm/sd/wall_$fb.png" /tmp/muse-init.png 2>/dev/null && [ -s /tmp/muse-init.png ] && src="feedback"
      elif [ "$roll" -lt "$cld" ]; then
        # ~half the Cloudinary rolls pull a FUJIFILM shot (DSCF*) specifically
        cu=""; lbl="cloud"
        if [ $((RANDOM % 2)) -eq 0 ]; then cu=$(MUSE_FUJI=1 muse-cloudinary 2>/dev/null || true); [ -n "$cu" ] && lbl="fuji"; fi
        [ -z "$cu" ] && cu=$(muse-cloudinary 2>/dev/null || true)
        [ -n "$cu" ] && curl -s -m 20 -o /tmp/muse-init.png "$cu" 2>/dev/null && [ -s /tmp/muse-init.png ] && src="$lbl"
      elif [ "$roll" -lt "$gam" ]; then
        # a real frame from your last gaming session, reinterpreted into vulpes style
        # (per-cell strength gives the subtle→heavy mix). Empty pool → falls to pure.
        gf=$(rssh "powershell -NoProfile -Command \"(Get-ChildItem \$env:USERPROFILE\farm\sd\gameframes\*.jpg -EA 0 | Get-Random).Name\"" 2>/dev/null | tr -d '\r')
        [ -n "$gf" ] && scp -q "$REMOTE_USER@$h:farm/sd/gameframes/$gf" /tmp/muse-init.png 2>/dev/null && [ -s /tmp/muse-init.png ] && src="game"
      fi

      # ── INIT TRANSFORM POOL: perturb whatever seed we grabbed (ANY source) so
      #    img2img reinterprets rather than traces it. ~⅓ pass through untouched;
      #    the rest get one random magick op. Replaces the old per-source negate.
      #    The op name is appended to src ("feedback+swirl") so the trace records it.
      if [ "$src" != "pure" ] && [ -s /tmp/muse-init.png ] && command -v magick >/dev/null 2>&1; then
        fx=""
        case $((RANDOM % 12)) in
          0) magick /tmp/muse-init.png -negate /tmp/muse-init.png 2>/dev/null && fx="negate";;
          1) magick /tmp/muse-init.png -modulate 100,140,$((RANDOM%200+1)) /tmp/muse-init.png 2>/dev/null && fx="hue";;
          2) magick /tmp/muse-init.png -posterize $((RANDOM%4+2)) /tmp/muse-init.png 2>/dev/null && fx="posterize";;
          3) magick /tmp/muse-init.png -flop /tmp/muse-init.png 2>/dev/null && fx="mirror";;
          4) magick /tmp/muse-init.png -edge 1 -negate /tmp/muse-init.png 2>/dev/null && fx="edge";;
          5) magick /tmp/muse-init.png -blur 0x$((RANDOM%6+2)) /tmp/muse-init.png 2>/dev/null && fx="blur";;
          6) magick /tmp/muse-init.png -rotate $((RANDOM%40-20)) /tmp/muse-init.png 2>/dev/null && fx="rotate";;
          7) magick /tmp/muse-init.png -swirl $((RANDOM%120-60)) /tmp/muse-init.png 2>/dev/null && fx="swirl";;
          *) : ;;  # ~⅓ untouched
        esac
        [ -n "$fx" ] && src="$src+$fx"
      fi

      tag=""
      if [ "$src" != "pure" ] && [ -s /tmp/muse-init.png ]; then
        # sd-server gets the init straight from this local file (base64) — no scp.
        if sips -Z 640 /tmp/muse-init.png --out /tmp/muse-init-sm.png >/dev/null 2>&1 && [ -s /tmp/muse-init-sm.png ]; then
          export IMAGINE_INIT_LOCAL=/tmp/muse-init-sm.png; export IMAGINE_STRENGTH="$strength"
          tag=" s=$strength"
        else src="pure"; fi
      fi

      # subject was set by the brevity roll; style is per-cell (may be empty → bare).
      if [ -n "$cell_style" ]; then full="$subject, $cell_style"; else full="$subject"; fi
      echo "── #$n cell $slot/$total [$src ${size} ${steps}st$tag ${IMAGINE_SAMPLER} seed=$cellseed]: ${subject:0:55}"
      rssh "echo $slot > $FARM\sd\live-slot.txt" >/dev/null 2>&1 || true
      mkdir -p /tmp/muse && cd /tmp/muse
      STEPS="$steps" "$0" imagine "$full" "$size" >/dev/null 2>&1 || echo "  (render hiccup)"
      id="$(date +%Y%m%d-%H%M%S)-c${slot}"
      # Save the SEED IMAGE (exactly what fed this cell — the screenshot/photo/past-cell)
      # next to the cell + in the gallery, so the wall can show you what it was based on.
      # Pure text2img cells clear any stale seed image left at this slot.
      inited=""
      if [ "$src" != "pure" ] && [ -s /tmp/muse-init-sm.png ]; then
        scp -q /tmp/muse-init-sm.png "$REMOTE_USER@$h:farm/sd/wall_$slot-init.png" 2>/dev/null && inited=1
        scp -q /tmp/muse-init-sm.png "$REMOTE_USER@$h:renders/muse-gallery/muse-$id-init.png" 2>/dev/null || true
      else
        rssh "del $FARM\sd\wall_$slot-init.png" >/dev/null 2>&1 || true
      fi
      # ── TRACE: every choice that made this image → JSON sidecar in the gallery,
      #    named to match the archived PNG. Browse the gallery, each .png has a .json.
      TR_N="$n" TR_SLOT="$slot" TR_SRC="$src" TR_FB="${fb:-}" TR_SIZE="$size" \
      TR_STEPS="$steps" TR_STR="${IMAGINE_STRENGTH:-none}" TR_SUBJ="$subject" TR_FULL="$full" \
      TR_PSRC="$prompt_origin" TR_BATCH="$batch_source" TR_ID="$id" \
      TR_SEED="$cellseed" TR_MOTIF="$source_motif" TR_MINED="$source_mined" TR_INIT="$inited" \
      TR_STYLE="$cell_style" TR_SAMPLER="${IMAGINE_SAMPLER:-euler}" TR_CFG="${IMAGINE_CFG:-1.0}" \
      python3 - > /tmp/muse-trace.json 2>/dev/null <<'PYT'
import json, os, datetime
g=lambda k: os.environ.get(k,"")
rec={"id":g("TR_ID"),"ts":datetime.datetime.now().isoformat(timespec="seconds"),
 "cell":int(g("TR_SLOT")),"run_render":int(g("TR_N")),
 "init_source":g("TR_SRC"),"feedback_from_cell":g("TR_FB") or None,
 "seed_image":bool(g("TR_INIT")),
 "size":g("TR_SIZE"),"steps":int(g("TR_STEPS")),"img2img_strength":g("TR_STR"),
 "style":g("TR_STYLE") or None,"sampler":g("TR_SAMPLER"),"cfg":g("TR_CFG"),
 "seed":int(g("TR_SEED")) if g("TR_SEED") else None,
 "prompt_subject":g("TR_SUBJ"),"prompt_full":g("TR_FULL"),
 "prompt_from":g("TR_PSRC"),"batch_source":g("TR_BATCH"),
 "source_motif":g("TR_MOTIF") or None,"mined_from":g("TR_MINED") or None}
print(json.dumps(rec,indent=2))
PYT
      rssh "copy /y $FARM\imagine.png C:\Users\\$REMOTE_USER\renders\muse-gallery\muse-$id.png" >/dev/null 2>&1 || true
      scp -q /tmp/muse-trace.json "$REMOTE_USER@$h:renders/muse-gallery/muse-$id.json" 2>/dev/null || true
      # also drop the trace next to the live wall cell so the wall can pop it up on click
      scp -q /tmp/muse-trace.json "$REMOTE_USER@$h:farm/sd/wall_$slot.json" 2>/dev/null || true
      rm -f /tmp/muse/imagine-*.png
      sleep "$gap"
    done
    ;;

  rgb)
    # PC case + DualSense RGB via OpenRGB. Effects (wave/breathe/pulse) or screen-sync.
    SYNC="$HOME/.dotfiles/hue-stream/pc-rgb-sync.py"
    EFFECT="$HOME/.dotfiles/hue-stream/pc-rgb-effect.py"
    VENV="$HOME/.local/share/rgb-venv/bin/python"
    NODE_DIR="$HOME/.dotfiles/hue-stream/node"
    _stop_all() { pkill -f pc-rgb-sync.py 2>/dev/null || true; pkill -f pc-rgb-effect.py 2>/dev/null || true; sleep 1; }
    _hue_daemon_pid() { pgrep -f "hue-stream.js daemon" 2>/dev/null | head -1; }
    # NOTE (2026-09-10): NO auto-start of the Hue daemon here anymore. A
    # standing daemon holds the DTLS entertainment session, which silently
    # blocks the bridge's own scenes (EJ's sun-synced wake-up got replaced
    # by the wave overnight). Desk-mirror is now opt-in: `computah rgb hue`
    # starts it, `computah rgb off` (or trigger quit) stops it. Event
    # flashes don't need it — rgb-flash opens one-shot sessions on demand.
    _hue_up() {
      if [ -z "$(_hue_daemon_pid)" ]; then
        (cd "$NODE_DIR" && nohup node hue-stream.js daemon screen >/tmp/hue-stream.log 2>&1 &)
        echo "hue: daemon up (screen ambient) — desk lights mirror the PC until 'computah rgb off'"
      else
        (cd "$NODE_DIR" && node hue-stream.js trigger ambient screen >/dev/null 2>&1)
        echo "hue: daemon already up — switched to screen ambient (synced)"
      fi
    }
    # Only quit the daemon if the iMac screensync sampler doesn't need it.
    _hue_down() {
      [ -n "$(pgrep -f screen-sync.py)" ] && return 0
      if [ -n "$(_hue_daemon_pid)" ]; then
        (cd "$NODE_DIR" && node hue-stream.js trigger quit >/dev/null 2>&1)
        echo "hue: daemon quit — desk lights back to normal control"
      fi
    }
    case "${2:-on}" in
      on|wave|breathe|pulse)
        eff="${2:-wave}"; [ "$eff" = "on" ] && eff=wave
        _stop_all
        rm -f "$HOME/.config/pc-rgb-off"
        nohup "$VENV" "$EFFECT" "$eff" >/tmp/pc-rgb-effect.log 2>&1 &
        echo "pc rgb: $eff effect on (pid $!) — vulpes pink↔teal (PC only; 'computah rgb hue' to mirror on desk)"
        ;;
      hue)
        # opt-in desk mirror: Hue lights render whatever the PC effect waves
        _hue_up
        ;;
      screen)
        _stop_all
        rm -f "$HOME/.config/pc-rgb-off"
        nohup "$VENV" "$SYNC" >/tmp/pc-rgb-sync.log 2>&1 &
        echo "pc rgb: screen-sync on (pid $!) — case follows the iMac screen"
        ;;
      off)
        _stop_all
        # true blackout: stop any effect/sampler, then set every LED to black
        "$VENV" - <<'PYEOF'
from openrgb import OpenRGBClient
from openrgb.utils import RGBColor
import time
try:
    c = OpenRGBClient('10.0.0.169', 6742, 'imacpro-off'); time.sleep(0.8)
    for d in c.devices:
        try: d.set_mode('Direct')
        except: pass
        time.sleep(0.15)
        try: d.set_color(RGBColor(0,0,0))
        except: pass
    c.disconnect()
except Exception as e:
    print('blackout skipped (OpenRGB unreachable):', e)
PYEOF
        # rgb-flash honors this: no event flashes on the PC while lights are off
        touch "$HOME/.config/pc-rgb-off"
        echo "pc rgb off — effects stopped, all LEDs black (event flashes muted on PC)"
        _hue_down
        ;;
      status)
        if pgrep -f pc-rgb-effect.py >/dev/null; then echo "pc rgb: effect running";
        elif pgrep -f pc-rgb-sync.py >/dev/null; then echo "pc rgb: screen-sync running";
        else echo "pc rgb: off"; fi
        [ -f "$HOME/.config/pc-rgb-off" ] && echo "pc rgb: event flashes muted (~/.config/pc-rgb-off)"
        [ -n "$(_hue_daemon_pid)" ] && echo "hue: daemon running (desk lights streaming)" || echo "hue: daemon off"
        ;;
    esac
    ;;

  stream)
    # Full desktop (or pass an app name: computah stream "Steam Big Picture")
    nohup /Applications/Moonlight.app/Contents/MacOS/Moonlight stream "$(host)" "${2:-Desktop}" >/dev/null 2>&1 &
    echo "streaming ${2:-Desktop} — quit Moonlight to disconnect"
    ;;

  run)
    shift
    rssh "$@"
    ;;

  gallery)
    # pop the render archive folder in Explorer on the PC
    rssh "schtasks /run /tn open-gallery" >/dev/null 2>&1 && echo "opened muse-gallery on the PC" || echo "couldn't reach the PC"
    ;;

  favorites|favs)
    # pop the curated favorites folder in Explorer on the PC
    rssh "schtasks /run /tn open-favorites" >/dev/null 2>&1 && echo "opened favorites on the PC" || echo "couldn't reach the PC"
    ;;

  *)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
