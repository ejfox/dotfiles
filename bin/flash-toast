#!/usr/bin/env bash
# flash-toast <source> <event> [detail] — brief on-screen mirror of a light flash:
# a color-matched tmux status toast AND a silent macOS banner (the banner is the
# one that survives a fullscreen TUI painting over the status line). Colors,
# labels and emoji all come from the grammar (lib/flash-lib.sh), so this stays in
# lockstep with the lights. Deduped 1.5s; announces when the bulbs are offline.
set -u
SRC="${1:-?}"; EV="${2:-}"; DETAIL="${3:-}"
[ "$EV" = "rest" ] && exit 0                    # the resting state isn't a flash

. "$HOME/.dotfiles/lib/flash-lib.sh"

command -v tmux >/dev/null 2>&1 || exit 0
tmux list-clients >/dev/null 2>&1 || exit 0     # no server / nobody attached

DEDUPE_WINDOW_SEC=1.5   # collapse the rgb-flash+hue-stream double into one toast
TOAST_HOLD_MS=2500      # how long the status toast lingers (tmux >=3.2)

# Which tmux window triggered this flash. $TMUX_PANE rides the whole
# hook → desk-event → rgb-flash → flash-log → here chain, so it names the pane
# that fired. "external" if the flash came from outside tmux (cron etc.).
ORIGIN=""
if [ -n "${TMUX_PANE:-}" ]; then
  ORIGIN=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_index} #{window_name}' 2>/dev/null)
fi
[ -n "$ORIGIN" ] || ORIGIN="external"

# Dedupe: one physical flash often logs twice (rgb-flash then hue-stream).
STAMP="/tmp/flash-toast.last"
now=$(date +%s.%N 2>/dev/null || date +%s)
if [ -f "$STAMP" ]; then
  last=$(cat "$STAMP" 2>/dev/null || echo 0)
  awk "BEGIN{exit !($now - $last < $DEDUPE_WINDOW_SEC)}" 2>/dev/null && exit 0
fi
printf '%s' "$now" > "$STAMP"

# Did the bulbs even have a chance to fire? If the bridge is unreachable (VPN up /
# bridge moved or off), say so — an alert should never fail silently.
LIGHTS_NOTE=""
hue_bridge_reachable || LIGHTS_NOTE=" · 💡✕ lights offline (VPN?)"

# Presentation (color / label / emoji) from the grammar; fall back for unknowns.
C=$(grammar_color "$EV"); [ -n "$C" ] || C="colour213"
L=$(grammar_label "$EV"); [ -n "$L" ] || L="$EV"
EMOJI=$(grammar_emoji "$EV"); [ -n "$EMOJI" ] || EMOJI="⬤"

# tmux status toast — solid colored block (bg fill) so it's a vivid flash, not
# thin text that's easy to miss. Invisible under a fullscreen TUI; the banner
# below is the reliable channel there.
MSG="#[bg=${C},fg=black,bold]  ⬤ ${L}  #[default] #[fg=${C}]${ORIGIN} · ${SRC}${DETAIL:+ · ${DETAIL}}${LIGHTS_NOTE}#[default]"
for client in $(tmux list-clients -F '#{client_name}' 2>/dev/null); do
  tmux display-message -c "$client" -d "$TOAST_HOLD_MS" "$MSG" 2>/dev/null \
    || tmux display-message -c "$client" "$MSG" 2>/dev/null || true
done

# macOS banner — reaches you over a fullscreen TUI, silent, auto-dismisses,
# doesn't steal keyboard focus. Emoji dot carries the color.
if command -v osascript >/dev/null 2>&1; then
  safe_detail=$(printf '%s' "$DETAIL" | tr -d '"\\')
  safe_origin=$(printf '%s' "$ORIGIN" | tr -d '"\\')
  osascript -e "display notification \"flash · ${SRC}${safe_detail:+ · ${safe_detail}}${LIGHTS_NOTE}\" with title \"${EMOJI} ${L}\" subtitle \"${safe_origin}\"" >/dev/null 2>&1 || true
fi
