#!/usr/bin/env bash
# cheatsheets — open EJ's keybinding cheatsheet in various forms.
#
#   cheatsheets              master sheet in Safari (default)
#   cheatsheets app          borderless standalone window (Chrome/Brave --app mode)
#   cheatsheets panel        toggle the floating translucent Hammerspoon overlay (⌥Space ?)
#   cheatsheets nvim         nvim-only sheet in Safari
#   cheatsheets lazygit      lazygit-only sheet in Safari
#   cheatsheets gen          just regenerate the tips array (used by the HS panel)
#   cheatsheets -h|help      this help
#
# Every render regenerates cheatsheet-tips.js from docs/tips.txt so the rotating
# "tip of the moment" banner + the full auto-index are always current. A <script
# src> file is used instead of fetch() because Safari/WebKit block fetch() of
# local files under file://.

MASTER="$HOME/.dotfiles/.config/cheatsheet.html"
NVIM_SHEET="$HOME/.dotfiles/.config/nvim/cheatsheet.html"
LG_SHEET="$HOME/.dotfiles/.config/lazygit/cheatsheet.html"
TIPS_SRC="$HOME/.dotfiles/docs/tips.txt"
TIPS_JS="$HOME/.dotfiles/.config/cheatsheet-tips.js"

gen_tips() {
  [ -f "$TIPS_SRC" ] || return 0
  # skip blanks and section-marker lines ending in ↓↓↓
  python3 - "$TIPS_SRC" "$TIPS_JS" <<'PY' 2>/dev/null
import json, sys
src, out = sys.argv[1], sys.argv[2]
lines = [l.rstrip("\n") for l in open(src)
         if l.strip() and not l.rstrip().endswith("↓↓↓")]
open(out, "w").write("window.TIPS=" + json.dumps(lines, ensure_ascii=False) + ";\n")
PY
}

open_borderless() {
  local url="file://$MASTER"
  if [ -d "/Applications/Google Chrome.app" ]; then
    open -na "Google Chrome" --args --app="$url"
  elif [ -d "/Applications/Brave Browser.app" ]; then
    open -na "Brave Browser" --args --app="$url"
  else
    echo "No Chromium browser for --app mode; falling back to Safari." >&2
    open -a Safari "$MASTER"
  fi
}

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-all}" in
  -h|--help|help) usage ;;
  gen|--gen)      gen_tips ;;
  panel|float|hs) gen_tips
                  command -v hs >/dev/null && hs -c "cheatsheetToggle()" \
                    || echo "Hammerspoon CLI 'hs' not found — is Hammerspoon running?" >&2 ;;
  app|window)     gen_tips; open_borderless ;;
  nvim)           gen_tips; open -a Safari "$NVIM_SHEET" ;;
  lazygit)        gen_tips; open -a Safari "$LG_SHEET" ;;
  all|*)          gen_tips; open -a Safari "$MASTER" ;;
esac
