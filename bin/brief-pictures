#!/usr/local/bin/python3
"""brief-pictures — the morning picture DM: today's charts first, one art tile.

  brief-pictures           build the sheet + send it to EJ via Artie's DM API (once a day)
  brief-pictures --dry     build + open the sheet locally, send nothing
  brief-pictures --force   send even if today's already went out
  brief-pictures --force --river-only   resend just the river pictures (no desk sheet)

Charts: the latest chart-desk run for today (~/code/chart-desk/desks/<today>*/NN-*/chart.png),
headlines from each post.md blog-stub title. This is Fable's Bet 1 surfacing in Discord.
Art tile: a wall render from the last 24h — EJ's own ★ first, else the top pick of his
taste probe (CLIP probe trained on his reactions; ~/.cache/muse/probe.npz), never a ▽.
Full-size files land in ~/Pictures/Brief/<date>/ for posting. Delivery reuses the brief's
DM path: scp to vps:/home/debian/brief-pictures/<date>/, POST /api/dm with the token the brief uses.
Runs from LaunchAgent com.ejfox.brief-pictures at 08:02 (right after the 08:00 brief).
River section (2026-10-06): after the desk sheet, one DM per riverwatch picture (yesterday's AIS
light-trail map, ship cards for notable vessels, standout cam stills, a cam timelapse GIF), rendered
07:30 on the VPS into /data2/riverwatch-images/<date>/ with lookup codes rw/<date>/...; copies land in
~/Pictures/Brief/<date>/river/. BRIEF_NO_OPEN=1 with --dry skips opening the preview.
Default since 2026-10-08: ONE card DM (see "the card"); BRIEF_LEGACY=1 for the old sheet + river DMs.
Off switch: ~/.config/brief-pictures-disabled (everything) · ~/.config/brief-pictures-river-disabled (river only)
"""
import base64, datetime as dt, glob, json, os, re, shutil, subprocess, sys, urllib.request

HOME = os.path.expanduser("~")
DESKS = f"{HOME}/code/chart-desk/desks"
CACHE = f"{HOME}/.cache/muse"
OUTROOT = f"{HOME}/Pictures/Brief"
OWNER = "688448399879438340"
PC_HTTP = "http://10.0.0.169:7861"
FONT = "/System/Library/Fonts/Menlo.ttc"
BG, INK, MUTED, ACCENT = (11, 11, 13), (238, 238, 242), (140, 140, 152), (255, 77, 141)

SEND_SH = r'''#!/usr/bin/env bash
# brief-pictures sender, run ON the VPS: send.sh <dir> <discord-user-id> <date>
set -uo pipefail
cd "$1" || exit 1
# land UNDER the text brief (contract with the drip-brief session, 2026-10-02): its morning
# slot writes facts.json .last_dm_at.morning at DM time; until that ships, the archive file
# written just before its DM — but only if written THIS morning (a 01:00 test run already
# made today's file, so plain existence passed instantly). Wait up to 15 min, then send anyway.
F=/home/debian/briefs/facts.json; A="/home/debian/briefs/archive/$3-morning.md"
for _ in $(seq 90); do
  jq -e --arg d "$3" '(.last_dm_at.morning // "") | startswith($d)' "$F" >/dev/null 2>&1 && break
  [ -n "$(find "$A" -newermt "$3 07:30" 2>/dev/null)" ] && break
  sleep 10
done
tok=$(tr -d '\n' < /data2/smallweb/data/anomalywatch/data/.artie-dm-token)
dm() {  # dm <message-file> <discord-user-id> <attachment> <attachment-name> -> prints http code
  jq -n --arg u "$2" --rawfile m "$1" --rawfile b <(base64 -w0 "$3") --arg n "$4" \
    '{userId:$u, message:$m, fileBase64:$b, fileName:$n}' \
  | curl -s -m 60 -o /dev/null -w '%{http_code}' -X POST http://127.0.0.1:47321/api/dm \
      -H 'Content-Type: application/json' -H "Authorization: Bearer $tok" -d @-
}
# the desk sheet first (first word printed = its http code; the Mac stamps the day on a 2xx)
[ "${4:-}" != nodesk ] && [ -f sheet.jpg ] && dm message.txt "$2" sheet.jpg "desk-$3.jpg"
# then the river section (2026-10-06): one DM per picture, files rendered on this box by
# riverwatch/imagery/river_imagery.py. river.tsv = <abs path> TAB <caption file> TAB <name>
if [ -f river.tsv ]; then
  codes=""
  while IFS=$'\t' read -r f cap name; do
    [ -f "$f" ] || continue
    codes="$codes$(dm "$cap" "$2" "$f" "$name"),"
  done < river.tsv
  printf ' river:%s' "$codes"
fi
'''

today = dt.date.today().isoformat()
OUT = f"{OUTROOT}/{today}"
DRY, FORCE = "--dry" in sys.argv, "--force" in sys.argv
STAMP = f"{CACHE}/brief-pictures-sent-{today}"
PIN = f"{CACHE}/brief-pictures-run-{today}"
PREFETCH = f"{CACHE}/brief-art"


def pc_host():
    ok = subprocess.run(["nc", "-z", "-G", "2", "10.0.0.169", "22"], capture_output=True).returncode == 0
    return "ejfox@10.0.0.169" if ok else "computah"

def get_json(path):
    try:
        return json.load(urllib.request.urlopen(PC_HTTP + path, timeout=6))
    except Exception:
        return None

# ------------------------------------------------------------------ charts
def todays_charts(pinned=None):
    runs = sorted(d for d in glob.glob(f"{DESKS}/{today}*") if glob.glob(f"{d}/*/chart.png"))
    if pinned and f"{DESKS}/{pinned}" in runs:
        runs = [f"{DESKS}/{pinned}"]
    # prefer the newest FINISHED run (chart-desk writes index.html last); a run still
    # building has only some chart.pngs and would ship a partial desk
    done = [d for d in runs if os.path.exists(f"{d}/index.html")]
    runs = done or runs
    if not runs:
        return []
    # of those, the MOST complete run wins (newest on a tie): a later re-run can finish
    # with fewer charts (2026-10-02: the 00:40 re-run landed 1 of 3, the 06:30 run had 3)
    runs.sort(key=lambda d: (len(glob.glob(f"{d}/*/chart.png")), d))
    out = []
    for png in sorted(glob.glob(f"{runs[-1]}/*/chart.png")):
        folder = os.path.dirname(png)
        title = os.path.basename(folder).split("-", 1)[-1].replace("-", " ")
        try:
            m = re.search(r'^title:\s*"?(.+?)"?\s*$', open(f"{folder}/post.md").read(), re.M)
            if m:
                title = m.group(1)
        except OSError:
            pass
        out.append({"kind": "chart", "path": png, "title": title,
                    "code": f"{os.path.basename(runs[-1])}/{os.path.basename(folder)}"})
    return out

# ------------------------------------------------------------------ art tile
def ts_of(rid):
    m = re.match(r"(\d{8})-(\d{6})", rid)
    return dt.datetime.strptime(m.group(1) + m.group(2), "%Y%m%d%H%M%S") if m else None

def art_pick():
    favs = set((get_json("/favlist") or {}).get("ids", []))
    downs = set((get_json("/downlist") or {}).get("ids", []))
    cutoff = dt.datetime.now() - dt.timedelta(hours=24)
    fresh_favs = sorted((i for i in favs if (ts_of(i) or cutoff) > cutoff), reverse=True)
    if fresh_favs:
        return fresh_favs[0], "your ★"
    try:
        import numpy as np
        z = np.load(f"{CACHE}/render-embeds.npz"); p = np.load(f"{CACHE}/probe.npz")
    except Exception:
        return None, None
    ids = [str(i) for i in z["ids"]]
    keep = [k for k, i in enumerate(ids) if i not in downs and (ts_of(i) or cutoff) > cutoff]
    if not keep:
        return None, None
    scores = z["vecs"][keep].astype("float32") @ p["w"] + float(p["b"])
    return ids[keep[int(scores.argmax())]], "your taste model"

def fetch_render(rid, dest):
    src = f"{pc_host()}:C:/dev/computah/renders/muse-gallery/muse-{rid}.png"
    return subprocess.run(["scp", "-q", "-o", "ConnectTimeout=8", src, dest]).returncode == 0

def prefetch():
    """--prefetch: while the PC is AWAKE, fetch today's art pick to PREFETCH so the 08:02
    send has wall art even when the PC is asleep (it usually is). Run by blender-sync's
    15-min tick; re-downloads only when the pick changes. Silent, no DMs."""
    rid, why = art_pick()
    if not rid:
        return
    meta = f"{PREFETCH}/pick.json"
    try:
        if json.load(open(meta)).get("rid") == rid and os.path.exists(f"{PREFETCH}/pick.png"):
            return
    except (OSError, ValueError):
        pass
    os.makedirs(PREFETCH, exist_ok=True)
    if fetch_render(rid, f"{PREFETCH}/pick.png.part"):
        os.replace(f"{PREFETCH}/pick.png.part", f"{PREFETCH}/pick.png")
        json.dump({"rid": rid, "why": why, "subject": render_subject(rid),
                   "ts": dt.datetime.now().isoformat()}, open(meta, "w"))

def prefetched():
    """The last prefetched pick, if its render is from the last 24h."""
    try:
        m = json.load(open(f"{PREFETCH}/pick.json"))
    except (OSError, ValueError):
        return None
    t = ts_of(m.get("rid", ""))
    if not t or t < dt.datetime.now() - dt.timedelta(hours=24) or not os.path.exists(f"{PREFETCH}/pick.png"):
        return None
    return m

def studio_fallback():
    """Newest Blender studio masterpiece from the last 24h, already mirrored to the Mac by
    blender-sync — art for mornings when the PC is asleep at send time."""
    cutoff = dt.datetime.now().timestamp() - 86400
    pngs = [p for p in glob.glob(f"{HOME}/Pictures/Blender/masterpieces/*.png") if os.path.getmtime(p) > cutoff]
    if not pngs:
        return None, None
    p = max(pngs, key=os.path.getmtime)
    scene = re.sub(r"^\d{8}-\d{6}_", "", os.path.splitext(os.path.basename(p))[0]).replace("_", " ")
    return p, scene

def render_subject(rid):
    for r in (get_json("/taste/recent.json") or {}).get("renders", []):
        if r.get("id") == rid:
            return (r.get("style") or "").strip()
    return ""

# ------------------------------------------------------------------ river (riverwatch imagery)
RIVER_REMOTE = "/data2/riverwatch-images"   # rendered 07:30 on the VPS by riverwatch/imagery/river_imagery.py
RIVER_ORDER = {"map": 0, "valley": 1, "card": 2, "stills": 3, "timelapse": 4}

def river_section():
    """Today's river pictures (private: they only ever travel in this DM). Pulls the VPS render dir
    to ~/Pictures/Brief/<date>/river/ and returns one DM per picture, in order map, valley (only
    when it has enough tracks), ship cards, cam stills, timelapse. Off switch for just this section: ~/.config/brief-pictures-river-disabled"""
    if os.path.exists(f"{HOME}/.config/brief-pictures-river-disabled"):
        return []
    local = f"{OUT}/river"
    os.makedirs(local, exist_ok=True)
    got = subprocess.run(["scp", "-q", "-o", "ConnectTimeout=10", f"vps:{RIVER_REMOTE}/{today}/*", f"{local}/"],
                         capture_output=True).returncode == 0
    try:
        man = json.load(open(f"{local}/manifest.json")) if got else None
    except (OSError, ValueError):
        man = None
    if not man or man.get("date") != today:
        return []
    out = []
    for it in sorted(man.get("items", []), key=lambda i: RIVER_ORDER.get(i["kind"], 9)):
        path = f"{local}/{it['file']}"
        if not os.path.exists(path) or os.path.getsize(path) > 8_000_000:   # Discord bot upload cap ~10 MB
            continue
        msg = it["caption"]
        if it["kind"] == "stills":
            msg += "\n" + "\n".join(f"    `{s['code']}`" for s in it.get("stills", []))
        else:
            msg += f"\n    `{it['code']}`"
        if it["kind"] == "timelapse" and it.get("mp4"):
            msg += f"  (mp4: ~/Pictures/Brief/{today}/river/{it['mp4']})"
        ext = os.path.splitext(it["file"])[1]
        out.append({"file": it["file"], "local": path, "message": msg,
                    "send_name": f"rw-{today}-{it['code'].split('/')[-1]}{ext}"})
    return out


# ------------------------------------------------------------------ sheet
def sheet(tiles, path):
    from PIL import Image, ImageDraw, ImageFont
    W, PAD, TW = 1600, 24, (1600 - 3 * 24) // 2
    IH, CAP = 460, 64
    rows = (len(tiles) + 1) // 2
    H = 70 + rows * (IH + CAP + PAD) + PAD
    im = Image.new("RGB", (W, H), BG)
    d = ImageDraw.Draw(im)
    f_head, f_cap, f_num, f_code = (ImageFont.truetype(FONT, s) for s in (26, 21, 30, 16))
    d.text((PAD, 22), f"◆ THE DESK · {dt.date.today():%a %b %-d}", font=f_head, fill=ACCENT)
    for k, t in enumerate(tiles):
        x = PAD + (k % 2) * (TW + PAD); y = 70 + (k // 2) * (IH + CAP + PAD)
        src = Image.open(t["path"]).convert("RGB")
        src.thumbnail((TW, IH))
        im.paste(src, (x + (TW - src.width) // 2, y + (IH - src.height) // 2))
        # the number lives in the caption row, never over the chart (it covered chart headlines)
        label = f"{k + 1}" if t["kind"] == "chart" else "◇"
        d.text((x, y + IH + 4), label, font=f_num, fill=ACCENT if t["kind"] == "chart" else (22, 166, 182))
        cx = x + 34
        words, lines, line = t["title"].split(), [], ""
        for w in words:
            if d.textlength(line + " " + w, font=f_cap) > TW - 38:
                lines.append(line); line = w
            else:
                line = (line + " " + w).strip()
        lines.append(line)
        first = lines[0]
        if len(lines) > 1:   # trim words until the ellipsis fits inside the column
            while first and d.textlength(first + " …", font=f_cap) > TW - 38:
                first = first.rsplit(" ", 1)[0] if " " in first else first[:-1]
            first += " …"
        d.text((cx, y + IH + 8), first, font=f_cap, fill=INK if t["kind"] == "chart" else MUTED)
        d.text((cx, y + IH + 36), t["code"], font=f_code, fill=MUTED)   # lookup code
    im.save(path, "JPEG", quality=88)


# ------------------------------------------------------------------ the card (2026-10-08)
# EJ: "I hate getting 6 DMs, I like getting info, but it should be a really elegant morning
# briefing, not a wall of text." So the morning is ONE DM: a two-line message (bottom line +
# 10-minute action) and ONE phone-shaped card (1080x1350): date, headline, today's calendar,
# a hero picture (river map when there is one, else today's first chart) beside the art pick,
# and four numbers. The VPS brief still writes the full text to its archive; on this path it
# does not DM it (morning-brief.sh MORNING_CARD=1) and a VPS fallback at 08:20 sends the text
# if no card landed (iMac asleep). BRIEF_LEGACY=1 restores the old sheet + one-DM-per-picture.
CARD_FONTS = f"{HOME}/Library/Fonts"
ARCHIVE_REMOTE = "/home/debian/briefs/archive"

def fetch_brief(wait_s=900):
    """Today's morning archive from the VPS, waiting (up to 15 min) for this morning's write."""
    import time
    deadline = time.time() + wait_s
    while True:
        r = subprocess.run(["ssh", "-o", "ConnectTimeout=10", "vps",
                            f"f={ARCHIVE_REMOTE}/{today}-morning.md; [ -n \"$(find $f -newermt '{today} 07:30' 2>/dev/null)\" ] && cat $f"],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout
        if time.time() > deadline:
            return None
        time.sleep(10)

def parse_brief(text):
    b = {"headline": "", "action": "", "cal": [], "stats": []}
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("BOTTOM LINE:"):
            b["headline"] = s.split(":", 1)[1].strip()
        elif s.startswith("ACTION"):
            b["action"] = s.split(":", 1)[1].strip()
        elif s.startswith("•") and s.endswith("[cal]"):
            body = s[1:-5].strip()
            m = re.match(r"(\d{1,2}:\d{2}|All day)\s*:?\s*(.+)", body)
            if m:
                when, what = m.groups()
                what = re.sub(r"^Meeting:\s*", "", what)
                what = re.sub(r"\((\d+) attendees\)", r"· \1 people", what)
                what = re.sub(r"^you and ", "", what)
                b["cal"].append(("all day" if when == "All day" else when, what.strip()))
    st = []
    m = re.search(r"(\d+) completed yesterday", text); m and st.append((m.group(1), "done yesterday"))
    m = re.search(r"(\d+) unread", text);               m and st.append((m.group(1), "unread"))
    m = re.search(r"Aging ≥7d:(.*)\[things\]", text);   m and st.append((str(len(re.findall(r"\(\d+d\)", m.group(1)))), "aging ≥7d"))
    m = re.search(r"(\d+) kanban cards? blocked", text); m and st.append((m.group(1), "blocked cards"))
    b["stats"] = st[:4]
    return b

def river_hero():
    """(path, title, subtitle) for the river map, ignoring the river-DM off switch (that switch
    only stops the separate river DMs; the map belongs on the card)."""
    local = f"{OUT}/river"; os.makedirs(local, exist_ok=True)
    if subprocess.run(["scp", "-q", "-o", "ConnectTimeout=10", f"vps:{RIVER_REMOTE}/{today}/manifest.json",
                       f"{local}/"], capture_output=True).returncode != 0:
        return None
    try:
        man = json.load(open(f"{local}/manifest.json"))
    except (OSError, ValueError):
        return None
    if man.get("date") != today:
        return None
    it = next((i for i in man.get("items", []) if i["kind"] == "map"), None)
    if not it:
        return None
    path = f"{local}/{it['file']}"
    if subprocess.run(["scp", "-q", f"vps:{RIVER_REMOTE}/{today}/{it['file']}", path], capture_output=True).returncode:
        return None
    m = re.search(r"·\s*([A-Z0-9][A-Z0-9 &'.-]+)\s*\(([^)]*)\):\s*([^,]+)", it.get("caption", ""))
    if m:
        return path, m.group(1).strip(), m.group(3).strip()
    return path, "the river", "yesterday's traffic"

def render_card(b, hero, art, path):
    from PIL import Image, ImageDraw, ImageFont, ImageOps
    W, H, PAD = 1080, 1350, 64
    BGc, INKc, MUT, RULE = (0, 0, 0), (245, 245, 245), (140, 140, 140), (60, 60, 60)
    A = lambda s: ImageFont.truetype(f"{CARD_FONTS}/ArchivoBlack-Regular.ttf", s)
    M = lambda s, w="Regular": ImageFont.truetype(f"{CARD_FONTS}/IBMPlexMono-{w}.ttf", s)
    im = Image.new("RGB", (W, H), BGc); d = ImageDraw.Draw(im)
    def wrap(text, font, width):
        out, line = [], ""
        for w in text.split():
            t = (line + " " + w).strip()
            if d.textlength(t, font=font) <= width: line = t
            else: out.append(line); line = w
        return [l for l in out + [line] if l]
    y = PAD
    d.text((PAD, y), f"{dt.date.today():%a %b %-d}".upper(), font=A(64), fill=INKc)
    d.text((W - PAD, y + 30), "08:00 · morning", font=M(26), fill=MUT, anchor="ra"); y += 104
    size = 46                                   # auto-fit: at most 3 lines of headline
    while size > 30 and len(wrap(b["headline"], A(size), W - 2 * PAD)) > 3:
        size -= 2
    for ln in wrap(b["headline"], A(size), W - 2 * PAD)[:3]:
        d.text((PAD, y), ln, font=A(size), fill=INKc); y += int(size * 1.26)
    y += 22; d.line((PAD, y, W - PAD, y), fill=RULE, width=2); y += 30
    if b["cal"]:
        d.text((PAD, y), "TODAY", font=M(22, "Bold"), fill=MUT); y += 40
        for when, what in b["cal"][:5]:
            what = wrap(what, M(32, "Medium"), W - 2 * PAD - 150)[0]
            d.text((PAD, y), when, font=M(32, "Medium"), fill=MUT); d.text((PAD + 150, y), what, font=M(32, "Medium"), fill=INKc); y += 48
        y += 22; d.line((PAD, y, W - PAD, y), fill=RULE, width=2); y += 34
    panels = [p for p in (hero, art) if p]
    stats_h = 120 if b["stats"] else 0
    room = H - PAD - stats_h - y - 100
    if panels:
        pw = (W - 2 * PAD - 24) // 2 if len(panels) == 2 else W - 2 * PAD
        ph = min(pw, room)
        for k, (src, cap1, cap2) in enumerate(panels):
            x = PAD + k * (pw + 24)
            p = Image.open(src).convert("RGB")
            p = p.crop((0, int(p.height * 0.08), p.width, p.height))   # skip baked-in caption bands
            p = ImageOps.fit(p, (pw, ph), centering=(0.5, 0.45)); im.paste(p, (x, y))
            d.text((x, y + ph + 14), wrap(cap1, M(24, "Bold"), pw)[0], font=M(24, "Bold"), fill=INKc)
            d.text((x, y + ph + 46), wrap(cap2, M(22), pw)[0], font=M(22), fill=MUT)
        y += ph + 100
    if b["stats"]:
        d.line((PAD, y, W - PAD, y), fill=RULE, width=2); y += 30
        cw = (W - 2 * PAD) // len(b["stats"])
        for i, (n, l) in enumerate(b["stats"]):
            x = PAD + i * cw; d.text((x, y), n, font=A(52), fill=INKc); d.text((x, y + 66), l, font=M(20), fill=MUT)
    im.save(path, "JPEG", quality=90)

def card_main():
    """The one-DM morning card. Returns True when it handled the morning (sent, previewed, or
    deliberately skipped), False to fall through to the legacy path."""
    if os.environ.get("BRIEF_LEGACY"):
        return False
    os.makedirs(OUT, exist_ok=True)
    text = fetch_brief(wait_s=5 if DRY else 900)
    if not text:
        print("◇ no morning brief archive yet; VPS fallback (08:20) will send the text"); return True
    b = parse_brief(text)
    tiles = todays_charts(open(PIN).read().strip() if os.path.exists(PIN) else None)
    hero = river_hero()
    if not hero and tiles:
        t = tiles[0]; hero = (t["path"], "the desk", t["title"])
    rid, why = art_pick()
    art = None
    wall = f"{OUT}/art-wall-{rid}.png" if rid else None
    if rid and fetch_render(rid, wall):
        art = (wall, "from the wall", (render_subject(rid) or why or "")[:40] or "your pick")
    else:
        pf = prefetched()
        if pf:
            wall = f"{OUT}/art-wall-{pf['rid']}.png"; shutil.copy(f"{PREFETCH}/pick.png", wall)
            art = (wall, "from the wall", (pf.get("subject") or pf.get("why") or "your pick")[:40])
    card = f"{OUT}/sheet.jpg"          # send.sh ships sheet.jpg + message.txt as ONE DM
    render_card(b, hero, art, card)
    msg = f"**{b['headline']}**" + (f"\n→ 10 min: {b['action']}" if b["action"] else "")
    open(f"{OUT}/message.txt", "w").write(msg)
    open(f"{OUT}/river.tsv", "w").write("")   # no separate river DMs on the card path
    if DRY:
        print(msg)
        if not os.environ.get("BRIEF_NO_OPEN"):
            subprocess.run(["open", card])
        return True
    remote = f"/home/debian/brief-pictures/{today}"
    subprocess.run(["ssh", "-o", "ConnectTimeout=10", "vps", f"mkdir -p {remote}"], check=True)
    sender = f"{OUT}/send.sh"; open(sender, "w").write(SEND_SH)
    subprocess.run(["scp", "-q", card, f"{OUT}/message.txt", f"{OUT}/river.tsv", sender, f"vps:{remote}/"], check=True)
    out = subprocess.run(["ssh", "-o", "ConnectTimeout=10", "vps", "bash", f"{remote}/send.sh", remote, OWNER, today, "desk"],
                         capture_output=True, text=True).stdout.strip()
    code = out.partition("river:")[0].strip()
    if code.startswith("2"):
        open(STAMP, "w").write(dt.datetime.now().isoformat())
        subprocess.run(["ssh", "-o", "ConnectTimeout=10", "vps", f"touch {remote}/.card-sent"])
        print("◆ sent the morning card (1 DM)")
    else:
        print(f"◇ card DM failed (http {code or 'none'}); VPS fallback (08:20) will send the text"); sys.exit(1)
    return True


def main():
    if os.path.exists(f"{HOME}/.config/brief-pictures-disabled"):
        return
    if "--prefetch" in sys.argv:
        prefetch(); return
    if os.path.exists(STAMP) and not (FORCE or DRY):
        return
    # quiet hours (brief-session contract): never DM EJ 22:00–07:30, not even --force;
    # test with --dry. (2026-10-02: 00:57/00:59 test sends landed in his Discord.)
    now = dt.datetime.now().time()
    if not DRY and (now >= dt.time(22, 0) or now < dt.time(7, 30)):
        print("◇ quiet hours (22:00–07:30) — not sending; use --dry to preview"); return
    if "--river-only" not in sys.argv and card_main():
        return
    os.makedirs(OUT, exist_ok=True)
    # ONE chart set per day: the first real send pins its desk run in PIN; --force resends
    # that same set even if chart-desk re-runs later (three sets went out on 10-02)
    pinned = open(PIN).read().strip() if os.path.exists(PIN) else None
    tiles = todays_charts(pinned)
    # saved filenames carry the lookup code, so the folder is self-describing
    for k, t in enumerate(tiles):
        dest = f"{OUT}/{k + 1}-{t['code'].split('/')[-1]}.png"
        shutil.copy(t["path"], dest); t["path"] = dest
    rid, why = art_pick()
    wall = f"{OUT}/art-wall-{rid}.png" if rid else None
    ok, pf = bool(rid) and fetch_render(rid, wall), None
    if not ok:
        pf = prefetched()   # PC asleep → the pick fetched while it was awake
        if pf:
            rid, why, wall = pf["rid"], pf["why"], f"{OUT}/art-wall-{pf['rid']}.png"
            shutil.copy(f"{PREFETCH}/pick.png", wall); ok = True
    if ok:
        subj = pf["subject"] if pf else render_subject(rid)
        tiles.append({"kind": "art", "path": wall, "code": f"muse-{rid}",
                      "title": " · ".join(x for x in ("from the wall", subj, why) if x)})
    else:
        sp, scene = studio_fallback()
        if sp:
            dest = f"{OUT}/art-studio-{os.path.basename(sp)}"
            shutil.copy(sp, dest); rid = rid or "studio"
            tiles.append({"kind": "art", "path": dest, "code": os.path.splitext(os.path.basename(sp))[0],
                          "title": f"from the studio · {scene}"})
    if "--river-only" in sys.argv:
        tiles = []   # test/resend just the river section (send.sh gets "nodesk")
    river = river_section()
    if not tiles and not river:
        print("◇ nothing to show today (no charts yet, no art pick, no river pictures)"); return
    sheet_path = f"{OUT}/sheet.jpg"
    if tiles:
        sheet(tiles, sheet_path)

    charts = [t for t in tiles if t["kind"] == "chart"]
    lines = [f"◆ the desk · {len(charts)} chart{'s' if len(charts) != 1 else ''} ready" if charts
             else "◆ the desk · no charts yet today"]
    for k, t in enumerate(charts):
        lines += [f"{k + 1} · {t['title']}", f"    `{t['code']}`"]
    for t in tiles:
        if t["kind"] == "art":
            lines += [f"◇ {t['title']}", f"    `{t['code']}`"]
    lines.append(f"↳ full size on the iMac: ~/Pictures/Brief/{today}/ · pick in today's Things to-do")
    msg = "\n".join(lines)
    open(f"{OUT}/message.txt", "w").write(msg)
    # river.tsv drives the river DMs in send.sh (always rewritten, empty when there is no river today)
    with open(f"{OUT}/river.tsv", "w") as f:
        for k, r in enumerate(river):
            f.write(f"{RIVER_REMOTE}/{today}/{r['file']}\triver-{k + 1}.txt\t{r['send_name']}\n")   # caption: relative to the send dir

    if DRY:
        print(msg if tiles else "◇ (no desk sheet today)")
        for r in river:
            print(f"\n--- river DM: {r['local']}\n{r['message']}")
        if not os.environ.get("BRIEF_NO_OPEN"):
            subprocess.run(["open", sheet_path if tiles else f"{OUT}/river"])
        return
    # own dir, NOT under /home/debian/briefs/ (the brief session owns that tree)
    remote = f"/home/debian/brief-pictures/{today}"
    subprocess.run(["ssh", "-o", "ConnectTimeout=10", "vps", f"mkdir -p {remote}"], check=True)
    # ship a tiny sender script instead of nesting shell quotes over ssh (the outer shell
    # expanded $tok before the inner one set it → empty bearer → 401)
    sender = f"{OUT}/send.sh"
    open(sender, "w").write(SEND_SH)
    caps = []
    for k, r in enumerate(river):
        caps.append(f"{OUT}/river/river-{k + 1}.txt")
        open(caps[-1], "w").write(r["message"])
    up = ([sheet_path] if tiles else []) + [f"{OUT}/message.txt", f"{OUT}/river.tsv", sender] + caps
    subprocess.run(["scp", "-q", *up, f"vps:{remote}/"], check=True)
    out = subprocess.run(["ssh", "-o", "ConnectTimeout=10", "vps", "bash", f"{remote}/send.sh", remote, OWNER, today,
                          "desk" if tiles else "nodesk"], capture_output=True, text=True).stdout.strip()
    # "<desk http> river:<code>,<code>," ; with no desk sheet the river's first code decides the stamp
    code, _, rcodes = out.partition("river:")
    code = code.strip() or rcodes.split(",")[0]
    if rcodes:
        print(f"◇ river DMs: {rcodes.rstrip(',')}")
    if code.startswith("2"):
        open(STAMP, "w").write(dt.datetime.now().isoformat())
        if charts and not os.path.exists(PIN):
            open(PIN, "w").write(charts[0]["code"].split("/")[0])
        print(f"◆ sent ({len(charts)} charts{', + art' if rid else ''}{f', + {len(river)} river' if river else ''})")
    else:
        print(f"◇ DM failed (http {code or 'none'})"); sys.exit(1)


if __name__ == "__main__":
    main()
