#!/bin/bash
# studio: a Ghostty on a pure-green key, for recording terminal demos to composite later.
#   studio [open]     open STUDIO vertical 9:16 (Reels/Shorts/TikTok), centered on the portrait screen
#   studio wide       same window, 16:9, centered on the main screen (YouTube)
#   (sized to fit every connected screen, so it can be dragged anywhere without resizing)
#   studio rec [sec]  record the window itself (.mov), wherever you move it; optional time limit
#   studio stop       stop recording; prints the file
#   studio place      snap the window back to its rect
#   studio where      the rect + the recordings folder
# Run rec/stop from your MAIN terminal so the commands aren't in the shot.
set -euo pipefail

CONFIG="$HOME/.dotfiles/ghostty-studio/config"
RECORDER="$HOME/.cache/studio/studio-recorder"   # built on demand from the swift source below
RECORDER_SRC="$HOME/.dotfiles/ghostty-studio/studio-recorder.swift"
OUT="${STUDIO_OUT:-$HOME/Movies/studio}"
STATE="${TMPDIR:-/tmp}/studio-rec.pid"
RECT_FILE="$HOME/.cache/studio/rect"   # "x,y,w,h" of the current layout; hammerspoon/studio.lua locks to its w,h
mkdir -p "$(dirname "$RECT_FILE")"

studio_pid() { pgrep -f "ghostty.*--config-file=$CONFIG" | head -1; }

# The layout's rect in global points, computed from the live displays:
#   tall: 1080x1920 (9:16) on the portrait screen (else as big as fits on the main one)
#   wide: 1920x1080 (16:9) on the main screen
compute_rect() {
  hs -t 3 -c "
    local tall = '$1' == 'tall'
    local scr = hs.screen.primaryScreen()
    if tall then for _, s in ipairs(hs.screen.allScreens()) do
      local f = s:frame(); if f.h > f.w then scr = s end end end
    local f = scr:frame()
    local w, h = 1920, 1080
    if tall then w, h = 1080, 1920 end
    -- the largest size (ratio kept) that fits on EVERY screen, so dragging it to another
    -- monitor never resizes it (a resize would make the terminal reflow mid-take)
    local k = 1
    for _, s in ipairs(hs.screen.allScreens()) do
      local sf = s:frame(); k = math.min(k, sf.w / w, sf.h / h)
    end
    w, h = math.floor(w * k), math.floor(h * k)
    return string.format('%d,%d,%d,%d', f.x + (f.w - w) // 2, f.y + (f.h - h) // 2, w, h)
  " 2>/dev/null | tail -1
}

place() {
  local pid rect; pid="$(studio_pid)"; rect="$(cat "$RECT_FILE")"
  [ -n "$pid" ] || { echo "studio isn't open"; exit 1; }
  for _ in $(seq 1 25); do
    # set twice: moving between displays clamps the size to the screen it LEFT
    if hs -t 3 -c "local a=hs.application.applicationForPID($pid); local w=a and a:mainWindow();
                   if w then local r=hs.geometry.rect($rect); w:setFrame(r, 0); hs.timer.usleep(150000);
                   w:setFrame(r, 0); return 'ok' end" 2>/dev/null | grep -q ok; then
      return 0
    fi
    sleep 0.3
  done
  echo "couldn't place the window (Hammerspoon not answering?)"; exit 1
}

open_layout() {
  rect="$(compute_rect "$1")"
  [[ "$rect" =~ ^-?[0-9]+,-?[0-9]+,[0-9]+,[0-9]+$ ]] || { echo "couldn't read the displays (Hammerspoon?)"; exit 1; }
  echo "$rect" > "$RECT_FILE"
  if [ -z "$(studio_pid)" ]; then
    open -na Ghostty.app --args --config-default-files=false --config-file="$CONFIG"
    for _ in $(seq 1 30); do [ -n "$(studio_pid)" ] && break; sleep 0.2; done
  fi
  studio_pid > "$(dirname "$RECT_FILE")/pid"   # hammerspoon/studio.lua locks this pid's window
  place && echo "STUDIO $1 at $rect (x,y,w,h in points)"
}

case "${1:-open}" in
  open|tall) open_layout tall ;;
  wide) open_layout wide ;;
  place) place ;;
  rec)
    [ -f "$STATE" ] && kill -0 "$(cat "$STATE")" 2>/dev/null && { echo "already recording"; exit 1; }
    [ -n "$(studio_pid)" ] && [ -f "$RECT_FILE" ] || open_layout tall
    mkdir -p "$OUT"
    if [ ! -x "$RECORDER" ] || [ "$RECORDER_SRC" -nt "$RECORDER" ]; then
      echo "building studio-recorder..."; swiftc -O -o "$RECORDER" "$RECORDER_SRC" || exit 1
    fi
    file="$OUT/studio-$(date +%Y%m%d-%H%M%S).mov"
    # studio-recorder captures the WINDOW (ScreenCaptureKit), so it follows it when moved
    # and ignores anything on top of it; it finalizes the file on SIGINT
    "$RECORDER" "$(studio_pid)" "$file" ${2:-} < /dev/null > "$STATE.log" 2>&1 &
    echo $! > "$STATE"; echo "$file" > "$STATE.file"
    sleep 1.5
    kill -0 "$(cat "$STATE")" 2>/dev/null || { cat "$STATE.log"; rm -f "$STATE" "$STATE.file"; exit 1; }
    echo "$(head -1 "$STATE.log")   (studio stop)"
    ;;
  stop)
    [ -f "$STATE" ] || { echo "not recording"; exit 1; }
    pid="$(cat "$STATE")"
    kill -INT "$pid" 2>/dev/null || true
    for _ in $(seq 1 75); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
    file="$(cat "$STATE.file")"; rm -f "$STATE" "$STATE.file" "$STATE.log"
    [ -s "$file" ] && echo "saved $file ($(du -h "$file" | cut -f1))" || echo "no file written"
    ;;
  where) echo "rect $(cat "$RECT_FILE" 2>/dev/null || echo '(not open)')   recordings: $OUT" ;;
  *) sed -n 2,9p "$0" ;;
esac
