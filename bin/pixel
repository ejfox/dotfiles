#!/usr/bin/env bash
# pixel - draw to EJ's 320x240 pixel canvas (host auto-discovered, see `pixel find`)
#
# Usage:
#   pixel                    # pick a random scene and draw it
#   pixel <scene-name>       # run a specific scene
#   pixel list               # list available scenes
#   pixel clear              # clear the screen
#   pixel ping               # check if device is reachable (exit 0/1)
#   pixel raw <endpoint>     # raw GET request (e.g. `pixel raw "text?msg=hi&x=10&y=10"`)
#   pixel say "message"      # ad-hoc wrapped text on the glass
#   pixel find               # sweep the LAN for the device, cache its IP
#
# Silent + graceful if the device is offline. Safe to run from MOTD or launchd.

set -u

# Host resolution: env override > cached discovery > last-known default.
# `pixel find` re-discovers after a DHCP shuffle and updates the cache.
. "$HOME/.dotfiles/lib/pixel-host.sh"
HOST_CACHE="$PIXEL_HOST_CACHE"
DEVICE=$(pixel_host)
BASE="http://${DEVICE}"
SCENES_DIR="${PIXEL_SCENES_DIR:-$HOME/.dotfiles/bin/pixel-scenes}"

# Sweep the local /24 for a /info that identifies as pixelcanvas; cache the IP.
pixel_find() {
  local subnet
  subnet=$(ifconfig 2>/dev/null | awk '/inet /&&!/127.0.0.1/{print $2; exit}' | cut -d. -f1-3)
  [ -z "$subnet" ] && return 1
  local found=""
  for i in $(seq 1 254); do
    ( r=$(curl -s --connect-timeout 1 --max-time 2 "http://${subnet}.${i}/info" 2>/dev/null)
      case "$r" in *'"hostname":"pixelcanvas"'*) echo "${subnet}.${i}" >> /tmp/pixel-find.$$ ;; esac ) &
    [ $((i % 40)) -eq 0 ] && wait
  done
  wait
  found=$(head -1 /tmp/pixel-find.$$ 2>/dev/null); rm -f /tmp/pixel-find.$$
  [ -z "$found" ] && return 1
  mkdir -p "$(dirname "$HOST_CACHE")" && echo "$found" > "$HOST_CACHE"
  echo "$found"
}

# --- reachability check ---------------------------------------------------
# Fast: 1s connect timeout, 2s total. Anything else = device offline.
pixel_ping() {
  curl -s --connect-timeout 1 --max-time 2 -o /dev/null -w "%{http_code}" \
    "${BASE}/info" 2>/dev/null | grep -q "^200$"
}

# --- HTTP helpers (used by scene scripts via export) ---------------------
px() {
  # px <endpoint-with-querystring>  e.g. px "text?msg=hi&x=10&y=10&color=pink"
  curl -s --connect-timeout 1 --max-time 2 -o /dev/null "${PIXEL_BASE}/$1" 2>/dev/null || true
}

px_batch() {
  # px_batch '<json-array>'
  curl -s --connect-timeout 1 --max-time 2 -o /dev/null \
    -X POST "${PIXEL_BASE}/batch" -H "Content-Type: application/json" \
    --data "$1" 2>/dev/null || true
}

export -f px px_batch
export PIXEL_BASE="${BASE}"

# --- subcommands ----------------------------------------------------------
cmd="${1:-random}"

case "$cmd" in
  ping)
    pixel_ping && exit 0 || exit 1
    ;;
  find)
    # re-discover after a DHCP shuffle; prints + caches the IP
    if ip=$(pixel_find); then echo "pixel canvas found at $ip (cached)"; exit 0
    else echo "pixel: no canvas found on the local /24" >&2; exit 1; fi
    ;;
  clear)
    pixel_ping || exit 0
    px "clear"
    exit 0
    ;;
  list)
    [ -d "$SCENES_DIR" ] && find "$SCENES_DIR" -maxdepth 1 -type f -perm -u+x ! -name '.*' -exec basename {} \; | sort
    exit 0
    ;;
  raw)
    shift
    pixel_ping || exit 0
    px "$*"
    exit 0
    ;;
  say)
    # pixel say "any text" — ad-hoc message push.
    # Persists to /tmp/pixel-last-say.txt so the scene can also be re-fired.
    shift
    MSG="$*"
    [ -z "$MSG" ] && { echo "pixel say: need a message" >&2; exit 1; }
    pixel_ping || exit 0
    printf '%s' "$MSG" > /tmp/pixel-last-say.txt 2>/dev/null

    # URL-encode helper
    enc() { printf '%s' "$1" | sed 's/%/%25/g; s/&/%26/g; s/?/%3F/g; s/+/%2B/g; s/ /%20/g; s/=/%3D/g; s/#/%23/g; s/'\''/%27/g; s/:/%3A/g; s/,/%2C/g; s/"/%22/g'; }

    # Word-wrap to ~26 chars/line at size 2
    wrap_text() {
      local s="$1" max="$2"
      while [ -n "$s" ]; do
        if [ ${#s} -le "$max" ]; then echo "$s"; break; fi
        local chunk="${s:0:$max}" cut_at
        cut_at=$(echo "$chunk" | awk '{for(i=length;i>0;i--) if(substr($0,i,1)==" "){print i-1; exit}}')
        [ -z "$cut_at" ] || [ "$cut_at" -eq 0 ] && cut_at=$max
        echo "${s:0:$cut_at}"
        s="${s:$cut_at}"; s="${s# }"
      done
    }

    px "clear"
    # Label
    px "text?msg=msg&x=10&y=15&color=mauve&size=1"
    # Right-side accent — three dots
    px "circle?x=290&y=15&radius=3&color=hotpink"
    px "circle?x=278&y=15&radius=3&color=teal"
    px "circle?x=266&y=15&radius=3&color=mauve"

    # Body — up to 7 lines at size 2
    LINE_Y=55
    COUNT=0
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      px "text?msg=$(enc "$line")&x=15&y=${LINE_Y}&color=pink&size=2"
      LINE_Y=$((LINE_Y + 24))
      COUNT=$((COUNT + 1))
      [ "$COUNT" -ge 7 ] && break
    done < <(wrap_text "$MSG" 26)

    # Bottom hairline
    px "rect?x=10&y=225&w=300&h=1&color=dustrose"
    exit 0
    ;;
  random|"")
    pixel_ping || exit 0
    [ -d "$SCENES_DIR" ] || exit 0
    # Context-weighted pick: pixel-pick.py scores scenes by the moment (time of
    # day, an agent needing you, emails sent today, music playing, .favorites)
    # and never repeats the last one. Falls back to a flat shuffle if it fails.
    name=$(python3 "$HOME/.dotfiles/lib/pixel-pick.py" "$SCENES_DIR" 2>/dev/null)
    if [ -n "$name" ] && [ -x "$SCENES_DIR/$name" ]; then
      exec "$SCENES_DIR/$name"
    fi
    scene=$( {
      find "$SCENES_DIR" -maxdepth 1 -type f -perm -u+x ! -name '.*'
      [ -f "$SCENES_DIR/.favorites" ] && grep -Ev '^#|^[[:space:]]*$' "$SCENES_DIR/.favorites" \
        | while IFS= read -r f; do [ -f "$SCENES_DIR/$f" ] && [ -x "$SCENES_DIR/$f" ] && echo "$SCENES_DIR/$f"; done
    } | shuf -n 1 )
    [ -n "$scene" ] && exec "$scene"
    ;;
  *)
    # named scene
    pixel_ping || exit 0
    if [ -x "$SCENES_DIR/$cmd" ]; then
      exec "$SCENES_DIR/$cmd"
    else
      echo "pixel: unknown scene '$cmd'" >&2
      echo "available scenes:" >&2
      "$0" list >&2
      exit 1
    fi
    ;;
esac
