#!/usr/bin/env bash
# pixel-email-refresh — count today's sent mail (all Mail.app accounts, local,
# no network/OAuth) and update the email pixel scene's cache. Meant to run
# hourly from launchd (com.ejfox.pixel-email). Silent no-op on any failure so
# it never spams or wedges.
#
# TCC note: controlling Mail via AppleScript needs Automation permission for
# whatever runs this. From launchd that's granted to the launchd context on
# first run (may need one manual approval). Logs to /tmp/pixel-email.log.
set -u
LOG=/tmp/pixel-email.log

count=$(osascript <<'EOF' 2>>"$LOG"
set midnight to (current date)
set hours of midnight to 0
set minutes of midnight to 0
set seconds of midnight to 0
tell application "Mail"
	return count (messages of sent mailbox whose date sent ≥ midnight)
end tell
EOF
)

# Only accept a clean integer; anything else = leave the cache as-is.
case "$count" in
  ''|*[!0-9]*)
    echo "$(date '+%F %T') refresh failed (got: '${count:-empty}')" >> "$LOG"
    exit 0 ;;
esac

"$HOME/.dotfiles/bin/pixel-email-count" "$count" --quiet >/dev/null 2>&1
echo "$(date '+%F %T') email count = $count" >> "$LOG"
exit 0
