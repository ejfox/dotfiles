#!/usr/bin/env bash
# desk-event — one entry point for "something interesting happened":
# pulses computah's RGBs (rgb-flash) AND paints a caption strip on the
# pixel canvas saying what it was. Lights are the ping, glass is the caption.
#
# Usage:
#   desk-event bell "main:3 nvim"      # tmux bell, with window context
#   desk-event activity "metro:1"      # tmux activity
#   desk-event claude                  # Claude Code Stop hook (reads cwd from stdin JSON)
#   desk-event needs                   # Claude Code Notification hook (needs input/permission)
#   desk-event error "something"       # red-coded event
#   desk-event <kind> [detail...]      # anything else
#
# Light grammar (traffic-light): color = category — yellow=needs/help, green=done,
# red=error, white=fyi; pulse count = urgency. "needs" is a severity ladder whose
# scope widens with urgency (desk → office → house). Grammar lives in
# lib/desk-flash-patterns.json, read via lib/flash-lib.sh.
# Silent no-op per-device when unreachable. Caption debounced 5s.
# Washaway after ~75s: claude/needs events repaint the fleet scene
# (context follows the event), everything else repaints a random scene.

set -u
. "$HOME/.dotfiles/lib/flash-lib.sh"

KIND="${1:-event}"; shift 2>/dev/null || true
DETAIL="${*:-}"

# Claude Code hooks pipe JSON with the session cwd — turn it into a repo name
case "$KIND" in claude|needs)
  if [ -z "$DETAIL" ] && [ ! -t 0 ]; then
    DETAIL=$(jq -r '.cwd // empty' 2>/dev/null | { read -r d || true; [ -n "${d:-}" ] && basename "$d"; } ) || DETAIL=""
  fi ;;
esac

# Event color (caption accent) + light grammar event. The lights speak a
# decodable code — color = category, pulse count = urgency:
#   fyi 1 soft blip · done 1 slow swell · needs 2 pulses · error 1 deep red swell
# "needs" is a severity ladder — scope widens with urgency (desk → office → house):
#   needs         desk lamp + underlight   (default: Claude waiting on you)
#   needs-office  whole office zone        (really important)
#   needs-house   whole house              (drop everything; Pamaras Room floor-excluded)
case "$KIND" in
  needs)        LABEL="NEEDS YOU";  EVENT="needs" ;;
  needs-office) LABEL="NEEDS YOU!"; EVENT="needs-office" ;;
  needs-house)  LABEL="COME HERE";  EVENT="needs-house" ;;
  done)         LABEL="DONE";       EVENT="done" ;;
  error)        LABEL="ERROR";      EVENT="error" ;;
  claude)       LABEL="CLAUDE";     EVENT="done" ;;
  *)            EVENT="fyi"
                LABEL=$(printf '%s' "$KIND" | tr '[:lower:]' '[:upper:]') ;;
esac
# Caption accent = the same grammar color the lights use, resolved to raw r/g/b
# (the pixel firmware only knows a fixed name list — no "yellow" — but always
# honours explicit r&g&b; see firmware parseColor). One accessor, one source.
CRGB=$(grammar_rgb_query "$EVENT")

# Only attention-getting events light the room / flash the tmux title — a flash
# on every completion or background-window blip is just noise (and startles
# anyone else in the room). Everything else still updates the glass caption
# silently below. Add words here to opt more events back in, e.g. "needs error".
FLASH_EVENTS="needs needs-office needs-house"
SHOULD_FLASH=0
case " $FLASH_EVENTS " in *" $EVENT "*) SHOULD_FLASH=1 ;; esac
# DESK_EVENT_FORCE=1 (set by the manual `flash` command) always lights, so a
# hand-fired flash isn't swallowed by the automatic-event noise gate.
[ "${DESK_EVENT_FORCE:-0}" = 1 ] && SHOULD_FLASH=1

if [ "$SHOULD_FLASH" = 1 ]; then
  # 1) Lights — rgb-flash has its own debounce (needs/error punch through).
  #    Pass DETAIL so the message rides through to the toast/banner too.
  "$HOME/.dotfiles/bin/rgb-flash" "$EVENT" "$DETAIL" >/dev/null 2>&1 &

  # 1b) tmux: brief cyan flash on the window that fired, timed to match the light
  #     (quick on, then snap back to normal — not tmux's own bell glow, which
  #     lingers cyan until you visit the window). Same teal the bell glow used.
  #     ~360ms ≈ rgb-flash's desk fade-in + hold before it snaps out.
  tmux_flash() {
    local win="$1"
    [ -n "$win" ] || return 0
    command -v tmux >/dev/null 2>&1 && tmux has-session >/dev/null 2>&1 || return 0
    tmux setw -t "$win" window-status-style "fg=#7bf0f9,bold" 2>/dev/null || return 0
    tmux refresh-client -S 2>/dev/null || true
    ( sleep 0.36
      tmux setw -u -t "$win" window-status-style 2>/dev/null   # unset → back to inherited default
      tmux refresh-client -S 2>/dev/null
    ) & disown 2>/dev/null || true
  }
  # Target window: bell/activity carry "sess:idx name" in DETAIL; Claude hooks run
  # inside the agent's pane, so resolve the window from $TMUX_PANE.
  TWIN=""
  case "$KIND" in
    bell|activity) TWIN="${DETAIL%% *}" ;;
    *) [ -n "${TMUX_PANE:-}" ] && TWIN=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_index}' 2>/dev/null) ;;
  esac
  tmux_flash "$TWIN"
fi

# 2) Caption — debounce 5s so activity storms don't spam draws
#    ("needs you" events skip the debounce: never swallow those)
STAMP="/tmp/desk-event.last"
now=$(date +%s)
case "$KIND" in needs|needs-office|needs-house) SKIP_DEBOUNCE=1 ;; *) SKIP_DEBOUNCE=0 ;; esac
[ "${DESK_EVENT_FORCE:-0}" = 1 ] && SKIP_DEBOUNCE=1   # manual flashes never debounced
if [ "$SKIP_DEBOUNCE" = 0 ] && [ -f "$STAMP" ]; then
  last=$(stat -f %m "$STAMP" 2>/dev/null || echo 0)
  [ $((now - last)) -lt 5 ] && exit 0
fi
touch "$STAMP"

. "$HOME/.dotfiles/lib/pixel-host.sh"
DEVICE=$(pixel_host)
BASE="http://${DEVICE}"

px() { curl -s --connect-timeout 1 --max-time 2 -o /dev/null "${BASE}/$1" 2>/dev/null || true; }

# Reachability gate (mirrors `pixel ping`)
curl -s --connect-timeout 1 --max-time 2 -o /dev/null -w "%{http_code}" \
  "${BASE}/info" 2>/dev/null | grep -q "^200$" || exit 0

enc() { printf '%s' "$1" | sed 's/%/%25/g; s/&/%26/g; s/?/%3F/g; s/+/%2B/g; s/ /%20/g; s/=/%3D/g; s/#/%23/g; s/'\''/%27/g; s/:/%3A/g; s/,/%2C/g; s/"/%22/g'; }

msg="$DETAIL"
[ ${#msg} -gt 30 ] && msg="${msg:0:29}~"
ts=$(date +%H:%M)

# Caption strip: colored hairline + black bar over the bottom of the scene.
# Accent painted via r/g/b (resolved from the palette) so grammar colors the
# firmware doesn't know by name (e.g. yellow) still render correctly.
px "rect?x=0&y=212&w=320&h=1&${CRGB}"
px "rect?x=0&y=213&w=320&h=27&r=0&g=0&b=0"
px "text?msg=$(enc "$LABEL")&x=8&y=222&size=1&${CRGB}"
x=$(( 8 + (${#LABEL} + 1) * 6 ))
[ -n "$msg" ] && px "text?msg=$(enc "$msg")&x=${x}&y=222&size=1&color=body"
px "text?msg=$(enc "$ts")&x=284&y=222&size=1&color=dustrose"

# Washaway: repaint later unless a newer caption superseded us.
# Claude events wash into the fleet scene so the glass keeps showing
# agent context; everything else goes back to ambient rotation.
case "$KIND" in
  claude|needs|needs-office|needs-house) WASH="fleet" ;;
  *)                                     WASH="random" ;;
esac
(
  sleep 75
  cur=$(stat -f %m "$STAMP" 2>/dev/null || echo 0)
  [ "$cur" -le "$now" ] && "$HOME/.dotfiles/bin/pixel" "$WASH" >/dev/null 2>&1
) &
disown 2>/dev/null || true
exit 0
