#!/usr/bin/env python3
"""Brainstorm N weird image-gen prompts vaguely inspired by recent Obsidian
notes (both vaults). Needs the PC LLM up at HOST:8085 (computah llm on).
Prints N prompts, one per line. Falls back to a local weird generator if the
LLM is unreachable so the wall never stalls."""
import glob, json, os, random, re, sys, urllib.request

N = int(sys.argv[1]) if len(sys.argv) > 1 else 16
HOST = sys.argv[2] if len(sys.argv) > 2 else "10.0.0.169"
HOME = os.path.expanduser("~")
VAULTS = [
    f"{HOME}/Library/Mobile Documents/iCloud~md~obsidian/Documents/ejfox",
    f"{HOME}/Library/Mobile Documents/iCloud~md~obsidian/Documents/agent-vault",
]

def _clean(txt, n):
    txt = re.sub(r"^---.*?---", "", txt, flags=re.S)              # frontmatter
    txt = re.sub(r"```.*?```", " ", txt, flags=re.S)             # code fences
    txt = re.sub(r"\!\[[^\]]*\]\([^)]*\)", " ", txt)            # images
    txt = re.sub(r"[#*`>\[\]|]", " ", txt)                       # md syntax
    return " ".join(txt.split())[:n]

def recent_notes(limit=10):
    files = []
    for v in VAULTS:
        files += glob.glob(f"{v}/**/*.md", recursive=True)
    files = [f for f in files if os.path.isfile(f)]
    files.sort(key=lambda f: os.path.getmtime(f), reverse=True)
    out = []
    for f in files[:limit]:
        try: t = _clean(open(f, encoding="utf-8", errors="ignore").read(), 300)
        except Exception: continue
        if t: out.append(f"- {os.path.splitext(os.path.basename(f))[0]}: {t}")
    return "\n".join(out)

def project_readmes(limit=8):
    """What EJ is actually building — the READMEs, not just slugs — for the LLM
    to interpret into imagery."""
    readmes = []
    for base in (f"{HOME}/code", f"{HOME}/dev", f"{HOME}/projects"):
        readmes += glob.glob(f"{base}/*/README*.md") + glob.glob(f"{base}/*/readme*.md")
    readmes = [r for r in readmes if os.path.isfile(r)]
    readmes.sort(key=lambda r: os.path.getmtime(r), reverse=True)
    out = []
    for r in readmes[:limit]:
        try: t = _clean(open(r, encoding="utf-8", errors="ignore").read(), 350)
        except Exception: continue
        proj = os.path.basename(os.path.dirname(r))
        if t: out.append(f"- {proj}: {t}")
    return "\n".join(out)

def fallback(n):
    # subject-only (the loop appends the fixed vector/vulpes-palette style)
    subj = ["a bio-mechanical fox mid-leap", "a melting clocktower", "an eldritch jellyfish",
        "a creature built from CRT monitors", "a cathedral grown from coral",
        "a piano sprouting ferns and teeth", "a server rack blooming with fungus",
        "a fox skull with antennae", "a city folding into itself", "a translucent homunculus"]
    return [f"{random.choice(subj)}, surreal composition, uncanny" for _ in range(n)]

def ask_llm(notes, n):
    motifs = os.environ.get("MUSE_MOTIFS",
        "red foxes, glowing terminals and code, FPV drones, radios and mesh networks, "
        "data visualizations and maps, synths and music gear, e-ink gadgets, "
        "cyberpunk-cozy workshops, night cities")
    lenses = ["as an ancient mythological scene", "as a tiny handmade diorama",
        "as a sweeping epic landscape", "as a single hero object floating in void",
        "as a swarm or repeating pattern", "as a strange living creature",
        "as an architectural cutaway", "as a still life", "as a top-down map or diagram",
        "as an intimate portrait", "as a purely abstract composition",
        "as a half-remembered dream", "as nature reclaiming technology",
        "as a cosmic event", "as a cozy interior", "as street photography"]
    lens = random.choice(lenses)
    # Short on purpose — over-instructing homogenizes output; clean up in code.
    sys_p = ("Below is what I'm building (project READMEs) and thinking about (notes). "
        "INTERPRET the ideas and feelings in them into %d vivid, imaginative image "
        "prompts — metaphorical scenes that capture what these projects are ABOUT, "
        "not their names. Each wildly different, %s. One sentence each, one per line. "
        "/no_think" % (n, lens))
    user = "PROJECTS I'm building:\n" + project_readmes() + "\n\nNOTES:\n" + notes
    body = json.dumps({
        "messages": [{"role": "system", "content": sys_p},
                     {"role": "user", "content": user}],
        "max_tokens": 1600, "temperature": 1.0,
    }).encode()
    req = urllib.request.Request(f"http://{HOST}:8085/v1/chat/completions",
                                 body, {"Content-Type": "application/json"})
    r = json.load(urllib.request.urlopen(req, timeout=180))
    txt = r["choices"][0]["message"]["content"]
    txt = re.sub(r"<think>.*?</think>", "", txt, flags=re.S)
    lines = []
    for ln in txt.splitlines():
        ln = re.sub(r'^\s*[-*\d.)\]]+\s*', "", ln).strip()
        ln = re.sub(r'["`<>|]', " ", ln)
        ln = re.sub(r'\b(no|without|avoid|free of)\s+(text|words?|letters?|typography|signage|gradients?)\b', "", ln, flags=re.I)
        ln = " ".join(ln.split()).strip(" ,.;")
        if len(ln) > 15:
            lines.append(" ".join(ln.split()))
    return lines

notes = recent_notes()
prompts = []
if notes:
    try:
        prompts = ask_llm(notes, N)
    except Exception:
        prompts = []
if len(prompts) < N:
    prompts += fallback(N - len(prompts))
for p in prompts[:N]:
    print(p)
