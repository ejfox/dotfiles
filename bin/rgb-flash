#!/usr/bin/env bash
# rgb-flash — pulse the desk, then settle back to rest.
#
# Event grammar (the decodable form — color = category, pulses = urgency):
#   rgb-flash fyi          # 1 soft teal blip        (tmux bell/activity)
#   rgb-flash done         # 1 slow teal swell       (Claude finished)
#   rgb-flash needs        # 2 hotpink pulses        (Claude waiting on YOU)
#   rgb-flash error        # 3 sharp red strobes     (something broke)
#
# Legacy / manual:
#   rgb-flash              # teal pulse -> pink rest
#   rgb-flash <color|hex>  # named color or RRGGBB single pulse
#   rgb-flash rest         # no pulse, just set the pink resting state
#
# Reaches every RGB surface it can find:
#   - PC (OpenRGB @ 10.0.0.169:6742): direct set — unless pc-rgb-effect.py is
#     running, in which case the flash is signalled via /tmp/pc-rgb-flash
#     ("R G B pattern") and the engine renders the envelope (a direct set
#     would be overwritten next frame).
#   - Hue desk lights: {type:'flash'} UDP to the hue-stream daemon (:9999),
#     count = pulse count, so the desk repeats the same rhythm. Silently
#     dropped if the daemon isn't up.
#
# Silent + instant no-op per-surface when unreachable (safe for hooks).
# Debounced: overlapping calls within 2s collapse into one flash — except
# needs/error, which always fire (never swallow a "come here").

set -u

HOST="${OPENRGB_HOST:-10.0.0.169}"
PORT="${OPENRGB_PORT:-6742}"
VENV_PY="$HOME/.local/share/rgb-venv/bin/python3"
STAMP="/tmp/rgb-flash.last"

COLOR="${1:-teal}"

# `computah rgb off` mutes the PC lights entirely — no event flashes either.
# (Hue + canvas captions still carry the signal; delete the flag or run any
# `computah rgb <effect>` to restore.)
PC_OFF_FLAG="$HOME/.config/pc-rgb-off"

# Debounce (skip if a flash ran <2s ago). 'rest' always allowed; needs/error
# always punch through — they are the events worth interrupting for.
case "$COLOR" in
  rest|needs|error) ;;
  *)
    if [ -f "$STAMP" ]; then
      now=$(date +%s); last=$(stat -f %m "$STAMP" 2>/dev/null || echo 0)
      [ $((now - last)) -lt 2 ] && exit 0
    fi ;;
esac
touch "$STAMP"

exec "$VENV_PY" - "$HOST" "$PORT" "$COLOR" <<'EOF' >/dev/null 2>&1
import json, os, socket, subprocess, sys, time

host, port, arg = sys.argv[1], int(sys.argv[2]), sys.argv[3]

NAMED = {
    "pink":    (0xe6, 0x00, 0x67),  # vulpes resting state
    "teal":    (0x6e, 0xed, 0xf7),
    "hotpink": (0xff, 0x1a, 0xca),
    "red":     (0xff, 0x10, 0x43),
    "white":   (0xf5, 0xf5, 0xf5),
    "off":     (0x00, 0x00, 0x00),
}

# Event grammar: color = category, pulse count = urgency.
# name: (color, pattern, pulse timings [(secs, lit)], peak 0-1)
EVENTS = {
    "fyi":   ("teal",    "fyi",   [(0.35, True)], 0.55),
    "done":  ("teal",    "done",  [(0.90, True)], 1.0),
    "needs": ("hotpink", "needs", [(0.22, True), (0.14, False), (0.22, True)], 1.0),
    "error": ("red",     "error", [(0.12, True), (0.10, False), (0.12, True),
                                   (0.10, False), (0.12, True)], 1.0),
}

def parse(c):
    if c in NAMED:
        return NAMED[c]
    c = c.lstrip("#")
    if len(c) == 6:
        try:
            return (int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16))
        except ValueError:
            pass
    return NAMED["teal"]

REST = NAMED["pink"]
if arg in EVENTS:
    cname, pattern, segs, peak = EVENTS[arg]
    rgb = NAMED[cname]
else:
    pattern, segs, peak = "flat", [(0.4, True)], 1.0
    rgb = REST if arg == "rest" else parse(arg)

pulses = sum(1 for _, lit in segs if lit)
scaled = tuple(int(v * peak) for v in rgb)

def engine_running():
    try:
        return subprocess.run(["pgrep", "-f", "pc-rgb-effect.py"],
                              capture_output=True).returncode == 0
    except Exception:
        return False

# --- Hue desk lights: same rhythm, count = pulses (fire & forget)
if arg != "rest":
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.sendto(json.dumps({
            "type": "flash",
            "color": [round(v / 255, 3) for v in scaled],
            "count": pulses,
        }).encode(), ("127.0.0.1", 9999))
    except OSError:
        pass

# --- PC: muted entirely while the off flag is set (computah rgb off)
if os.path.exists(os.path.expanduser("~/.config/pc-rgb-off")):
    sys.exit(0)

# --- PC: signal the effect engine if it's running, else drive OpenRGB direct
if engine_running():
    if arg != "rest":
        try:
            with open("/tmp/pc-rgb-flash", "w") as f:
                f.write("%d %d %d %s" % (rgb + (pattern,)))
        except OSError:
            pass
    sys.exit(0)  # engine owns the LEDs (and 'rest' is its ambient anyway)

try:
    socket.create_connection((host, port), timeout=0.5).close()
except OSError:
    sys.exit(0)

from openrgb import OpenRGBClient
from openrgb.utils import RGBColor

client = OpenRGBClient(host, port, "rgb-flash")

def paint(col):
    for d in client.devices:
        try:
            d.set_color(col)
        except Exception:
            pass

for d in client.devices:
    try:
        d.set_mode("Direct")
    except Exception:
        pass

if arg == "rest":
    paint(RGBColor(*REST))
else:
    # square-wave rendition of the pattern (no engine to ease it)
    for dur, lit in segs:
        paint(RGBColor(*scaled) if lit else RGBColor(0, 0, 0))
        time.sleep(dur)
    paint(RGBColor(*REST))

client.disconnect()
EOF
