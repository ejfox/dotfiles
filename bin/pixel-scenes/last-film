#!/usr/bin/env python3
"""last-film — latest Letterboxd film, year, star rating, loved."""
import os, re, sys

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import connect, skip
from sitestats import dig, stats

s = stats()
film = dig(s, "letterboxd", "films", 0) or {}
title = film.get("title") or skip("no letterboxd film in stats")
rating = float(film.get("rating") or 0)
total = dig(s, "letterboxd", "stats", "totalFilms") or 0

m = re.search(r"\s*\((\d{4})\)$", title)  # "Poor Things (2023)" -> year shown separately
year = m.group(1) if m else ""
title = title[: m.start()] if m else title

cv = connect()
cv.clear()
cv.text("last watched", 10, 15, color="mauve")
cv.text(f"{total} this year", y=15, color="mauve", align="right")
cv.para(title, 15, 55, size=3, color="pink", max_lines=2, line_h=40,
        style="scanline", secs=5)  # through the projector gate
if year:
    cv.text(year, 15, 140, size=2, color="teal")

if rating:  # 5 dots: orange = full star, dustrose = half, small mauve = empty
    full, half = int(rating), rating % 1 >= 0.5
    for i in range(5):
        x = 15 + i * 24
        if i < full:
            cv.circle(x, 185, 8, "orange")
        elif i == full and half:
            cv.circle(x, 185, 8, "dustrose")
        else:
            cv.circle(x, 185, 4, "mauve")
if film.get("liked"):
    cv.text("loved", 200, 180, size=2, color="red")
sys.exit(0 if cv.ok else 1)
