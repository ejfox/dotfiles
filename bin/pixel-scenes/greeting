#!/usr/bin/env python3
"""greeting — time-of-day hello, with a weekend tag."""
import os, sys, time

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import connect

now = time.localtime()
h = now.tm_hour
if h < 5:
    msg, accent = "up late", "ansiblue"
elif h < 12:
    msg, accent = "morning", "orange"
elif h < 17:
    msg, accent = "afternoon", "teal"
elif h < 21:
    msg, accent = "evening", "hotpink"
else:
    msg, accent = "night", "ansiblue"
weekend = {5: "saturday", 6: "sunday"}.get(now.tm_wday)

cv = connect()
cv.clear()
cv.circle(300, 20, 6, accent)
cv.enter_text(msg, y=80, size=4, color="pink", align="center", style="sparkle", secs=7)
cv.enter_text("ej.", y=140, size=3, color=accent, align="center", style="rain", secs=4)
if weekend:
    cv.type(weekend, y=200, color="mauve", align="center")
sys.exit(0 if cv.ok else 1)
