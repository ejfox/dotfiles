#!/usr/bin/env python3
"""todos — Things Today, 🌞 foundation tasks first, as many as fit.
Reads the local things-bridge export (no things-cli, no Touch ID prompts)."""
import os, sys

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import H, connect, skip
from briefdata import things

today = things().get("today") or skip("things today empty (or no bridge export)")
sun = lambda t: "🌞" in t.get("title", "") + t.get("project", "") + t.get("area", "")
today = sorted(today, key=lambda t: not sun(t))[:5]

cv = connect()
cv.clear()
y = 15
for t in today:
    if y > H - 16:
        break
    y = cv.para(t.get("title", ""), 10, y, size=2, color="pink", max_lines=2, line_h=22,
                typed=True) + 8
    cv.beat(0.15)
sys.exit(0 if cv.ok else 1)
