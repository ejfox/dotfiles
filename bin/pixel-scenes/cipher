#!/usr/bin/env python3
"""cipher — one line of today's CIPHER oracle (cipher-daily writes
~/.cache/cipher/daily.txt each morning). Yesterday's oracle never shows."""
import os, random, re, sys, time

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import connect, skip

CACHE = os.environ.get("CIPHER_CACHE", os.path.expanduser("~/.cache/cipher"))
try:
    day = open(os.path.join(CACHE, "daily.date")).read().strip()
    lines = [l for l in open(os.path.join(CACHE, "daily.txt")).read().splitlines() if l.strip()]
except OSError:
    skip("no cipher-daily output (needs ANTHROPIC_API_KEY in ~/.env)")
if day != time.strftime("%Y-%m-%d") or not lines:
    skip(f"cipher oracle is from {day or '?'}")
line = re.sub(r"^\d+\.\s*", "", random.choice(lines))  # drop "1. " numbering

cv = connect()
cv.clear()
cv.circle(18, 18, 5, "hotpink")
cv.circle(18, 18, 2, "black")
cv.text("cipher", 32, 15, color="mauve")
cv.beat(0.3)
cv.para(line, 15, 55, size=2, color="pink", max_lines=7, line_h=24,
        style="print", secs=9)  # the oracle comes off the printer like a receipt
cv.circle(160, 230, 3, "dustrose")
sys.exit(0 if cv.ok else 1)
