#!/usr/bin/env python3
"""wpm — Monkeytype flex: best WPM huge, average + test count below."""
import os, sys

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import connect, skip
from sitestats import dig, stats

t = dig(stats(), "monkeyType", "typingStats") or {}
best = round(float(t.get("bestWPM") or 0))
if not best:
    skip("no monkeytype stats")

cv = connect()
cv.clear()
cv.text("best wpm", 10, 15, color="mauve")
cv.grow(10, 185, 300, 1, color="dustrose", frm="left")
# the number rains down in MICR E-13B, the magnetic-ink digits on a check
cv.enter_text(str(best), y=60, size=5, color="pink", align="center", font="micr",
              style="rain", secs=10)
cv.type(f"avg {round(float(t.get('averageWpm') or 0))}", 20, 200, size=2, color="teal")
cv.type(f"{t.get('testsCompleted') or 0} tests", 180, 200, size=2, color="teal")
sys.exit(0 if cv.ok else 1)
