#!/usr/bin/env python3
"""foundation — one 🌞 foundation task (or any Today task) as a big nudge.
Reads the local things-bridge export (no things-cli, no Touch ID prompts)."""
import os, random, sys

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import connect, skip
from briefdata import things

today = things().get("today") or skip("things today empty (or no bridge export)")
sun = [t for t in today if "🌞" in t.get("title", "") + t.get("project", "") + t.get("area", "")]
pick = random.choice(sun or today)

cv = connect()
cv.clear()
cv.text("foundation", 10, 20, color="mauve")
cv.circle(280, 30, 12, "orange")
cv.circle(280, 30, 6, "pink")
cv.para(pick.get("title", ""), 20, 90, size=3, color="pink", max_lines=3, line_h=36, max_w=280)
cv.rect(20, 220, 280, 1, color="dustrose")
sys.exit(0 if cv.ok else 1)
