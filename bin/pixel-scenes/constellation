#!/usr/bin/env python3
"""constellation — the tmux universe as a star chart. Sessions are arcs,
windows are stars sized by pane count, faint lines connect them.
Pink = active window, hotpink = a claude agent lives there."""
import os, sys

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import W, connect, sh

cv = connect()

wins = [l for l in sh(["tmux", "list-windows", "-a", "-F",
        "#{session_name}\t#{window_index}\t#{window_active}\t#{window_panes}\t#{window_name}"]
        ).splitlines() if l.strip()]
claude_wins = set()
for l in sh(["tmux", "list-panes", "-a", "-F",
             "#{session_name}:#{window_index}\t#{pane_current_command}"]).splitlines():
    loc, cmd = (l.split("\t") + [""])[:2]
    if "claude" in cmd:
        claude_wins.add(loc)
if not wins:
    sys.exit(0)

sessions = {}
for l in wins:
    p = l.split("\t")
    if len(p) >= 5:
        sessions.setdefault(p[0], []).append((int(p[1]), p[2] == "1", int(p[3]), p[4]))

cv.clear()
cv.text("tmux", 10, 15, color="mauve")

names = sorted(sessions)[:6]
row_h = 196 // max(1, len(names))
STAR_X0, MAX_R = 84, 8
y = 34
for name in names:
    ws = sorted(sessions[name])
    cv.text(name, 10, y, color="teal", max_w=STAR_X0 - 16)
    sy = y + 16
    field = W - STAR_X0 - MAX_R - 4
    step = min(28, max(14, field // max(1, len(ws) - 1))) if len(ws) > 1 else 0
    shown = ws if step == 0 or (len(ws) - 1) * step <= field else ws[: field // max(step, 1) + 1]
    prev = None
    for i, (idx, active, panes, wname) in enumerate(shown):
        x = STAR_X0 + i * step
        rad = min(3 + panes, MAX_R)
        color = ("hotpink" if f"{name}:{idx}" in claude_wins
                 else "pink" if active else "teal")
        if prev:
            cv.line(prev[0] + prev[1], sy, x - rad, sy, "dustrose")
        cv.circle(x, sy, rad, color)
        if active:
            cv.text(wname, x=x, y=sy + 12, color="body", align="center",
                    max_w=min(2 * step if step else 80, 84))
        prev = (x, rad)
    if len(shown) < len(ws):
        cv.text(f"+{len(ws) - len(shown)}", y=sy - 4, color="dustrose", align="right")
    y += row_h

foot = f"{len(wins)} windows"
if claude_wins:
    foot += f"  {len(claude_wins)} claude"
cv.text(foot, 10, 225, color="dustrose")

sys.exit(0 if cv.ok else 1)
