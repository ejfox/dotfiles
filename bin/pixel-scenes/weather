#!/usr/bin/env python3
"""weather — temperature + condition from wttr.in, accent colored by sky."""
import os, re, sys

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import connect, fetch, skip

raw = fetch("https://wttr.in/?format=%t+%C", timeout=4) or skip("wttr.in unreachable")  # "+69°F Sunny"
m = re.match(r"\s*([+-]?\d+)\s*°?[FC]?\s+(.+)", raw)
if not m:
    skip(f"wttr.in said {raw[:40]!r}")
temp, cond = m.group(1).lstrip("+"), m.group(2).strip().lower()

ACCENTS = [("storm|thunder", "hotpink"), ("fog|mist", "ansicyan"),
           ("cloud|overcast", "mauve"), ("snow|ice", "cyan"),
           ("rain|drizz|shower", "ansiblue"), ("sun|clear", "orange")]
color = next((c for pat, c in ACCENTS if re.search(pat, cond)), "teal")

cv = connect()
cv.clear()
cv.circle(40, 120, 14, color)
cv.enter_text(f"{temp}F", 80, 70, size=5, color="pink", style="dither", secs=8)
cv.type(re.sub(r"[,;]", "", cond), 80, 160, size=2, color=color, per_word=0.25)
sys.exit(0 if cv.ok else 1)
