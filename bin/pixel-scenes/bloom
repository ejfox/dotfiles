#!/usr/bin/env python3
"""bloom — phyllotaxis day-clock. One seed per 2 minutes elapsed today,
golden-angle spiral: teal dawn shades to pink dusk, white tip = now."""
import math, os, sys, time

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import VULPES, connect, mix

cv = connect()
TEAL, PINK, WHITE = VULPES["teal"], VULPES["pink"], VULPES["white"]
GOLDEN = math.radians(137.50776405)
CX, CY, C = 160, 122, 4.05

lt = time.localtime()
minutes = lt.tm_hour * 60 + lt.tm_min
n_seeds = max(1, minutes // 2)

cv.clear()
dots, chunks = [], []
for n in range(n_seeds):
    r = C * math.sqrt(n)
    a = n * GOLDEN
    x, y = int(CX + r * math.cos(a)), int(CY + r * math.sin(a))
    if not (0 <= x < 318 and 12 <= y < 236):
        continue
    col = mix(TEAL, PINK, (n / 720.0) ** 0.8)
    tip = n_seeds - n
    if tip <= 6:
        col = mix(col, WHITE, (7 - tip) / 7.0)
    s = 3 if tip <= 40 else 2
    dots.append({"x": x - s // 2, "y": y - s // 2, "s": s,
                 "r": col[0], "g": col[1], "b": col[2]})
    if len(dots) >= 80:
        chunks.append(dots); dots = []
if dots:
    chunks.append(dots)
for c in chunks:
    cv.batch(c)

cv.text("today", 10, 15, color="mauve")
cv.text(f"{lt.tm_hour:02d}:{lt.tm_min:02d}  {int(minutes / 1440 * 100)}%",
        10, 222, color="dustrose")

sys.exit(0 if cv.ok else 1)
