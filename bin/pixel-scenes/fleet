#!/usr/bin/env python3
"""fleet — claude agents: needs-you / working / idle counts (robots -t)
plus which tmux windows they live in."""
import os, re, sys, time

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import connect, sh

counts = sh([os.path.expanduser("~/.dotfiles/bin/robots"), "-t"]).strip()
if not counts:
    sys.exit(0)
cv = connect()

def grab(sym):
    m = re.search(sym + r"(\d+)", counts)
    return int(m.group(1)) if m else 0

needs, working, idle = grab("◇"), grab("◆"), grab("●")

cv.clear()
cv.text("agent fleet", 10, 15, color="mauve")
for cx, val, label, color in [
    (58, needs, "needs you", "hotpink" if needs else "dustrose"),
    (160, working, "working", "pink"),
    (262, idle, "idle", "teal"),
]:
    cv.text(str(val), x=cx, y=50, size=5, color=color, align="center")
    cv.text(label, x=cx, y=95, color=color if val and label == "needs you" else "mauve",
            align="center")
cv.rect(10, 115, 300, 1, color="dustrose")

y, rows = 130, 0
for l in sh(["tmux", "list-panes", "-a", "-F",
             "#{session_name}:#{window_index} #{pane_current_command} #{pane_current_path}"]
            ).splitlines():
    p = l.split()
    if len(p) < 3 or "claude" not in p[1]:
        continue
    cv.text(f"{p[0]} {os.path.basename(p[2])}", 15, y, color="body")
    y += 14
    rows += 1
    if rows >= 6:
        break

cv.text(time.strftime("%H:%M"), y=225, color="dustrose", align="right")

sys.exit(0 if cv.ok else 1)
