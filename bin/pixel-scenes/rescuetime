#!/usr/bin/env python3
"""rescuetime — top 5 apps as bars. Today's, straight from the RescueTime API
when RESCUETIME_API_KEY is in ~/.env (cached 10 min); otherwise this week's
from ejfox.com/api/stats (rescueTime.week.activities)."""
import json, os, sys, time

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import connect, fetch, skip
from sitestats import dig, stats

CACHE, MAX_AGE = "/tmp/rescuetime-today.json", 600


def api_key():
    try:
        for line in open(os.path.expanduser("~/.env")):
            if line.startswith("RESCUETIME_API_KEY="):
                return line.split("=", 1)[1].strip().strip("'\"")
    except OSError:
        pass
    return ""


def today_rows():
    """[(app, seconds)] for today from the RescueTime API, or []."""
    key = api_key()
    if not key:
        return []
    try:
        if time.time() - os.path.getmtime(CACHE) > MAX_AGE:
            raise OSError
    except OSError:
        day = time.strftime("%Y-%m-%d")
        url = ("https://www.rescuetime.com/anapi/data?perspective=interval&restrict_kind=overview"
               f"&restrict_begin={day}&restrict_end={day}&format=json&key={key}")
        try:
            body = fetch(url)
            json.loads(body)["rows"]
            with open(CACHE, "w") as f:
                f.write(body)
        except Exception:
            pass
    try:  # rows: [rank, seconds, people, activity, productivity]
        return [(r[3], r[1]) for r in json.load(open(CACHE))["rows"]]
    except Exception:
        return []


rows, label = today_rows(), "apps today"
if not rows:
    acts = dig(stats(), "rescueTime", "week", "activities") or []
    rows = [(a["name"], dig(a, "time", "seconds") or 0) for a in acts]
    label = "apps this week"
rows = sorted(rows, key=lambda r: -r[1])[:5]
if not rows or not rows[0][1]:
    skip("no rescuetime data")


def dur(sec):
    return f"{sec / 3600:.1f}h" if sec >= 3600 else f"{sec // 60}m" if sec >= 60 else f"{sec}s"


cv = connect()
cv.clear()
cv.text(label, 10, 15, color="mauve")
cv.rect(10, 30, 300, 1, color="dustrose")
top = rows[0][1]
for i, (name, sec) in enumerate(rows):
    y = 45 + i * 28
    color = "pink" if i == 0 else "teal" if i < 3 else "mauve"
    cv.text(name, 10, y, color=color, max_w=240)
    cv.text(dur(sec), 310, y, color=color, align="right")
    cv.grow(10, y + 12, max(2, sec * 180 // top), 4, color=color, frm="left")
cv.text("rescuetime", 10, 222, color="mauve")
sys.exit(0 if cv.ok else 1)
