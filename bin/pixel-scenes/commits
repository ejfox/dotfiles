#!/usr/bin/env python3
"""commits — today's git work as a phyllotaxis bloom. Seed per commit
across ~/code in chronological spiral order, stable hue per repo,
white tip = latest. Empty morning = bare center; shipping day = flower."""
import math, os, sys, time

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import VULPES, connect, hue_for, mix, sh

cv = connect()
CODE = os.path.expanduser("~/code")
WHITE = VULPES["white"]
GOLDEN = math.radians(137.50776405)
CX, CY = 160, 122

midnight = time.strftime("%Y-%m-%d 00:00")
commits = []  # (epoch, repo)
for d in sorted(os.listdir(CODE) if os.path.isdir(CODE) else []):
    if not os.path.isdir(os.path.join(CODE, d, ".git")):
        continue
    for l in sh(["git", "-C", os.path.join(CODE, d), "log", "--all",
                 f"--since={midnight}", "--format=%ct"]).split():
        commits.append((int(l), d))
commits.sort()
repos = list(dict.fromkeys(d for _, d in commits))
n = len(commits)
C = 4.2 if n < 500 else 3.4

cv.clear()
cv.text("shipped today", 10, 15, color="mauve")

dots, chunks = [], []
for i, (ts, repo) in enumerate(commits):
    r = C * math.sqrt(i)
    a = i * GOLDEN
    x, y = int(CX + r * math.cos(a)), int(CY + r * math.sin(a))
    if not (0 <= x < 317 and 12 <= y < 234):
        continue
    col = hue_for(repo)
    tip = n - i
    if tip <= 3:
        col = mix(col, WHITE, (4 - tip) / 4.0)
    s = 4 if tip <= 10 else 3
    dots.append({"x": x - s // 2, "y": y - s // 2, "s": s,
                 "r": col[0], "g": col[1], "b": col[2]})
    if len(dots) >= 80:
        chunks.append(dots); dots = []
if dots:
    chunks.append(dots)
for c in chunks:
    cv.batch(c)

if n == 0:
    cv.text("nothing shipped yet", y=118, color="dustrose", align="center")
else:
    counts = {}
    for _, d in commits:
        counts[d] = counts.get(d, 0) + 1
    ly = 195
    for d in sorted(counts, key=counts.get, reverse=True)[:3]:
        cv.rect(10, ly, 6, 6, rgb=hue_for(d))
        cv.text(f"{d} {counts[d]}", 22, ly, color="body", max_w=130)
        ly += 12
cv.text(f"{n} commits {len(repos)} repos", y=225, color="dustrose", align="right")
