#!/usr/bin/env python3
"""now-playing — latest last.fm track + artist, lifetime scrobbles."""
import os, sys

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import ascii, connect, skip, text_w
from sitestats import dig, stats

s = stats()
track = ascii(dig(s, "lastfm", "recentTracks", "tracks", 0, "name") or "")
if not track:
    skip("no last.fm track in stats")
artist = dig(s, "lastfm", "recentTracks", "tracks", 0, "artist", "name") or ""
plays = int(dig(s, "lastfm", "userInfo", "playcount") or 0)

cv = connect()
cv.clear()
cv.text("now playing", 10, 15, color="mauve")
# size 3 when the title fits, otherwise step down rather than run off the glass
size = 3 if text_w(track, 3) <= 300 else 2
cv.enter_text(track, 15, 70, size=size, color="pink", style="glitch", secs=5)
cv.grow(10, 95, 160, 1, color="dustrose", frm="left")
cv.decode(artist, 15, 120, size=2, color="teal", secs=1.2)
cv.text(f"{plays:,} scrobbles", 10, 210, color="mauve")
sys.exit(0 if cv.ok else 1)
