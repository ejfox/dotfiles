#!/usr/bin/env python3
"""reading — a random book off the Goodreads currently-reading shelf."""
import os, random, sys

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import connect, skip
from sitestats import dig, stats

s = stats()
shelf = dig(s, "goodreads", "currentlyReading") or skip("currently-reading shelf empty")
book = random.choice(shelf)
if not book.get("title"):
    skip("book without a title")

cv = connect()
cv.clear()
cv.text("reading", 10, 15, color="mauve")
cv.rect(290, 20, 4, 80, color="hotpink")  # bookmark
cv.para(book["title"], 15, 55, size=2, color="pink", max_lines=4, max_w=270)
if book.get("author"):
    cv.text(f"by {book['author']}", 15, 160, color="teal")
if book.get("numPages"):
    cv.text(f"{book['numPages']} pages", 15, 180, color="mauve")
cv.text(f"{dig(s, 'goodreads', 'stats', 'totalRead') or 0} books read", 15, 210, color="mauve")
sys.exit(0 if cv.ok else 1)
