#!/usr/bin/env python3
"""ambient-dots — vulpes squares falling out of the sky and settling where
they land. Pure ambient art, no info."""
import os, random, sys

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import VULPES, connect, dot

MAUVE = (0x73, 0x58, 0x65)
COLORS = [VULPES[c] for c in ("pink", "teal", "dustrose", "ansiblue", "ansicyan")] + [MAUVE]

cv = connect()
cv.clear()
cv.enter([dot(random.randrange(10, 310), random.randrange(10, 230),
              random.choice(COLORS), s=random.randrange(2, 8)) for _ in range(45)],
         style="rain", secs=12)
sys.exit(0 if cv.ok else 1)
