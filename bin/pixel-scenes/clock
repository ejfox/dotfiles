#!/usr/bin/env python3
"""clock — big time, small date, teal corner brackets. The time de-explodes
into place in OCR-A, the 1968 machine-reading face."""
import os, sys, time

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import connect

now = time.localtime()
cv = connect()
cv.clear()
cv.grow(10, 10, 20, 2, color="teal", frm="left")
cv.grow(10, 10, 2, 20, color="teal")
cv.enter_text(time.strftime("%H:%M", now), y=70, size=4, color="pink", align="center",
              font="ocra", style="implode", secs=10)
cv.decode(time.strftime("%a %b ", now) + str(now.tm_mday), y=160, size=2, color="mauve",
          align="center", secs=1.5)
cv.grow(290, 228, 20, 2, color="teal", frm="left")
cv.grow(308, 210, 2, 20, color="teal")
sys.exit(0 if cv.ok else 1)
