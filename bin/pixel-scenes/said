#!/usr/bin/env python3
"""said — the last thing claude-say spoke, with voice + tmux window.
Fired by claude-say; in rotation it only shows while fresh (<10 min)."""
import os, sys, time

sys.path.insert(0, os.path.expanduser("~/.dotfiles/lib"))
from pixelkit import connect, skip

LAST, MAX_AGE = "/tmp/claude-say-last.txt", 600


def read(path):
    try:
        return open(path).read().strip()
    except OSError:
        return ""


msg = read(LAST)
if not msg:
    skip("claude-say hasn't spoken")
age = time.time() - os.path.getmtime(LAST)
if age > MAX_AGE:
    skip(f"last claude-say is {int(age // 60)}m old")
voice, win = read("/tmp/claude-say-last-voice.txt"), read("/tmp/claude-say-last-win.txt")

cv = connect()
cv.clear()
cv.text(voice or "said", 10, 15, color="hotpink" if voice else "mauve")
if win:  # big teal window number, clear of the live ticker band
    x = cv.text(win, y=14, size=3, color="teal", align="right")
    cv.text("win", x=(x or 300) - 4, y=22, color="mauve", align="right")
cv.para(msg, 15, 50, size=2, color="pink", max_lines=7, line_h=24, typed=True)
cv.rect(10, 225, 300, 1, color="dustrose")
sys.exit(0 if cv.ok else 1)
