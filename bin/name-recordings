#!/bin/bash
# name-recordings — identify screen recordings by OCR-ing sampled frames, then
# rename them to  YYYY-MM-DD-HHMM-<slug>.<ext>  (date+time = stable sort key).
#
# 100% local, zero API tokens: ffmpeg samples frames, macOS Vision reads the
# on-screen text, a heuristic (or the local Qwen on computah with --llm) turns
# that text into a slug. Built for EJ's OLED-dark setup where a blank thumbnail
# tells you nothing but the text on screen tells you everything.
#
# Usage:
#   name-recordings [DIR]              dry run over DIR (default ~/screenshots)
#   name-recordings [DIR] --apply      actually rename
#   name-recordings [DIR] --verbose    also print the OCR evidence per file
#   name-recordings [DIR] --llm        slug via computah's local Qwen (free), else heuristic
#   name-recordings file1.mov …        operate on specific files
#
# Idempotent: files already named YYYY-MM-DD-HHMM-… are skipped (use --force to redo).
set -uo pipefail

FF=/usr/local/bin/ffmpeg; [ -x "$FF" ] || FF=$(command -v ffmpeg)
FP=/usr/local/bin/ffprobe; [ -x "$FP" ] || FP=$(command -v ffprobe)
PY=$(command -v python3)
CACHE="$HOME/.cache/name-recordings"
OCRBIN="$CACHE/ocrbin"

APPLY=0; VERBOSE=0; USELLM=0; FORCE=0; LLM_HOST="${COMPUTAH_LLM:-10.0.0.169}"
paths=(); dir=""
for a in "$@"; do
  case "$a" in
    --apply) APPLY=1 ;;
    --verbose|-v) VERBOSE=1 ;;
    --llm) USELLM=1 ;;
    --force) FORCE=1 ;;
    -*) echo "unknown flag: $a" >&2; exit 2 ;;
    *) [ -d "$a" ] && dir="$a" || paths+=("$a") ;;
  esac
done

command -v swiftc >/dev/null || { echo "need swiftc (Xcode CLT) for macOS Vision OCR" >&2; exit 1; }
[ -x "$FF" ] && [ -x "$FP" ] || { echo "need ffmpeg + ffprobe (brew install ffmpeg)" >&2; exit 1; }

# --- compile the Vision OCR helper once (cached) --------------------------------
mkdir -p "$CACHE"
if [ ! -x "$OCRBIN" ] || [ "$CACHE/ocr.swift" -nt "$OCRBIN" ] 2>/dev/null; then
  cat > "$CACHE/ocr.swift" <<'SWIFT'
import Vision
import AppKit
for path in CommandLine.arguments.dropFirst() {
  guard let img = NSImage(contentsOfFile: path),
        let cg = img.cgImage(forProposedRect: nil, context: nil, hints: nil) else { continue }
  let req = VNRecognizeTextRequest { r, _ in
    for o in (r.results as? [VNRecognizedTextObservation] ?? []) {
      if let t = o.topCandidates(1).first?.string { print(t) }
    }
  }
  req.recognitionLevel = .accurate
  try? VNImageRequestHandler(cgImage: cg, options: [:]).perform([req])
}
SWIFT
  swiftc -O "$CACHE/ocr.swift" -o "$OCRBIN" 2>/dev/null || { echo "swiftc failed" >&2; exit 1; }
fi

# --- collect target files -------------------------------------------------------
if [ "${#paths[@]}" -eq 0 ]; then
  [ -z "$dir" ] && dir="$HOME/screenshots"
  shopt -s nullglob nocaseglob
  paths=( "$dir"/*.mov "$dir"/*.mp4 "$dir"/*.m4v )
  shopt -u nocaseglob
fi
[ "${#paths[@]}" -eq 0 ] && { echo "no video files found" >&2; exit 0; }

# --- slug from OCR evidence (heuristic; --llm overrides via local Qwen) ---------
heuristic_slug() {  # reads evidence from $EV, prints kebab slug
  "$PY" - <<'PYEOF'
import os, re
from collections import Counter
CHROME = set("""save saved read later reconnect cancel settings close menu file edit
view window help click button http https www com org net the and for you your are was
this that with from have will can new open share promote analytics subscribe subscribers
views ago more today untitled screen recording page reset all keyboard shortcuts connected
warning offline check connection try again live ended""".split())
text = os.environ.get("EV", "").lower()
words = re.findall(r"[a-z][a-z0-9]{2,}", text)
freq = Counter(w for w in words if w not in CHROME and not w.isdigit())
top = [w for w, _ in freq.most_common(4)]
slug = "-".join(top[:4]) if top else "graphical"
slug = re.sub(r"[^a-z0-9-]+", "-", slug).strip("-")[:50] or "graphical"
print(slug)
PYEOF
}

llm_slug() {  # reads evidence on stdin, prints slug via local Qwen; empty on failure
  local ev; ev=$(cat)
  EV="$ev" HOST="$LLM_HOST" "$PY" - <<'PYEOF' 2>/dev/null
import os, json, re, urllib.request
body=json.dumps({"messages":[
 {"role":"system","content":"Given OCR text scraped from frames of a screen recording, reply with ONLY a 2-5 word lowercase kebab-case filename slug describing what the recording is about. No punctuation except hyphens. No explanation."},
 {"role":"user","content":os.environ["EV"][:1500]}],"max_tokens":30,"temperature":0.2}).encode()
try:
    r=json.load(urllib.request.urlopen(urllib.request.Request(
      f"http://{os.environ['HOST']}:8085/v1/chat/completions",body,{"Content-Type":"application/json"}),timeout=60))
    s=r["choices"][0]["message"]["content"].strip().lower()
    s=re.sub(r"<think>.*?</think>","",s,flags=re.S)
    s=re.sub(r"[^a-z0-9-]+","-",s).strip("-")[:50]
    print(s)
except Exception:
    pass
PYEOF
}

# --- main loop ------------------------------------------------------------------
printf "%-9s  %-42s  %s\n" "SIZE" "OLD" "NEW"
renamed=0; skipped=0
for F in "${paths[@]}"; do
  [ -f "$F" ] || continue
  base=$(basename "$F"); dirn=$(dirname "$F"); ext="${base##*.}"
  if [ "$FORCE" -eq 0 ] && echo "$base" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}-'; then
    skipped=$((skipped+1)); continue
  fi
  dur=$("$FP" -v error -show_entries format=duration -of csv=p=0 "$F" 2>/dev/null | cut -d. -f1); dur=${dur:-60}
  # date+time: prefer what's in the filename (macOS "at H.MM.SS AM" or already-named),
  # fall back to file mtime.
  mt=$(stat -f "%Sm" -t "%Y-%m-%d-%H%M" "$F" 2>/dev/null)
  stamp=$(BASE="$base" MT="$mt" "$PY" - <<'PYEOF'
import os, re
b=os.environ["BASE"]; mt=os.environ["MT"]
m=re.match(r'(\d{4}-\d{2}-\d{2})-(\d{4})-', b)          # already YYYY-MM-DD-HHMM-
if m: print(f"{m.group(1)}-{m.group(2)}"); raise SystemExit
d=re.search(r'(\d{4}-\d{2}-\d{2})', b)                   # macOS "... at 10.39.02 AM"
t=re.search(r'\bat\b\s*(\d{1,2})[.\-](\d{2})(?:[.\-]\d{2})?\s*([AaPp][Mm])?', b)
if d and t:
    hh=int(t.group(1)); mm=t.group(2); ap=(t.group(3) or '').lower()
    if ap=='pm' and hh<12: hh+=12
    if ap=='am' and hh==12: hh=0
    print(f"{d.group(1)}-{hh:02d}{mm}")
else:
    print(mt)
PYEOF
)
  gb=$(stat -f%z "$F" | awk '{printf "%.2f",$1/1073741824}')
  # adaptive sampling: ~1 frame / 2 min, clamp 6..14 (text can be sparse in long clips)
  N=$(( dur / 120 )); [ "$N" -lt 6 ] && N=6; [ "$N" -gt 14 ] && N=14
  tmpd=$(mktemp -d); i=0
  while [ "$i" -lt "$N" ]; do
    pct=$(( 8 + (84 * i / (N>1?N-1:1)) )); T=$(( dur * pct / 100 ))
    "$FF" -nostdin -loglevel error -ss "$T" -i "$F" -frames:v 1 -vf "scale=1600:-1" "$tmpd/f_$i.png" -y 2>/dev/null
    i=$((i+1))
  done
  evidence=$("$OCRBIN" "$tmpd"/f_*.png 2>/dev/null \
    | sed 's/^ *//;s/ *$//' | awk 'length>=4 && length<=60 && /[A-Za-z]{3,}/' \
    | awk '!seen[tolower($0)]++' | head -20)
  rm -rf "$tmpd"

  slug=""
  if [ "$USELLM" -eq 1 ] && [ -n "$evidence" ]; then slug=$(printf '%s' "$evidence" | llm_slug); fi
  [ -z "$slug" ] && slug=$(EV="$evidence" heuristic_slug)
  new="${stamp}-${slug}.${ext}"; dst="$dirn/$new"
  # avoid clobber
  n=2; while [ -e "$dst" ] && [ "$dst" != "$F" ]; do new="${stamp}-${slug}-${n}.${ext}"; dst="$dirn/$new"; n=$((n+1)); done

  printf "%7sGB  %-42s  %s\n" "$gb" "${base:0:42}" "$new"
  [ "$VERBOSE" -eq 1 ] && printf '           evidence: %s\n' "$(echo "$evidence" | tr '\n' '|' | cut -c1-160)"
  if [ "$APPLY" -eq 1 ] && [ "$dst" != "$F" ]; then mv "$F" "$dst" && renamed=$((renamed+1)); fi
done

echo ""
if [ "$APPLY" -eq 1 ]; then echo "renamed $renamed file(s); skipped $skipped already-named."
else echo "(dry run — nothing renamed. add --apply to rename. --llm for nicer slugs via local Qwen.)"; fi
