#!/usr/bin/env python3
"""studio-theme: pick a vulpes monthly variant for the STUDIO window.

  studio-theme [--key] [month]     writes ~/.cache/studio/theme.conf, prints "<name> <cursor hex>"

The vulpes monthly line (vulpes-theme-lab/VULPES_MONTHLY_LINE.md) is reddish-november
rotated around the color wheel in 30 degree steps. Same here: every colored entry of the
november palette gets its hue rotated; greys stay grey. Random month unless one is named.
--key (greenscreen) only allows months where no color is green-dominant, so nothing in the
terminal can key out.
"""
import colorsys
import os
import random
import re
import sys

BASE = os.path.expanduser("~/.config/ghostty/themes/vulpes-reddishnovember-dark")
OUT = os.path.expanduser("~/.cache/studio/theme.conf")
MONTHS = ["november", "december", "january", "february", "march", "april",
          "may", "june", "july", "august", "september", "october"]   # +30 degrees each
FAMILY = {"november": "reddish", "december": "reddish", "january": "orangish",
          "february": "yellowish", "march": "yellowish", "april": "greenish", "may": "greenish",
          "june": "cyanish", "july": "bluish", "august": "bluish", "september": "purplish",
          "october": "magentaish"}
KEYS = ("foreground", "cursor-color", "selection-background", "selection-foreground", "palette")


def rotate(hex_color, degrees):
    r, g, b = (int(hex_color[i:i + 2], 16) / 255 for i in (1, 3, 5))
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    if s < 0.15 or l < 0.08 or l > 0.97:          # greys, black, white: leave alone
        return hex_color
    r, g, b = colorsys.hls_to_rgb((h + degrees / 360) % 1, l, s)
    return "#%02x%02x%02x" % tuple(round(c * 255) for c in (r, g, b))


def green_dominant(hex_color):
    r, g, b = (int(hex_color[i:i + 2], 16) / 255 for i in (1, 3, 5))
    return g - max(r, b) > 0.01      # greys (equal channels) are fine: alpha comes out 1


def variant(lines, month):
    deg = 30 * MONTHS.index(month)
    out = []
    for line in lines:
        m = re.match(r"^(palette = \d+=|[a-z-]+ = )(#[0-9a-fA-F]{6})\s*$", line)
        if m and line.startswith(KEYS):
            out.append(m.group(1) + rotate(m.group(2), deg))
    return out


def main():
    args = sys.argv[1:]
    key = "--key" in args
    named = [a for a in args if a != "--key"]
    lines = [l.strip() for l in open(BASE)]
    colors = lambda v: [l.rsplit(" ", 1)[-1].split("=")[-1] for l in v]
    choices = [m for m in MONTHS if not (key and any(green_dominant(c) for c in colors(variant(lines, m))))]
    if named:
        month = named[0].lower()
        if month not in MONTHS:
            sys.exit(f"months: {' '.join(MONTHS)}")
        if month not in choices:
            sys.exit(f"{month} has green in it, so it would key out; greenscreen-safe: {' '.join(choices)}")
    else:
        month = random.choice(choices)
    v = variant(lines, month)
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w") as f:
        f.write(f"# vulpes-{FAMILY[month]}-{month} (generated by studio-theme)\n" + "\n".join(v) + "\n")
    cursor = next(l.split("= ")[1] for l in v if l.startswith("cursor-color"))
    print(f"vulpes-{FAMILY[month]}-{month} {cursor}")


if __name__ == "__main__":
    main()
